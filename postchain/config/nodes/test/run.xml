<run wipe-db="true">
    <nodes>
        <config src="node-config.properties" add-signers="true" />
    </nodes>
    <chains>
        <chain name="ft3-lib" iid="0">
            <config height="0">
                <app module="main">
                    <args module="lib.ft3.core">
                        <arg key="my_blockchain_name"><string>test</string></arg>
                        <arg key="my_blockchain_website"><string>test_website</string></arg>
                        <arg key="my_blockchain_description"><string>test_description</string></arg>
                        <arg key="rate_limit_active"><int>1</int></arg>
                        <arg key="rate_limit_max_points"><int>10</int></arg> <!-- maximum amount of request credit that is possible to keep -->
                        <arg key="rate_limit_recovery_time"><int>5000</int></arg>
                        <arg key="rate_limit_points_at_account_creation"><int>1</int></arg>
                    </args>
                    <args module="testnet">
                        <arg key="admin_pub_key"><string>02B4D7E4EC6F50D3ACE02226B23C41C326CEBB627ACC17D8F68E44A23DF506BFA2</string></arg>
                    </args>
                </app>
            </config>
        </chain>
        <chain name="testnet-ft3-lib" iid="1">
            <config height="0">
                <app module="testnet">
                    <args module="lib.ft3.core">
                        <arg key="my_blockchain_name"><string>testnet ft3</string></arg>
                        <arg key="my_blockchain_website"><string>https://vault-testnet.chromia.com/</string></arg>
                        <arg key="my_blockchain_description"><string>FT3 vault DEVELOPMENT MODE - TESTNET</string></arg>
                        <arg key="rate_limit_active"><int>1</int></arg>
                        <arg key="rate_limit_max_points"><int>20</int></arg> <!-- maximum amount of request credit that is possible to keep -->
                        <arg key="rate_limit_recovery_time"><int>60000</int></arg>
                        <arg key="rate_limit_points_at_account_creation"><int>1</int></arg>
                    </args>
                    <args module="testnet">
                        <arg key="admin_pub_key"><string>03B1BE9A6AEA69E249989416C6ADA12B67816334D9F302B59599B616DC4E79CB11</string></arg>
                    </args>
                </app>
            </config>
        </chain>
    </chains>
</run>

