{
  "name": "@chromia/ft4",
  "version": "0.1.4",
  "description": "FT4 Library is a library for Rell modules (Chromia smart contract language). It can be imported and used as a token provider and manager. It allows several operations, among them: creation of different assets (type of tokens), allocation of tokens, transfer, and cross crosschain transfer. It also have some basic data structure for users (account) that can be used independently from the use of the tokens.",
  "main": "dist/client/lib/ft4/index.js",
  "types": "dist/client/lib/ft4/index.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "version:rell": "./scripts/version.sh",
    "test:js-coverage": "./scripts/jesttest.sh -- --coverage",
    "test:js": "./scripts/jesttest.sh",
    "test:rell": "./scripts/relltest.sh",
    "test:multichain": "./scripts/multichain-jesttest.sh",
    "test": "./scripts/test.sh",
    "test:pipeline": "./scripts/test.sh --no-docker",
    "stop-postchain:jest": "docker stop ft4_jest_test; docker rm ft4_jest_test",
    "stop-postchain:demo": "docker stop ft4_demo; docker rm ft4_demo",
    "stop-postchain:rell": "docker stop postchain; docker rm postchain",
    "start-postchain:demo": "./scripts/rundemo.sh",
    "deploy:latest": "./scripts/deploy.sh",
    "deploy:stable": "./scripts/deploy.sh --stable",
    "start": "node index.js",
    "build": "shx rm -rf dist && tsc --project tsconfig.dist.json && tsc-alias",
    "prepublishOnly": "npm run build",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/chromawallet/ft3-lib.git"
  },
  "lint-staged": {
    "*.ts": [
      "prettier -w",
      "eslint --fix --max-warnings 0"
    ]
  },
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://bitbucket.org/chromawallet/ft3-lib#readme",
  "dependencies": {
    "ethers": "^6.4.1",
    "postchain-client": "^1.5.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.2.5",
    "@types/node-fetch": "^2.6.1",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "husky": "^8.0.1",
    "jest": "^29.5.0",
    "lint-staged": "^13.0.1",
    "node-fetch": "^3.3.1",
    "prettier": "^3.0.0",
    "shx": "^0.3.2",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.6",
    "tslint": "^6.1.3",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "buffer": "^5.x || ^6.x"
  }
}
