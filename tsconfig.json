{
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "downlevelIteration": true,
    "lib": [
      "es2015",
      "es2019",
      "dom"
    ],
    "resolveJsonModule": true,
    "types": ["jest"],
    "paths": {
      "/*": [
        "./client/lib/*",
        "./test/*"
      ]
    }
  },
  "include": ["./client/**/*", "./test/**/*"],
  "exclude": [
    "node_modules"
  ]
}
