@mount('ft')
module;

struct auth_data {
    flags: list<text>;
    message: text;
}

struct _auth_handler {
    flags: list<text>;
    message_formatter: ((gtv) -> text)? = null;
}

@extendable 
function auth_handler(): map<name, _auth_handler>;

query get_auth_flags(op_name: name) = get_auth_handler(op_name).flags;
query get_auth_message_template(op_name: name, args: gtv) {
    val formatter = get_auth_handler(op_name).message_formatter;

    return if (formatter??) formatter(args) else generate_auth_message_template(chain_context.blockchain_rid, gtx_operation(
        name = op_name,
        args = list<gtv>.from_gtv(args)
    ));
}

function get_auth_handler(op_name: name) {
    val auth_handlers = auth_handler();
    return auth_handlers[op_name];
}

function auth(scope: text, flags: list<text>, formatter: ((gtv) -> text)? = null) {
    return [scope: _auth_handler(flags, formatter)];
} 

function args() = op_context.get_all_operations()[op_context.op_index].args.to_gtv();

struct signature {
    r: byte_array;
    s: byte_array;
    v: integer;
}

operation evm_auth(
    account_id: byte_array,
    auth_descriptor_id: byte_array,
    signatures: list<signature>
) {
    // require(disposable_key in op_context.get_signers(), "Transaction must be signed with disposable key");
}

operation ft_auth(
    account_id: byte_array,
    auth_descriptor_id: byte_array
) {}

// Creates message from operation name and arguments.
// It is used when `evm_auth` is used to authenticate the user, 
// but auth message is not specified for the operation.
function generate_auth_message_template(brid: byte_array, op: gtx_operation) {
    var message = "Please sign the message to call\noperation:\n- %s\n\n".format(op.name);

    if (op.args.size() > 0) {
        var arguments = "with arguments:\n";
        for (arg in op.args) {
            arguments = arguments + "- %s\n".format(arg).replace("\"", "");
        }
        message = message + arguments + "\n";
    }
    
    return message + "Nonce: {nonce}";
}
