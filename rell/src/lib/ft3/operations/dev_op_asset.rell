@mount('ft3')
module;

import dev_op: ^.dev_op;
import ft3: ^^.core;
import acc: ^^.account;

import xft3: ^^.crosschain;

operation dev_register_asset(name, symbol: text, decimals: integer, icon_url: text) {
    dev_op.require_admin();
    ft3.Unsafe.register_asset(name, symbol, decimals, icon_url);
}

operation dev_register_xc_asset(
    name, symbol: text,
    decimals: integer,
    issuing_brid: byte_array,
    origin_brid: byte_array,
    icon_url: text,
    total_supply: integer = 0
) {
    require(false, "Feature not implemented yet.");
    dev_op.require_admin();
    val asset = ft3.Unsafe.register_asset(name, symbol, decimals, icon_url);
    create xft3.asset_origin (asset, origin_brid);
}

operation dev_mint(account_id: byte_array, asset_id: byte_array, amount: big_integer) {
    dev_op.require_admin();
    ft3.Unsafe.mint(
        acc.account @ { .id==account_id },
        ft3.asset @ { .id == asset_id },
        amount
    );
}