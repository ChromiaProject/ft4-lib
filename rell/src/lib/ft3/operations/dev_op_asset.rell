@mount('ft3')
module;

import dev_op: ^.dev_op;
import ft3: ^^.core;

import xft3: ^^.crosschain;

operation dev_register_asset(name, issuing_brid: byte_array) {
    dev_op.require_admin();
    ft3.register_asset(name, issuing_brid);
}

operation dev_register_xc_asset(name, issuing_brid: byte_array, origin_brid: byte_array) {
    dev_op.require_admin();
    val asset = ft3.register_asset(name, issuing_brid);
    create xft3.asset_origin (asset, origin_brid);
}
