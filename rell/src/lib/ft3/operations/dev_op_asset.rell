@mount('ft3')
module;

import dev_op: ^^.core.dev_op;
import ft3: ^^.core;

import xft3: ^^.crosschain;

operation dev_register_asset(name, symbol: text, decimals: integer, issuing_brid: byte_array, icon_url: text) {
    dev_op.require_dev();
    ft3.register_asset(name, symbol, decimals, issuing_brid, icon_url);
}

operation dev_register_xc_asset(name, symbol: text, decimals: integer, issuing_brid: byte_array, origin_brid: byte_array, icon_url: text) {
    dev_op.require_dev();
    val asset = ft3.register_asset(name, symbol, decimals, issuing_brid, icon_url);
    create xft3.asset_origin (asset, origin_brid);
}
