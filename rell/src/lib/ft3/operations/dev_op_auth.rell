@mount('ft3')
module;

import dev_op: ^^.core.dev_op;
import acc: ^^.account; 

/*
 * We can store the error message in this singleton, and later check it in our tests.
 */
object dev_error {
    mutable msg: text = "valid";
}

/*
 * This operation does NOTHING but authenticates the transaction. 
 * Only used for testing of authentication mechanics.
 */
operation dev_auth(account_id: byte_array, auth_descriptor_id: byte_array, required_flags: list<text>) {
    dev_op.require_dev();

    val account = acc.account @ { .id == account_id };

    val acc_auth_desc = acc.account_auth_descriptor @ {
          .id == auth_descriptor_id,
          .account == account
    };
    val participants = acc.get_participants(acc_auth_desc.auth_type, acc_auth_desc.args);//acc.auth_descriptor_participant @* { .account_auth_descriptor == acc_auth_desc } ( .id );

    val result = acc.check_auth_args(
       		acc_auth_desc.auth_type,
       		acc_auth_desc.args,
            participants,
       		required_flags
	);

    if (result.valid) {
        dev_error.msg = "valid";
    } else {
        dev_error.msg = result.error!!;
    }
}

operation authenticated_operation(details: acc.auth_details, desc: acc.account_auth_descriptor) {
  dev_op.require_dev();
  acc.authenticate(details, desc);
}

operation add_auth_description_for_account(account: acc.account, desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc._add_auth_descriptor(account, desc);
}

operation perform_large_transfer(
  details: acc.auth_details, 
  desc: acc.account_auth_descriptor, 
  from: acc.account,
  to: acc.account,
  amount: integer
) {
  dev_op.require_dev();
  val args = list<text>();
  args.add(amount.to_text());
  args.add("0x" + to.id.to_hex());

  details.message = acc.format(details.message_template!!, args);
  acc.authenticate(details, desc);
}

operation custom_auth_validator() {
  dev_op.require_dev();
}

function validator_callback(args: list<gtv>, auth_details: acc.auth_details) {
  return true;
}

operation large_transfer_with_custom_auth(details: acc.auth_details, desc: acc.account_auth_descriptor) {
  dev_op.require_dev();

  val validator = acc.auth_validator(
    validator_name="custom_auth_validator",
    validator=validator_callback(*)
  );

  require(acc.authenticate(details, desc, validator), "Unauthorized");
}
