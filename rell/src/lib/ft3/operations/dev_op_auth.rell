@mount('ft3')
module;

import dev_op: ^^.core.dev_op;
import acc: ^^.account; 

/*
 * We can store the error message in this singleton, and later check it in our tests.
 */
object dev_error {
    mutable msg: text = "valid";
}

/*
 * This operation does NOTHING but authenticates the transaction. 
 * Only used for testing of authentication mechanics.
 */
operation dev_auth(account_id: byte_array, auth_descriptor_id: byte_array, required_flags: list<text>) {
    dev_op.require_dev();

    val account = acc.account @ { .id == account_id };

    val acc_auth_desc = acc.account_auth_descriptor @ {
          .id == auth_descriptor_id,
          .account == account
    };
    val participants = acc.get_participants(acc_auth_desc.auth_type, acc_auth_desc.args);//acc.auth_descriptor_participant @* { .account_auth_descriptor == acc_auth_desc } ( .id );

    val result = acc.check_auth_args(
       		acc_auth_desc.auth_type,
       		acc_auth_desc.args,
            participants,
       		required_flags
	);

    if (result.valid) {
        dev_error.msg = "valid";
    } else {
        dev_error.msg = result.error!!;
    }
}
operation dev_create_eth_account(auth_desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc.create_account_with_auth(auth_desc);
}

operation dev_create_ft4_account(auth_desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc.create_account_with_auth(auth_desc);
}

operation dev_authenticated_operation(message: text) {
  dev_op.require_dev();
  require(acc.authenticate(set<text>(["A"]), [message]));
}

operation add_auth_descriptor_for_account(account: acc.account, desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc.add_auth_descriptor_to_account(account, desc);
}

operation create_eth_account(auth_desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc.create_account_with_auth(auth_desc);
}

operation create_ft4_account(auth_desc: acc.auth_descriptor) {
  dev_op.require_dev();
  acc.create_account_with_auth(auth_desc);
}

operation dev_perform_large_transfer(
  message_template: text,
  from: acc.account,
  to: text,
  amount: integer
) {
  dev_op.require_dev();
  val previous_op = op_context.get_all_operations()[op_context.op_index - 1];
  val ctrs = if (previous_op.args.size() > 1) list<integer>.from_gtv(previous_op.args[2]) else list<integer>();

  var messages = list<text>();
  for (ctr in ctrs) {
    val args = [amount.to_text(), "0x" + to, ctr.to_text()];
    messages.add(message_template.format(amount.to_text(), "0x" + to, ctr.to_text()));
  }
  require(acc.authenticate(set(["A"]), messages));
}

/**
* NOTE: This operation is used specifically to reach a certain validation rule in the auth 
* implementation and does not represent a usage example of the API
*/
operation dev_perform_large_transfer_with_custom_messages(
  message_template: text,
  from: acc.account,
  to: text,
  amount: integer,
  messages: list<text>
) {
  dev_op.require_dev();
  val previous_op = op_context.get_all_operations()[op_context.op_index - 1];
  val ctrs = list<integer>.from_gtv(previous_op.args[2]);

  require(acc.authenticate(set(["A"]), messages));
}


