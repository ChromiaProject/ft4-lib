module;

import ft3: ^^.core;
import acc: ^^.account;

struct module_args {
    admin_pub_key: text; 
}

function require_admin() {
	val adminPubKeyBytes = byte_array(chain_context.args.admin_pub_key);
	require(op_context.is_signer(adminPubKeyBytes), "Needs to be signed by admin");
}

function dev_give_points_(account: acc.account, amount: integer) {
	require_admin();
    var state = require(
        acc.rl_state@?{account}, 
        "Rate limiter state not found for the account with ID: %s".format(account.id)
    );
	state.points += amount;
}