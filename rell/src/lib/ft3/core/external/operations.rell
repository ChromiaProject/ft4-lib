import ^^.core;
import ^^.auth;

query transfer_auth_data() = auth.auth_data(["T"], "Do you want to transfer %s from account %s to account %s? Nonce: %s");

operation transfer(inputs: list<core.xfer_input>, outputs: list<core.xfer_output>) {
    core._transfer(inputs, outputs);
}

query transfer_one_auth_data(gtv) {
    val params = struct<transfer_one>.from_gtv(gtv);
    val asset = core.Asset(params.asset_id);

    return auth.auth_data(
        flags = ["T"],
        message = "Please sign the message\nto transfer %s %s\n\nfrom:\n{account_id}\n\nto:\n%s\n\nNonce: {nonce}"
            .format(params.amount, asset.name, params.receiver_id)
    );
}

operation transfer_one(receiver_id: byte_array, asset_id: byte_array, amount: big_integer) {
    val auth_data = transfer_one_auth_data(auth.args());
    val account = acc.authenticate(set(auth_data.flags), auth_data.message);
}
