module;

import ft3: ^^.core;
import acc: ^^.account;

object dev_state {
   mutable allow_dev_ops: boolean = true;
}

function require_dev() {
    require(dev_state.allow_dev_ops, "Developer operations are not allowed!");
}

function dev_give_points_(account: acc.account, amount: integer) {
	require_dev();
    var state = require(
        acc.rl_state@?{account}, 
        "Rate limiter state not found for the account with ID: %s".format(account.id)
    );
	state.points += amount;
}