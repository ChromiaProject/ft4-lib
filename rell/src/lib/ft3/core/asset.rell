import acc: ^.account;

entity asset {
    key id: byte_array;
    name;
    symbol: text;
    decimals: integer;
    issuing_brid: byte_array;
    icon_url: text;
    mutable total_supply: big_integer;
}

function Asset(id: byte_array) = require(
    asset @? { id },
    "Asset <%s> not found".format(id)
);

entity balance {
    key acc.account, asset;
    mutable amount: big_integer = 0L;
}

val max_big_int = big_integer
    .from_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff");

function ensure_balance(acc.account, asset): balance {
    val balance = balance @? {asset, account};
    if (balance != null) {
       return balance;
    }
    else return create balance(account, asset, amount = 0L);
}

function get_asset_balances(account_id: byte_array) {
    return balance @* { .account.id == account_id } (
        asset = (
            id = .asset.id,
            name = .asset.name,
            decimals = .asset.decimals,
            brid = .asset.issuing_brid,
            supply = .asset.total_supply
        ),
        amount = .amount
    );
}

function zero_exclusive_check_limits(value: big_integer, name) {
    require(
        value <= max_big_int, name+": value must be lower than 2^256");
    require(value > 0L, name+": value must be non-zero positive");
}

namespace Unsafe {
    function mint(acc.account, asset, amount: big_integer) {
        zero_exclusive_check_limits(amount, "Parameter amount");
        require(
            asset.issuing_brid == chain_context.blockchain_rid,
            "Assets can only be minted on issuing chain"
        );
        before_mint(account, asset, amount);
        val balance = ensure_balance(account, asset);

        balance.amount += amount;
        asset.total_supply += amount;

        // require(balance.amount <= max_big_int); checking for unminted tokens
        require(asset.total_supply <= max_big_int, "End total supply must be lower than 2^256");

        create payment_history_entry(
            account,
            asset,
            .delta = amount,
            .op_index = op_context.op_index,
            .is_input = false,
            .entry_index = 0,
            transfer_args = [
                [(
                    amount, 
                    account_id = null.to_gtv().to_bytes(), 
                    entry_index = 0
                )],
                [(
                    amount, 
                    account_id = account.id,
                    entry_index = 0
                )]
            ].to_gtv().to_bytes()
        );

        after_mint(account, asset, amount);
    }

    function burn(acc.account, asset, amount: big_integer) {
        zero_exclusive_check_limits(amount, "Parameter amount");
        require(
            asset.issuing_brid == chain_context.blockchain_rid,
            "Assets can only be burned on issuing chain"
        );
        val balance = balance @ {asset, account};
        before_burn(account, asset, amount);

        require(balance.amount >= amount, "Insufficient balance");
        // require(asset.total_supply >= amount); checking for supply < balance

        balance.amount -= amount;
        asset.total_supply -= amount;

        create payment_history_entry (
            account,
            asset,
            .delta = amount,
            .op_index = op_context.op_index,
            .is_input = true,
            .entry_index = 0,
            transfer_args = [
                [(
                    amount, 
                    account_id = account.id,
                    entry_index = 0
                )],
                [(
                    amount, 
                    account_id = null.to_gtv().to_bytes(), 
                    entry_index = 0
                )]
            ].to_gtv().to_bytes()
        );
        after_burn(account, asset, amount);
    }

    function register_asset(
        name,
        symbol: text,
        decimals: integer,
        icon_url: text): asset {
        require(decimals >= 0 and decimals < 79, "Decimals must be between 0 and 78 (included)");
        val id = (name, chain_context.blockchain_rid).hash();
        return create asset (
            id,
            name,
            symbol,
            decimals,
            issuing_brid=chain_context.blockchain_rid,
            icon_url,
            total_supply=0L
        );
    }
}