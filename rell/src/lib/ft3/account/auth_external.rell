struct signature {
    r: text;
    s: text;
    v: integer;
}

struct eth_auth_args {
    account_auth_descriptor;
    signatures: list<signature>;
    ctrs: list<integer>;
}

function AuthDescriptor(id: byte_array) = require(
    account_auth_descriptor @? { id },
    "Provided auth descriptor id does not exist %s".format(id)
);

function authenticate(required_flags: set<text>, messages: list<text>): boolean {
    require(op_context.op_index > 0, "Expected at least two operations");

    val previous_op = op_context.get_all_operations()[op_context.op_index - 1];
    require(
        previous_op.name in ["ft.eth_auth", "ft.ft_auth"],
        "Error authenticating operation. Incorrect auth operation %s".format(previous_op.name)
    );
    return when (previous_op.name) {
        "ft.eth_auth" -> _validate_eth_signature(previous_op.args, required_flags, messages);
        "ft.ft_auth" -> _validate_ft4_signature(previous_op.args, required_flags);
        else -> false;
    };
}

function _validate_eth_signature(auth_args: list<gtv>, required_flags: set<text>, messages: list<text>): boolean {
    val validated_args = _validate_eth_arguments(auth_args, required_flags, messages);

    var recovered_keys = 
        if (validated_args.account_auth_descriptor.auth_type == "S") [_recover_eth_key(messages[0], validated_args.signatures[0], validated_args.account_auth_descriptor.id)] 
        else _recover_multiple_eth_keys(messages, validated_args.signatures, validated_args.account_auth_descriptor);
    
    _check_ctr(validated_args.account_auth_descriptor.id, recovered_keys, validated_args.ctrs);
    return true;
}

function _validate_eth_arguments(auth_args: list<gtv>, required_flags: set<text>, messages: list<text>): eth_auth_args {
    require(auth_args.size() == 4, "Incorrect number of arguments to auth operation");

    val auth_descriptor_id = byte_array.from_gtv(auth_args[0]);
    val signatures = list<signature>.from_gtv(auth_args[1]);
    val ctrs = list<integer>.from_gtv(auth_args[2]);

    require(
        signatures.size() == messages.size(),
        "# signatures (%d) does not match # messages provided (%d)".format(signatures.size(), messages.size()));
    
    val auth_descriptor = AuthDescriptor(auth_descriptor_id);
    require(is_valid(auth_descriptor));
    
    val has_all_flags = when (auth_descriptor.auth_type) {
        "S" -> single_sig_args.from_bytes(auth_descriptor.args).flags.contains_all(required_flags);
        "M" -> multi_sig_args.from_bytes(auth_descriptor.args).flags.contains_all(required_flags);
        else -> false;
    };
    
    require(has_all_flags, "The auth descriptor does not have the required permissions");

    return eth_auth_args(auth_descriptor, signatures, ctrs);
}

function _recover_multiple_eth_keys(messages: list<text>, signatures: list<signature>, account_auth_descriptor) {
    var recovered_keys = list<byte_array>();
    for (i in range(signatures.size())) {
        recovered_keys.add(
            _recover_eth_key(
                messages[i], 
                signatures[i], 
                account_auth_descriptor.id
            )
        );
    }
    require(
        recovered_keys.size() >= multi_sig_args.from_bytes(account_auth_descriptor.args).signatures_required, 
        "Minimum number of valid signatures not reached"
    );
    return recovered_keys;
}

function _recover_eth_key(message: text, signature, auth_descriptor_id: byte_array) {
    require(message != "", "Empty messages are not allowed");

    val msg_hash = keccak256(("\u0019Ethereum Signed Message:\n" + message.size().to_text() + message).to_bytes());
    val eth_pubkey = eth_ecrecover(
        byte_array.from_hex(signature.r),
        byte_array.from_hex(signature.s),
        signature.v - 27,
        msg_hash
    );

    val recovered_address = keccak256(eth_pubkey).sub(12);
    val participant = auth_descriptor_participant @? {
        .account_auth_descriptor.id == auth_descriptor_id,
        .id == recovered_address
    };
    require(participant, "Invalid signature");

    return recovered_address;
}

function _validate_ft4_signature(auth_args: list<gtv>, required_flags: set<text>): boolean {
    val auth_descriptor_id = byte_array.from_gtv(auth_args[0]);

    val external = auth_descriptor_participant @? {
        .account_auth_descriptor.id == auth_descriptor_id, 
        .id in op_context.get_signers()
    };
    require(external, "The proided key(s) is not a signer of this auth descriptor");

    require_auth(
        external.account_auth_descriptor.account,
        external.account_auth_descriptor,
        list(required_flags)
    );

    return true;
}

function _check_ctr(auth_descriptor_id: byte_array, external_keys: list<byte_array>, ctrs: list<integer>) {
    require(external_keys.size() == ctrs.size(), "# of external keys and # counters differ");

    val participants = auth_descriptor_participant @* {
        .account_auth_descriptor.id == auth_descriptor_id, 
        .id in external_keys
    };

    require(participants.size() > 0, "No valid participants found for the specified auth descriptor");

    var provided = map<byte_array, integer>();
    for (i in range(external_keys.size())) {
        provided.put(external_keys[i], ctrs[i]);
    }

    for (participant in participants) {
        require(provided[participant.id] == participant.ctr, "Unexpected counter value");
        participant.ctr += 1;
    }
}

operation eth_auth(
    auth_descriptor_id: byte_array,
    signatures: list<signature>,
    ctrs: list<integer>,
    disposable_key: pubkey
) {
    require(disposable_key in op_context.get_signers(), "Transaction must be signed with disposable key");
}

operation ft_auth(
    auth_descriptor_id: byte_array
) {}

