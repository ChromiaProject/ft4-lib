import acc: ^;
import core: ^^.core;

struct auth_data {
    flags: list<text>;
    message: text;
}

query default_auth_data() = auth_data(list<text>(), "");

query dev_register_account_auth_data() = auth_data(["A"], "Do you want to create a new account for key %s? Nonce: %s");
query dev_give_points_auth_data() = auth_data(["A"], "Do you want to give %s points to account %s? Nonce: %s");
query dev_give_balance_auth_data() = auth_data(["A"], "Do you want to give balance %s to account %s? Nonce: %s");
query dev_register_asset_auth_data() = auth_data(["A"], "Do you want to register the asset %s? Nonce: %s");
query dev_free_op_auth_data() = auth_data(["A"], "");

query add_auth_descriptor_auth_data() = auth_data(["A"], "Do you want to add auth descriptor to account %s? Nonce: %s");
query delete_auth_descriptor_auth_data() = auth_data(["A"], "Do you want to delete auth descriptor from account %s? Nonce: %s");
query delete_all_auth_descriptors_exclude_auth_data() = auth_data(["A"], "Do you want to delete all auth descriptors from account %s? Nonce: %s");
query transfer_auth_data() = auth_data(["T"], "Do you want to transfer %s from account %s to account %s? Nonce: %s");

