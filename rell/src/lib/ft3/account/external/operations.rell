import acc: ^^.account;
import ^^.core;
import ^^.auth;

query delete_auth_descriptor_auth_data() = auth.auth_data(
    ["A"], 
    "Do you want to delete auth descriptor from account %s? Nonce: %s"
);

operation delete_auth_descriptor(account_id: byte_array, auth_descriptor_id: byte_array, delete_descriptor_id: byte_array) {
    val flags = if (auth_descriptor_id == delete_descriptor_id) list<text>() else ["A"];

    val account = acc.account_by_id(account_id);
    acc.auth(account, 
        acc.auth_descriptor_by_id(account, auth_descriptor_id),
        flags
    );

    acc._delete_auth_descriptor(
        acc.auth_descriptor_by_id(account, delete_descriptor_id)
    );
}

query delete_auth_descriptor_v2_auth_data() = auth.auth_data(
    ["A"], 
    "Do you want to delete auth descriptor from account %s? Nonce: %s"
);

operation delete_auth_descriptor_v2(auth_descriptor_id: byte_array) {
    // val flags = if (auth_descriptor_id == delete_descriptor_id) list<text>() else ["A"];

    val auth_data = delete_auth_descriptor_v2_auth_data();
    val account = acc.authenticate(set(auth_data.flags), auth_data.message);

    acc._delete_auth_descriptor(
        acc.auth_descriptor_by_id(account, auth_descriptor_id)
    );    
}

query delete_all_auth_descriptors_exclude_auth_data() = auth.auth_data(
    ["A"], 
    "Do you want to delete all auth descriptors from account %s? Nonce: %s"
);

operation delete_all_auth_descriptors_exclude(account_id: byte_array, auth_descriptor_id: byte_array) {
    val account =  acc.account_by_id(account_id);
    val auth_descriptor = acc.auth_descriptor_by_id(account, auth_descriptor_id);
    acc.auth(account, auth_descriptor, ["A"]);

    acc._delete_all_auth_descriptors_exclude(auth_descriptor);
}

query add_auth_descriptor_auth_data() = auth.auth_data(
    ["A"], 
    "Do you want to add auth descriptor to account %s? Nonce: %s"
);

operation add_auth_descriptor(account_id: byte_array, auth_id: byte_array, new_desc: acc.auth_descriptor) {
    val account = acc.account_by_id(account_id);
    acc.auth(account, acc.auth_descriptor_by_id(account, auth_id), ["A"]);
    acc.add_auth_descriptor_to_account(account, new_desc);
}

query add_auth_descriptor_v2_auth_data() = auth.auth_data(
    ["A"], 
    "Do you want to add auth descriptor to account %s? Nonce: %s"
);

operation add_auth_descriptor_v2(new_desc: acc.auth_descriptor) {
    val auth_data = add_auth_descriptor_v2_auth_data();
    val account = acc.authenticate(set(auth_data.flags), auth_data.message);
    acc.add_auth_descriptor_to_account(account, new_desc);
}