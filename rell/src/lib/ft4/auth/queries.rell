
query get_auth_flags(op_name: name, is_strict: boolean) = get_auth_handler(op_name, is_strict).flags;

query get_auth_message_template(op_name: name, op_args: gtv, is_strict: boolean) {
    val formatter = get_auth_handler(op_name, is_strict).message_formatter;

    return if (formatter??) formatter(op_args) else generate_auth_message_template(chain_context.blockchain_rid, gtx_operation(
        name = op_name,
        args = list<gtv>.from_gtv(op_args)
    ));
}
