
val DEFAULT_LOGIN_CONFIG_NAME = "default";

struct login_rule_expression {
	operator: accounts.rule_operator;
	variable: accounts.rule_variable;
	value: text;
}

query get_login_config(name? = null) {
    val configs = login_config();
    val config_name = name ?: DEFAULT_LOGIN_CONFIG_NAME;

    if (config_name == DEFAULT_LOGIN_CONFIG_NAME) {
        return if (config_name in configs) configs[config_name] else _login_config(flags = []);
    }
    
    return require(
        configs.get_or_null(config_name), 
        "Unknown login configuration <%s>".format(config_name)
    );
}

struct _login_config {
    flags: list<text>;
    rules: gtv = accounts.GTV_NULL;
}

@extendable
function login_config(): map<name, _login_config>;

function add_login_config(
    name = DEFAULT_LOGIN_CONFIG_NAME,
    flags: list<text>,
    rules: gtv = accounts.GTV_NULL
) {
    return [name: _login_config(flags, rules)];
}

function create_login_rule(gtv_rules_to_translate: gtv): gtv{
    val rules = list<gtv>.from_gtv(gtv_rules_to_translate);
    if (rules[0] == "and".to_gtv()) {
        var login_rules: list<gtv>;
        login_rules = [rules[0]];
        val rules_without_and = rules.sub(1);
        for (rule in rules_without_and) {
            val rule_exp = accounts.rule_expression.from_gtv(rule);
            login_rules.add(convert_rule_to_login_rule(rule_exp).to_gtv());
        }
        return login_rules.to_gtv();
    } else {
        val rule_exp = accounts.rule_expression.from_gtv(gtv_rules_to_translate);
        return convert_rule_to_login_rule(rule_exp).to_gtv();
    }
}

function convert_rule_to_login_rule(accounts.rule_expression) {
    if (rule_expression.variable == accounts.rule_variable.op_count) {
        return login_rule_expression(
            rule_expression.operator,
            rule_expression.variable,
            "%d".format(rule_expression.value)
        );
    } else {
        return login_rule_expression(
            rule_expression.operator,
            rule_expression.variable,
            "{%d}".format(rule_expression.value)
        );
    }
}

function ttl(millis: integer) {
    return login_rule_expression(
        accounts.rule_operator.lt,
        accounts.rule_variable.block_time,
        "{%d}".format(millis)
    ).to_gtv();
}
