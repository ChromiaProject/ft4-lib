@extendable
function is_create_on_transfer_enabled(): boolean = false;

@extendable
function create_on_transfer(
   sender_blockchain_rid: byte_array,
   sender: accounts.account,
   recipient_id: byte_array,
   asset,
   amount: big_integer
);

namespace Unsafe {

   function transfer_to_receipient_id(sender: accounts.account, recipient_id: byte_array, assets.asset, amount: big_integer) {
      val recipient = accounts.account @? { .id == recipient_id };
      if (recipient != null) {
          transfer(sender, recipient, asset, amount);
      } else {
          require(is_create_on_transfer_enabled(),
              "Account <%s> does not exist and creating accounts on transfer is not enabled".format(recipient_id));
          val sender_blockchain_rid = chain_context.blockchain_rid; // internal transfer
          create_on_transfer(sender_blockchain_rid, sender, recipient_id, asset, amount);
      }
   }

   function transfer(from: accounts.account, to: accounts.account, assets.asset, amount: big_integer) {
      require_zero_exclusive_asset_amount_limits(amount, "Parameter amount");
      require(from != to, "Sender and receiver have to be different");

      before_transfer(from, to, asset, amount);

      deduct_balance(from, asset, amount);
      create transfer_history_entry(
         .account = from,
         .asset = asset,
         .delta = amount,
         .op_index = op_context.op_index,
         .is_input = true
      );
      
      increase_balance(to, asset, amount);
      create transfer_history_entry(
         .account = to,
         .asset = asset,
         .delta = amount,
         .op_index = op_context.op_index,
         .is_input = false
      );

      after_transfer(from, to, asset, amount);
   }
}
