import ^^.assets;
import ^^.auth;

query transfer_auth_data(gtv) = auth.auth_data(["T"], "Do you want to transfer %s from account %s to account %s? Nonce: %s");

// TODO: remove
@extend(auth.auth_handler)
function () = auth.auth(
    scope = "ft4.transfer",
    flags = ["T"]
);

operation transfer(inputs: list<assets.xfer_input>, outputs: list<assets.xfer_output>) {
    assets._transfer(inputs, outputs);
}

function transfer_message(gtv) {
    val params = struct<transfer_one>.from_gtv(gtv);
    val asset = assets.Asset(params.asset_id);

    return "Please sign the message\nto transfer %s %s\n\nfrom:\n{account_id}\n\nto:\n%s\n\nNonce: {nonce}"
        .format(
            assets.format_amount_with_decimals(params.amount, asset.decimals),
            asset.name,
            params.receiver_id
        );
}

@extend(auth.auth_handler)
function () = auth.auth(
    scope = "ft4.transfer_one",
    flags = ["T"],
    formatter = transfer_message(*)
);

operation transfer_one(receiver_id: byte_array, asset_id: byte_array, amount: big_integer) {
    val account = acc.authenticateV2();
    assets.Unsafe.transfer_one(account, acc.Account(receiver_id), assets.Asset(asset_id), amount);
}

@extend(auth.auth_handler)
function () = auth.auth(
    scope = "ft4.burn",
    flags = ["T"],
    formatter = burn_message(*)
);

function burn_message(gtv) {
    val params = struct<burn>.from_gtv(gtv);
    val asset = assets.Asset(params.asset_id);

    return "Please sign the message\nto burn %s %s\n\nfrom:\n{account_id}\n\nNonce: {nonce}"
        .format(
            assets.format_amount_with_decimals(params.amount, asset.decimals),
            asset.name
        );
}

operation burn(asset_id: byte_array, amount: big_integer) {
    val account = acc.authenticateV2();

    assets.Unsafe.burn(account, assets.Asset(asset_id), amount);
}
