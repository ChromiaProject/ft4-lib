
val _CONFIG_ERROR_TEXT = "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): ";

struct asset_limit_gtv_values {
    id: byte_array;
    min_amount: text;
}

struct allowlist {
    allow_all: boolean = false;
    allowed_values: list<byte_array> = [];
}

struct rule {
    timeout: integer = 0;
    strategies: list<text> = ["open"];
    
    blockchains: allowlist = allowlist();
    senders: allowlist = allowlist();
    recipients: allowlist = allowlist();
    
    require_same_address: boolean = false;
    
    allow_all_assets: boolean = false;
    asset_limits: map<byte_array, big_integer> = map<byte_array, big_integer>();
}

function get_config(config_gtv: gtv = chain_context.args.rules): list<rule> {
    val _list = 165;
    val _text = 162;
    val _byte_array = 161;

    val config = list<rule>();
    val inputs = list<module_args_list_element>.from_gtv_pretty(config_gtv);

    for (input in inputs) {
        val strats = if (input.strategy.to_bytes()[0] == _list)
            list<text>.from_gtv(input.strategy)
            else [text.from_gtv(input.strategy)];

        val sender_res = parse_allowlist_from_gtv(
            input.sender
        );

        val recipient_res = parse_allowlist_from_gtv(
            input.recipient
        );

        require(
            sender_res.require_same == recipient_res.require_same,
            _CONFIG_ERROR_TEXT + "'X' should appear in both or none of recipient and sender"
        );

        var allow_all_assets = false;
        var asset_limits = map<byte_array, big_integer>();
        
        if (input.asset == null) {
            allow_all_assets = true;
        } else {
            val res = parse_asset_limits_from_gtv(input.asset!!);
            if (res == null) {
                allow_all_assets = true;
            } else {
                asset_limits = res;
            }
        }
        
        config.add(rule(
            timeout = input.timeout,
            strategies = strats,

            blockchains = parse_allowlist_from_gtv(
                input.sender_blockchain,
                true
            ).allowlist,
            senders = sender_res.allowlist,
            recipients = recipient_res.allowlist,
            
            require_same_address = sender_res.require_same,

            allow_all_assets,
            asset_limits
        ));
    }
    return config;
}

function parse_allowlist_from_gtv(
    gtv,
    is_blockchain: boolean = false
): (allowlist: allowlist, require_same: boolean) {
    val _list = 165;
    val _text = 162;
    val _byte_array = 161;

    var had_x = false;
    var res = allowlist();

    when (gtv.to_bytes()[0]) {
        _list -> {
            val list_type = list<gtv>.from_gtv(gtv)[0].to_bytes()[0];
            if (list_type == _text) {
                val input = list<text>.from_gtv(gtv);
                if ("*" in input) {
                    require(
                        input.size() == 1,
                        _CONFIG_ERROR_TEXT + "using multiple values alongside '*' is not allowed"
                    );
                    res = allowlist(true);

                } else if ("X" in input) {
                    require(
                        not is_blockchain,
                        _CONFIG_ERROR_TEXT + "X is not allowed in sender_blockchain."
                    );
                    require(
                        input.size() == 1,
                        _CONFIG_ERROR_TEXT + "using multiple values alongside 'X' is not allowed"
                    );
                    had_x = true;
                    res = allowlist(true);

                } else {
                    val allowed_values = list<byte_array>();
                    for (v in input) {
                        if (v == "$") {
                            require(
                                is_blockchain,
                                _CONFIG_ERROR_TEXT + "$ is only allowed in sender_blockchain."
                            );
                            allowed_values.add(chain_context.blockchain_rid);
                        } else allowed_values.add(byte_array.from_hex(v));
                    }
                    res = allowlist(false, allowed_values);

                }
            } else {
                require(
                    list_type == _byte_array,
                    _CONFIG_ERROR_TEXT + "blockchain, sender and recipient lists only support strings and byte arrays"
                );
                res = allowlist(false, list<byte_array>.from_gtv(gtv));

            }
        }
        _text -> { // "*" or "abcdef"
            val input = text.from_gtv(gtv);
            if (input == "*") {
                res = allowlist(true);
            } else if (input == "X") {
                require(
                    not is_blockchain,
                    _CONFIG_ERROR_TEXT + "X is not allowed in sender_blockchain."
                );
                had_x = true;
                res = allowlist(true);
            } else if (input == "$") {
                require(
                    is_blockchain,
                    _CONFIG_ERROR_TEXT + "$ is only allowed in sender_blockchain."
                );
                res = allowlist(false, [chain_context.blockchain_rid]);
            } else res = allowlist(false, [byte_array.from_hex(input)]);

        }
        else -> {
            require(
                gtv.to_bytes()[0] == _byte_array,
                _CONFIG_ERROR_TEXT + "blockchain, sender and recipient field only support strings, byte arrays and lists of these types."
            );
            res = allowlist(false, [byte_array.from_gtv(gtv)]);
        }
    }

    return (allowlist=res, require_same=had_x);
}

function parse_asset_limits_from_gtv(gtv): map<byte_array, big_integer>? {
    val _list = 165;
    
    when (gtv.to_bytes()[0]) {
        _list -> {
            val inputs = list<asset_limit_gtv_values>.from_gtv_pretty(gtv);
            val output = map<byte_array, big_integer>();
            for (i in inputs) {
                output[i.id] = big_integer.from_text(i.min_amount.replace("L", ""));
            }
            return output;
        }
        else -> {
            require(
                gtv=="*".to_gtv(),
                _CONFIG_ERROR_TEXT + "asset only accepts '*' and a list of ids and minimum amounts."
            );
            return null;
        }
    }
}
