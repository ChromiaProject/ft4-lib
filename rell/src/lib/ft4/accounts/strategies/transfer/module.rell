@mount("ft4")
module;

import ^^.strategies;
import ^^^.accounts;
import ^^^.assets;
import ^^^.crosschain;

enum transfer_strategy {
   open
}

entity pending_transfer {
   sender_blockchain_rid: byte_array;
   sender_id: byte_array;
   key recipient_id: byte_array;
   assets.asset;
   amount: big_integer;
   strategies: text;
}

@extend(assets.is_create_on_internal_transfer_enabled)
function() = true;

@extend(assets.create_on_internal_transfer)
function(sender: accounts.account, recipient_id: byte_array, assets.asset, amount: big_integer) {
   assets.Unsafe.transfer(sender, ensure_pool_account(chain_context.blockchain_rid), asset, amount);

   val sender_blockchain_rid = chain_context.blockchain_rid; // internal transfer
   create_on_transfer(sender_blockchain_rid, sender.id, recipient_id, asset, amount);
}

@extend(crosschain.is_create_on_crosschain_transfer_enabled)
function() = true;

@extend(crosschain.create_on_crosschain_transfer)
function(sender_blockchain_rid: byte_array, sender_id: byte_array, recipient_id: byte_array, assets.asset, amount: big_integer) {
   crosschain.Unsafe.update_balances_if_needed(
      crosschain.ensure_blockchain_account(sender_blockchain_rid),
      ensure_pool_account(chain_context.blockchain_rid),
      asset,
      amount
   );

   create_on_transfer(sender_blockchain_rid, sender_id, recipient_id, asset, amount);
}

function ensure_pool_account(blockchain_rid: byte_array): accounts.account {
   val pool_account_id = ("POOL" + chain_context.blockchain_rid).hash();
   val acc = accounts.account @? { .id == pool_account_id };
   if (acc??) {
      return acc;
   } else {
      return create accounts.account(id = pool_account_id);
   }
}

function create_on_transfer(
      sender_blockchain_rid: byte_array,
      sender_id: byte_array,
      recipient_id: byte_array,
      assets.asset,
      amount: big_integer) {
   // TODO find matching rule, reject if no rule is found

   require(empty(pending_transfer @? { recipient_id }),
      "Pending transfer for account <%s> already exists".format(recipient_id));

   create pending_transfer(sender_blockchain_rid, sender_id, recipient_id, asset, amount,
        strategies = transfer_strategy.open.name);
}

@extend(strategies.strategy)
function () = strategies.add_strategy(
   op = rell.meta(ras_transfer),
   account_details = account_details(*),
   action = action(*)
);

operation ras_transfer(
   strategy: transfer_strategy,
   initial: accounts.auth_descriptor
) {}

function account_details(gtv) {
   val params = struct<ras_transfer>.from_gtv(gtv);
   val signers = strategies.get_signers(params.initial);
   return strategies.account_details(
       account_id = strategies.get_account_id_from_signers(signers),
       initial = params.initial,
       disposable = null
   );
}

function action(accounts.account) {
   val pending_transfer = require(pending_transfer @? { .recipient_id == account.id },
      "No pending transfer to account id <%s>".format(account.id));

   assets.Unsafe.transfer(
      ensure_pool_account(chain_context.blockchain_rid),
      account,
      pending_transfer.asset,
      pending_transfer.amount);

   delete pending_transfer;

   // TODO perform transfer strategy action
}
