import ^.assets;
import ^.accounts;

struct init_transfer_args {
    receiver_id: byte_array;
    asset_id: byte_array;
    amount: big_integer;
    hops: list<byte_array>;
}

entity applied_transfers { key tx_rid: byte_array; }

namespace Unsafe {
    function transfer(
        accounts.account,
        brid: byte_array,
        assets.asset,
        amount: big_integer
    ) {
        require(
            chain_context.blockchain_rid != brid,
            "Cannot transfer to own account"
        );
        assets.require_zero_exclusive_asset_amount_limits(amount, "Parameter amount");

        val origin_brid = asset_origin @? { asset } .origin_brid;
        val bc_acc = ensure_blockchain_account(brid);

        require(account != bc_acc, "Sender and receiver have to be different");
        
        val args = [
            [(amount, account.id, 0)],
            [(amount, bc_acc.id, 0)]
        ];

        if (
            not exists(origin_brid)
            or origin_brid != account.id
        ) {
            assets.deduct_balance(account, asset, amount);
        }

        create assets.transfer_history_entry(
            .account = account,
            .asset = asset,
            .delta = amount,
            .op_index = op_context.op_index,
            .is_input = true,
            .entry_index = 0,
            .transfer_args = args.to_gtv().to_bytes()
        );

        if (not exists(origin_brid) or origin_brid != brid ) {
            // always forget the balance of the owner of the asset
            assets.ensure_balance(bc_acc, asset).amount += amount;
        }
        
        create assets.transfer_history_entry(
            .account = bc_acc,
            .asset = asset,
            .delta = amount,
            .op_index = op_context.op_index,
            .is_input = false,
            .entry_index = 0,
            .transfer_args = args.to_gtv().to_bytes()
        );
    }
}
