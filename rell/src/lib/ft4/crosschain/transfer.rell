import ^.assets;

struct crosschain_target {
    account_id: byte_array;
    extra: map<text, gtv>;
}

function add_to_blockchain_balance(brid: byte_array, assets.asset, amount: big_integer) {
    require(
        chain_context.blockchain_rid != brid,
        "Cannot add to own account"
    );

    val origin_brid = asset_origin @? { asset } .origin_brid;

    if (exists(origin_brid) and (brid == origin_brid)) {
       // do nothing. in future we might track origin
    } else {
         val bc_acc = ensure_blockchain_account(brid);
         assets.ensure_balance(bc_acc, asset).amount += amount;
    }
}


struct init_transfer_args {
    //source: assets.transfer_input;
    target: crosschain_target;
    hops: list<byte_array>;
}

entity applied_transfers { key tx_rid: byte_array; }
