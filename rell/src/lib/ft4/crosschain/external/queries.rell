import ^^.assets;
import crosschain: ^;
import ^^.accounts;
import ^^.utils;

query get_asset_origin_by_id(asset_id: byte_array) {
    return crosschain.asset_origin @? { assets.Asset(asset_id) } .origin_brid;
}

query get_pending_transfers_for_account(account_id: byte_array, page_size: integer, page_cursor: text?) {
    return utils.make_page(
        get_paginated_pending_transfers(account_id, page_size, page_cursor),
        page_size
    );
}

function get_paginated_pending_transfers(account_id: byte_array, page_size: integer, page_cursor: text?) {
    val before_rowid = utils.before_rowid(page_cursor);

    val debug = crosschain.pending_transfer @* {
        pending_transfer.account.id == account_id,
        pending_transfer.rowid > (before_rowid ?: rowid(0))
    } (
        utils.pagination_result(
            data = (
                tx_data = .transaction.tx_data,
                op_index = pending_transfer.op_index,
                account_id = pending_transfer.account.id
            ).to_gtv_pretty(),
            rowid = pending_transfer.rowid
        )
    ) limit utils.fetch_data_size(page_size);

    return crosschain.pending_transfer @* {
        pending_transfer.account.id == account_id,
        pending_transfer.rowid > (before_rowid ?: rowid(0))
    } (
        utils.pagination_result(
            data = (
                tx_data = .transaction.tx_data,
                op_index = pending_transfer.op_index,
                account_id = pending_transfer.account.id
            ).to_gtv_pretty(),
            rowid = pending_transfer.rowid
        )
    ) limit utils.fetch_data_size(page_size);
}

query is_transfer_applied(tx_rid: byte_array, op_index: integer) {
    val transfer = crosschain.applied_transfers @? { .tx_rid == tx_rid, .op_index == op_index };
    return transfer != null;
}
