import ^^.assets;
import crosschain: ^;
import ^^.accounts;

query get_asset_origin_by_id(asset_id: byte_array) {
    return crosschain.asset_origin @? { assets.Asset(asset_id) };
}

query get_pending_transfers_for_account(account_id: byte_array) = 
    crosschain.pending_transfer @* { .account.id == account_id }( $.to_struct() );

query is_transfer_applied(tx_rid: byte_array, op_index: integer) {
    val transfer = crosschain.applied_transfers @? { .tx_rid == tx_rid, .op_index == op_index };
    return transfer != null;
}
