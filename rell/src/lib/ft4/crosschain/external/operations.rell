import ^^.assets;
import ^^.accounts;
import ^^.auth;
import crosschain: ^;
import ^^^.iccf;

function init_transfer_message(gtv) {
    val params = struct<init_transfer>.from_gtv(gtv);
    val asset = assets.Asset(params.asset_id);

    return "Please sign the message\n"+
    "to transfer %s %s\n\n"+
    "from:\n-account {account_id}\n-chain: %s\n\n"+
    "to:\n-account %s\n-chain: %s\n\nNonce: {nonce}"
        .format(
            assets.format_amount_with_decimals(params.amount, asset.decimals),
            asset.name,
            chain_context.blockchain_rid,
            params.receiver_id,
            params.hops[params.hops.size()-1]
        );
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = "ft4.crosschain.init_transfer",
    flags = ["T"],
    message = init_transfer_message(*)
);

operation init_transfer(
    receiver_id: byte_array,
    asset_id: byte_array,
    amount: big_integer,
    hops: list<byte_array>
) {
    val account = auth.authenticate();
    val asset = require(
        assets.asset @? { .id == asset_id }, 
        "Asset not found '%s'".format(asset_id)
    );

    crosschain.Unsafe.update_balances_if_needed(
        account,
        crosschain.ensure_blockchain_account(hops[0]),
        asset,
        amount
    );
    create crosschain.pending_transfer(
        account=account,
        transaction=op_context.transaction,
        op_index=op_context.op_index
    );
}

operation apply_transfer(
    init_transfer_tx: gtx_transaction,
    init_tx_op_index: integer,
    tx: gtx_transaction,
    op_index: integer,
    hop_index: integer
) {
    create crosschain.applied_transfers(tx.to_gtv().hash(), op_index);
    val init_args = if (hop_index == 0) struct<init_transfer>.from_gtv(init_transfer_tx.body.operations[init_tx_op_index].args.to_gtv()) else struct<init_transfer>.from_gtv(init_transfer_tx.body.operations[init_tx_op_index].args[0].to_gtv());

    if (hop_index == 0) {
        require(
            tx.body.operations[op_index].name == "ft4.crosschain.init_transfer", 
            "The operation at number %s from tx is not init_transfer".format(op_index)
        );
        require(
            init_args == struct<init_transfer>.from_gtv(
                tx.body.operations[op_index].args.to_gtv()
            ),
            "Parameter init_args does not match init_transfer arguments"
        );
    } else {
        require(
            tx.body.operations[op_index].name == "ft4.crosschain.apply_transfer", 
            "The operation at number %s from tx is not apply_transfer, ".format(op_index)
        );
        require(
            init_args == struct<init_transfer>.from_gtv(
                tx.body.operations[op_index].args[0].to_gtv()
            ),
            "Parameter init_args does not match the one passed to the last apply_transfer"
        );
    }

    val my_brid = chain_context.blockchain_rid;

    require(
        init_args.hops.size() > hop_index,
        "Argument mismatch: init_args.hops size (%d) is greater than hop_index (%d)".format(init_args.hops.size(), hop_index)
    );
    require(
        init_args.hops[hop_index] == my_brid,
        "This transaction hop must happen on a chain with brid %s"
            .format(init_args.hops[hop_index])
    );

    val from_brid = tx.body.blockchain_rid; 

    if (hop_index > 0) {
        require(
            from_brid == init_args.hops[hop_index - 1],
            "Argument mismatch: init_args.hops (%s) and tx blockchain_rid (%s) don't correspond"
                .format(
                    init_args.hops[hop_index - 1], from_brid
                )
        );
    }

    require(
        iccf.check_iccf_proof(from_brid, tx.to_gtv().hash()),
        "Missing proof for previous hop"
    );

    val asset = assets.Asset(init_args.asset_id);

    val receiver: accounts.account;
    if (init_args.hops.size() > hop_index + 1) {
        // this hop is not last
        val next_hop = init_args.hops[hop_index + 1];
        receiver = crosschain.ensure_blockchain_account(next_hop);
    } else {
        // final hop -- send money to recipient account
        receiver = accounts.account @ { init_args.receiver_id };
    }

    crosschain.Unsafe.update_balances_if_needed(
        crosschain.ensure_blockchain_account(from_brid),
        receiver,
        asset,
        init_args.amount
    );
}

operation complete_transfer(
    iccf_tx: gtx_transaction,
    original_tx_rid: byte_array,
    init_transfer_op_index: integer,
    apply_transfer_op_index: integer
) {
    require(
        iccf.check_iccf_proof(
            iccf_tx.body.blockchain_rid,
            iccf_tx.to_gtv().hash()
        ),
        "Could not delete pedning transfer as the proof is not anchored yet"
    );
    val pending_transfer = crosschain.pending_transfer @ { .transaction.tx_rid == original_tx_rid, .op_index == init_transfer_op_index };
    val tx = gtx_transaction.from_bytes(pending_transfer.transaction.tx_data);

    require(
        tx.body.operations[init_transfer_op_index].name == "ft4.crosschain.init_transfer", 
        "Provided op_index was %s instead of init_transfer".format(tx.body.operations[init_transfer_op_index].name)
    );

    val init_transfer_args = struct<init_transfer>.from_gtv(tx.body.operations[init_transfer_op_index].args.to_gtv());
    require(iccf_tx.body.blockchain_rid == init_transfer_args.hops[init_transfer_args.hops.size() - 1], "This xc transfer is not completed yet");

    val apply_transfer_args = struct<apply_transfer>.from_gtv(iccf_tx.body.operations[apply_transfer_op_index].args.to_gtv());
    require(apply_transfer_args.init_transfer_tx == tx, "The proof for the apply_transfer does not match the init_transfer transaction");

    delete pending_transfer;
}
