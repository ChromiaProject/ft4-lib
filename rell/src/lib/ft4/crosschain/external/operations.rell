import ^^.assets;
import ^^.accounts;
import ^^.auth;
import crosschain: ^;
import ^^^.iccf;

function init_transfer_message(gtv) {
    val params = struct<init_transfer>.from_gtv(gtv);
    val asset = assets.Asset(params.asset_id);

    return "Please sign the message\n"+
    "to transfer %s %s\n\n"+
    "from:\n-account {account_id}\n-chain: %s\n\n"+
    "to:\n-account %s\n-chain: %s\n\nNonce: {nonce}"
        .format(
            assets.format_amount_with_decimals(params.amount, asset.decimals),
            asset.name,
            chain_context.blockchain_rid,
            params.receiver_id,
            params.hops[params.hops.size()-1]
        );
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = "ft4.crosschain.init_transfer",
    flags = ["T"],
    message = init_transfer_message(*)
);

operation init_transfer(
    receiver_id: byte_array,
    asset_id: byte_array,
    amount: big_integer,
    hops: list<byte_array>
) {
    val account = auth.authenticate();
    val asset = require(
        assets.asset @? { .id == asset_id }, 
        "Asset not found '%s'".format(asset_id)
    );
    crosschain.Unsafe.transfer(
        account,
        hops[0],
        asset,
        amount
    );
}

operation apply_transfer(
    init_tx_rid: byte_array,
    init_tx: crosschain.transaction_proof,
    prev_hop: crosschain.transaction_proof?,
    hop_index: integer
) {
    val tx_hash = init_tx.tx.hash();
    require(
        tx_hash == init_tx_rid, 
        "Argument mismatch: init_tx (%s) and init_tx_rid (%s)".format(tx_hash, init_tx_rid)
    );
    create crosschain.applied_transfers (init_tx_rid);

    require(
        init_tx.tx.body.operations[0].name == "ft4.crosschain.init_transfer", 
        "init_tx is not the start of a crosschain transaction"
    );
    val init_args = crosschain.init_transfer_args.from_gtv(
        init_tx.tx.body.operations[0].args.to_full().to_gtv()
    );

    val my_brid = chain_context.blockchain_rid;

    require(
        init_args.hops.size() > hop_index,
        "Argument mismatch: init_args.hops size (%d) is greater than hop_index (%d)".format(init_args.hops.size(), hop_index)
    );
    require(
        init_args.hops[hop_index] == my_brid,
        "This transaction hop must happen on a chain with brid %s"
            .format(init_args.hops[hop_index])
    );

    val from_brid: byte_array; 

    if (hop_index > 0) {
        from_brid = init_args.hops[hop_index - 1];

        require(
            prev_hop, 
            "Argument mismatch: prev_hop is null, but hop_index > 0 (%d)".format(hop_index)
        );
        iccf.check_iccf_proof(prev_hop, init_tx_rid);
        require(
            prev_hop.tx.body.brid == from_brid,
            "Argument mismatch: prev_hop brid (%s) and init_args.hops (%s) don't correspond"
                .format(prev_hop.tx.body.brid, from_brid)
        );
        require(
            prev_hop.tx.body.operations[0].name == "ft4.crosschain.apply_transfer",
            "prev_hop didn't start with ft4.crosschain.apply_transfer"
        );

        val prev_hop_init_tx_rid = byte_array.from_gtv(prev_hop.tx.body.operations[0].args[0]);
        require(
            prev_hop_init_tx_rid == init_tx_rid,
            "Argument mismatch: prev_hop had a different init_tx_rid (%s). Should be '%s'"
                .format(prev_hop_init_tx_rid, init_tx_rid)
        );
    } else {
        from_brid = init_tx.tx.body.brid;
    }

    val asset = assets.Asset(init_args.asset_id);

    if (init_args.hops.size() > hop_index + 1) {
        // this hop is not last
        val next_hop = init_args.hops[hop_index + 1];
        crosschain.Unsafe.transfer(
            accounts.account @ { from_brid },
            next_hop,
            asset,
            init_args.amount
        );
    } else {
        // final hop -- send money to recipient account
        val origin = crosschain.asset_origin @? { asset } .origin_brid;
        val receiver = accounts.account @ { init_args.receiver_id };
        if (exists(origin) and origin == from_brid) {
            assets.ensure_balance(receiver, asset).amount += init_args.amount;

            val args = [
                [(init_args.amount, from_brid, 0)],
                [(init_args.amount, init_args.receiver_id, 0)]
            ];

            create assets.transfer_history_entry(
                .account = crosschain.ensure_blockchain_account(from_brid),
                .asset = asset,
                .delta = init_args.amount,
                .op_index = op_context.op_index,
                .is_input = true,
                .entry_index = 0,
                .transfer_args = args.to_gtv().to_bytes()
            );
            create assets.transfer_history_entry(
                .account = receiver,
                .asset = asset,
                .delta = init_args.amount,
                .op_index = op_context.op_index,
                .is_input = false,
                .entry_index = 0,
                .transfer_args = args.to_gtv().to_bytes()
            );
        } else {
            assets.Unsafe.transfer(
                accounts.account @ { from_brid },
                accounts.account @ { init_args.receiver_id },
                asset,
                init_args.amount
            );
        }
    }
}
