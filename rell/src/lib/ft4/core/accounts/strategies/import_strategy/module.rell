@mount("ft4")
module;

import ^^^^.core.auth;
import ^^^^.core.assets;
import ^^^^.core.accounts;
import ^^^^.core.accounts.strategies;
import external_auth: ^^^^.external.auth;
import ^^^^.utils;
import ^^^^^.iccf;
import module_args_utils: ^;

/**
 * The operation that defines the import strategy. The import strategy allows importing
 * an existing account from a trusted chain by providing ICCF proof of the account's
 * existence and authentication on the origin chain.
 * This strategy requires verification of signatures and proof anchoring to ensure
 * the account being imported is legitimate.
 * 
 * Throws if the next operation in the transaction is not accepted by
 * `require_register_account_next_operation`
 * 
 * @see core.accounts.strategies._strategy for information on how to register an account
 * using this strategy
 * 
 * @param iccf_proof_transaction the ICCF proof transaction containing the account verification
 * @param main                  the main auth descriptor for the account that will be registered
 * @param disposable            optionally, the disposable auth descriptor for the same account
 */
operation ras_import(
    iccf_proof_transaction: gtx_transaction,
    main: accounts.auth_descriptor,
    disposable: accounts.auth_descriptor? = null
) {
    val signers = accounts.get_signers(main);
    val operations = op_context.get_all_operations();

    require(
        iccf_proof_transaction
            .body
            .blockchain_rid in trusted_chains().allowed_values,
        "INVALID ORIGIN CHAIN: The account cannot be imported from an untrusted chain"
    );

    var iccf_operations = iccf.require_valid_proof(
        iccf_proof_transaction,
        require_anchored_proof = true,
        verify_signers = true,
        min_timestamp = op_context.last_block_time - import_account_timeout()
    );

    
    var op_index: integer? = null;
    for (op in iccf_operations) {
        if (op.name == rell.meta(verify_account).mount_name) {
            op_index = iccf_operations.index_of(op);
        }
    }
    require(op_index != null, "INVALID_VERIFY_ACCOUNT: The verify_account operation is not among the operations");
   

    val preceding_auth = iccf_operations[op_index - 1];
    require(
        auth.is_auth_op(preceding_auth),
        "INVALID_PRECEDING_AUTH: The preceding auth is not a ft_auth or evm_auth"
    );

    val account_id = auth.extract_account_id(preceding_auth);
    val account_details = account_details((op_index, iccf_proof_transaction, main, disposable).to_gtv());
    require(
        account_details.account_id == account_id,
        "INVALID_PRECEDING_AUTH: The preceding auth does not contain the account ID as specified"
    );

    val signatures = list<auth.signature?>.from_gtv(preceding_auth.args[2]);
    require(
        signatures
            .size() == signers
            .size(),
        "INVALID_SIGNATURES: The number of signatures does not match the number of signers"
    );
    auth.verify_signers(signers);

    if (signers[0].size() == auth.EVM_ADDRESS_SIZE) {

        require(
            preceding_auth
                .name == auth
                .EVM_AUTH_OP,
            "INVALID_PRECEDING_AUTH: The preceding auth is not evm_auth"
        );
    } else if (signers[0].size() == auth.FT_PUBKEY_SIZE) {
        require(
            preceding_auth
                .name == auth
                .FT_AUTH_OP,
            "INVALID_PRECEDING_AUTH: The preceding auth is not ft_auth"
        );
    }

    strategies.require_register_account_next_operation();
}

operation verify_account() {
    var account = auth.authenticate();
}

function verify_account_resolver(args: gtv, account_id: byte_array, auth_descriptor_ids: list<byte_array>) {
    val main_auth_descriptor = require(
        accounts.main_auth_descriptor @? { .account.id == account_id } .auth_descriptor,
        "Account <%s> does not have main auth descriptor set".format(account_id)
    );

    return if (main_auth_descriptor.id in auth_descriptor_ids) main_auth_descriptor.id else null;
}
/**
 * Calculates the account details for the account that will be registered using the
 * `ft4.ras_import` strategy.
 * 
 * @param gtv   the parameters for the `ras_import` operation, GTV-encoded
 */
function account_details(gtv) {
    val params = struct<ras_import>.from_gtv(gtv);
    val signers = accounts.get_signers(params.main);
    return strategies.account_details(
        account_id = accounts.get_account_id_from_signers(signers),
        main = params.main,
        disposable = params.disposable
    );
}

@extend(strategies.strategy)
function () = strategies.add_strategy(
    op = rell.meta(ras_import),
    account_details = account_details(*),
    action = null,
    required_signers = required_signers_import(*)
);

@extend(auth.auth_handler)
function () = auth.add_overridable_auth_handler(
    scope = rell.meta(verify_account).mount_name,
    flags = [],
    message = verify_account_message(*),
    resolver = verify_account_resolver(*)
);

function required_signers_import(gtv) {
    val params = struct<ras_import>.from_gtv(gtv);
    if (params.disposable??) {
        return accounts.get_signers(params.disposable);
    }
    return list<byte_array>();
}

function verify_account_message(gtv) {
    return "Please sign the message\nto verify account:\n{account_id}";
}
