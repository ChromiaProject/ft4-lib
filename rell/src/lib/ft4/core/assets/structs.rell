struct asset_filter {
    rowids: list<rowid>?;
    id: byte_array?;
    name: text?;
    symbol: text?;
    type: text?;
}

struct balance_filter {
    rowids: list<rowid>?;
    account_id: byte_array?;
    asset_id: byte_array?;
}

struct transfer_history_entry_filter {
    rowids: list<rowid>?;
    account_id: byte_array?;
    asset_id: byte_array?;
    transaction_rid: byte_array?;
    op_index: integer?;
}

struct crosschain_transfer_history_entry_filter {
    rowids: list<rowid>?;
    account_id: byte_array?;
    asset_id: byte_array?;
    transaction_rid: byte_array?;
    op_index: integer?;
}