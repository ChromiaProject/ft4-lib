@test module;

import lib.ft4.assets;
import test: lib.ft4.test.core;
import lib.ft4.auth;
import lib.ft4.crosschain;

import ^^.operations.iccf_op.{ iccf_proof };













function get_last_crosschain_transfer_history_entry() {
    return assets.crosschain_transfer_history_entry @ {} (@omit @sort_desc .rowid, $) limit 1;
}

function mock_crosschain_transfer() {
    val sender_blockchain_rid = "sender blockchain".hash();
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();

    val bob = test.register_bob();

    val asset = test.create_crosschain_asset("validAsset", "va", 1, sender_blockchain_rid, "", sender_blockchain_rid);

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                crosschain.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(sender_blockchain_rid, tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(crosschain.external.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run();

    return get_last_crosschain_transfer_history_entry();
}