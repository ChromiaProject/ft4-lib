@test module;

import lib.ft4.assets;
import test: lib.ft4.test.core;
import lib.ft4.auth;
import lib.ft4.crosschain;

import ^^.operations.iccf_op.{ iccf_proof };
import ^^.crosschain.mocks;













function get_last_crosschain_transfer_history_entry() {
    return assets.crosschain_transfer_history_entry @ {} (@omit @sort_desc .rowid, $) limit 1;
}

function create_crosschain_init_transfer_with_auth_operations(
    deadline: integer = 10000000000000,
    asset_name: text = mocks.ASSET_NAME,
    asset_symbol: text = mocks.ASSET_SYMBOL,
    sender_account_id: byte_array = rell.test.keypairs.alice.pub,
    recipient_account_id: byte_array = rell.test.keypairs.bob.pub,
    target_blockchain_rid: byte_array? = null
) {
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val source_blockchain_rid = "sender blockchain".hash();
    val asset = test.create_crosschain_asset(asset_name, asset_symbol, 1, source_blockchain_rid, "", source_blockchain_rid);

    val hops: list<byte_array> = [chain_context.blockchain_rid];
    if (not empty(target_blockchain_rid)) {
        hops.add(target_blockchain_rid);
    }

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                crosschain.external.init_transfer(
                    recipient_id = recipient_account_id,
                    asset_id = asset.id,
                    amount = 5L,
                    hops = hops,
                    deadline = deadline
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    return (tx, source_blockchain_rid);
}

function mock_crosschain_transfer(
    asset_name: text = mocks.ASSET_NAME,
    asset_symbol: text = mocks.ASSET_SYMBOL,
    sender_account_id: byte_array = rell.test.keypairs.alice.pub,
    recipient_account_id: byte_array = rell.test.keypairs.bob.pub
) {
    val (tx, source_blockchain_rid) = create_crosschain_init_transfer_with_auth_operations(
        asset_name = asset_name,
        asset_symbol = asset_symbol,
        sender_account_id = sender_account_id,
        recipient_account_id = recipient_account_id
    );

    rell.test.tx()
        .op(iccf_proof(source_blockchain_rid, tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(crosschain.external.apply_transfer(tx, 1, tx, 1, 0))
        .nop()
        .sign(rell.test.keypairs.alice)
        .run();

    return get_last_crosschain_transfer_history_entry();
}