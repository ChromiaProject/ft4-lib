import ^^.lib.ft4.assets;
import ^^.lib.ft4.accounts;

object transfer_extensions_state {
    mutable is_before_transfer_called: boolean = false;
    mutable before_transfer_from: byte_array = x"";
    mutable before_transfer_to: byte_array = x"";
    mutable before_transfer_asset: byte_array = x"";
    mutable before_transfer_amount: big_integer = 0L;
    
    mutable is_after_transfer_called: boolean = false;
    mutable after_transfer_from: byte_array = x"";
    mutable after_transfer_to: byte_array = x"";
    mutable after_transfer_asset: byte_array = x"";
    mutable after_transfer_amount: big_integer = 0L;
}

@extend(assets.before_transfer) function(from: acc.account, to: acc.account, assets.asset, amount: big_integer) {
    transfer_extensions_state.is_before_transfer_called = true;
    transfer_extensions_state.before_transfer_from = from.id;
    transfer_extensions_state.before_transfer_to = to.id;
    transfer_extensions_state.before_transfer_asset = asset.id;
    transfer_extensions_state.before_transfer_amount = amount;
}

@extend(assets.before_transfer) function(from: acc.account, to: acc.account, assets.asset, amount: big_integer) {
    transfer_extensions_state.is_after_transfer_called = true;
    transfer_extensions_state.after_transfer_from = from.id;
    transfer_extensions_state.after_transfer_to = to.id;
    transfer_extensions_state.after_transfer_asset = asset.id;
    transfer_extensions_state.after_transfer_amount = amount;
}