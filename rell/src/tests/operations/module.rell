import lib.ft4.auth;
import lib.ft4.assets;
import lib.ft4.accounts;
import lib.ft4.accounts.strategies;
import test_auth: .auth;

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    flags = ["T"]
);

operation operation_without_auth_message_template(
    integer,
    big_integer,
    decimal,
    boolean,
    byte_array,
    text,
    optional_text: text?
) {
    auth.authenticate();
}

operation add_ad_to_account(accounts.account, accounts.auth_descriptor) {
    accounts.add_auth_descriptor(account, auth_descriptor);
}

operation register_asset(name, symbol: text, decimals: integer, issuing_blockchain_rid: byte_array, icon_url: text) {
    assets.Unsafe.register_asset(name, symbol, decimals, issuing_blockchain_rid, icon_url);
}

operation register_account_test(accounts.auth_descriptor) {
    accounts.create_account_with_auth(auth_descriptor);
}

operation register_account_without_auth_test(id: byte_array, type: text) {
    accounts.create_account_without_auth(id, type);
}

operation empty_op() {}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(empty_op_with_auth_handler).mount_name,
    flags = ["E"]
);

operation empty_op_with_auth_handler() {
    auth.authenticate();
}

operation consume_point(account_id: byte_array) {
    var state = require(
        accounts.rl_state @? { accounts.account @ { .id == account_id } },
        "Rate limiter state not found for the account with ID: %s".format(account_id)
    );

    require(state.points > 0, "Insufficient rate limiter points");

	state.points -= 1;
    state.last_update = op_context.last_block_time;
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(rejected_op).mount_name,
    flags = ["A"]
);

operation rejected_op() {
    require(false, "always rejected");
}

entity player {
    key accounts.account;
    name;
}

operation register_player(name) {
    val account = strategies.register_account();
    create player(account, name);
}

operation register_player2(name) {
    strategies.register_account();
}

operation function__create_account_with_auth(accounts.auth_descriptor, account_id: byte_array? = null) {
    accounts.create_account_with_auth(auth_descriptor, account_id);
}
