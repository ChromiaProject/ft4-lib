import acc: ^^.lib.ft4.accounts;
import assets: ^^.lib.ft4.assets;
import auth: ^^.lib.ft4.auth;
import test_auth: .auth;

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    flags = ["T"]
);

operation operation_without_auth_message_template(
    integer,
    big_integer,
    decimal,
    boolean,
    byte_array,
    text,
    optional_text: text?
) {
    auth.authenticate(is_strict = false);
}

operation add_ad_to_account(acc.account, acc.auth_descriptor) {
    acc.add_auth_descriptor_to_account(account, auth_descriptor);
}

operation delete_auth_descriptor(acc.account_auth_descriptor) {
  acc._delete_auth_descriptor(account_auth_descriptor);
}

operation register_asset(name, symbol: text, decimals: integer, issuing_blockchain_rid: byte_array, icon_url: text) {
    assets.Unsafe.register_asset(name, symbol, decimals, issuing_blockchain_rid, icon_url);
}

operation register_account_test(acc.auth_descriptor) {
    acc.Unsafe.create_account_with_auth(auth_descriptor);
}

operation empty_op() {}

operation consume_point(account_id: byte_array) {
    var state = require(
        acc.rl_state @? { acc.account @ { .id == account_id } },
        "Rate limiter state not found for the account with ID: %s".format(account_id)
    );

    require(state.points > 0, "Insufficient rate limiter points");

	state.points -= 1;
    state.last_update = op_context.last_block_time;
}
