import lib.ft4.auth;
import lib.ft4.assets;
import lib.ft4.accounts;
import lib.ft4.accounts.strategies;
import test_auth: .auth;


@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    flags = [accounts.auth_flags.TRANSFER]
);

operation operation_without_auth_message_template() {
    auth.authenticate();
}

function operation_with_invalid_auth_message_template_message(gtv?) {
    return "Invalid message template. Nonce: {nonce}";
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(operation_with_invalid_auth_message_template).mount_name,
    flags = [accounts.auth_flags.TRANSFER],
    message = operation_with_invalid_auth_message_template_message(*)
);

operation operation_with_invalid_auth_message_template() {
    auth.authenticate();
}

operation register_account_without_auth_test(id: byte_array, type: text) {
    accounts.create_account_without_auth(id, type);
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(empty_op_with_auth_handler).mount_name,
    flags = ["E"],
);
operation empty_op_with_auth_handler() {
    auth.authenticate();
}

entity player {
    key accounts.account;
    name;
}

operation register_player(name) {
    val account = strategies.register_account();
    create player(account, name);
}

operation register_player2(name) {
    strategies.register_account();
}

operation function__create_account_with_auth(accounts.auth_descriptor, account_id: byte_array? = null) {
    accounts.create_account_with_auth(auth_descriptor, account_id);
}

function test_optional_params_message(gtv) {
    return "Optional params message";
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(test_optional_params).mount_name,
    flags = [],
    message = test_optional_params_message(*)
);

operation test_optional_params(
  amount: integer = 100,
  to: text = "alice"
) {
  auth.authenticate();
}