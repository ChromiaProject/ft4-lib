
@test
module;

import ^^.core.utils;
import acc: ^^^.lib.ft3.account;
import ^^^.lib.ft3.ft3_basic_dev.*;
import ^^^.lib.ft3.operations.dev_op_auth;
import ^^^.lib.ft3.operations.dev_op_account;

/*
 * We aim to unit test the basic authentication rules (e.g. the number of signatures and required flags).
 *
 * Note: 
 * Ideally this should be simple unit tests, but since we have "op_context.is_signer()" inside the auth logic,
 * the code must come from a signed transaction, so we added a new method for this in the "dev_op_auth.rell" file.
 * We also have to go the roundabout way of storing the returned error message in a global object "dev_error".
 */

function required_flags() = ["T"];  

function test_happy_valid() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(dev_op_auth.dev_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_equals(dev_op_auth.dev_error.msg, "valid");
}

function test_invalid_required_flags() {
    val alice = utils.register_alice();

    val bad_required_flags = ["A"]; // <---- Default test Auth Desc doesn't have "A"!!
    rell.test.tx()
        .op(dev_op_auth.dev_auth(alice.account.id, alice.auth_descriptor_id, bad_required_flags))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_equals(dev_op_auth.dev_error.msg, "Some required flags [A] are missing on the (single sig) Auth Descriptor.");
}

function test_invalid_single_signer() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(dev_op_auth.dev_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .sign(rell.test.keypairs.bob) // <---- We sign with wrong user "Bob"
        .run();
    
    assert_equals(dev_op_auth.dev_error.msg, "The participant is not the signer of this transaction.");
}

function test_not_signed() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(dev_op_auth.dev_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .run(); // <--- No signing at all

    assert_equals(dev_op_auth.dev_error.msg, "The participant is not the signer of this transaction.");
}

