function test_locked_asset_balance_can_be_fetched_in_pages() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 1000L);

    op_locking.lock_asset("LOCK3", alice.account.id, asset.id, 300L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 200L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 100L).run();
    
    val page1 = locking_ext.get_locked_asset_balance(alice.account.id, asset.id, null, 2);

    assert_equals(
        page1.data,
        [
            (
                type = "LOCK3",
                amount = 300L
            ).to_gtv_pretty(),
            (
                type = "LOCK2",
                amount = 200L
            ).to_gtv_pretty()                    
        ]
    );

    val page2 = locking_ext.get_locked_asset_balance(alice.account.id, asset.id, null, 1, page1.next_cursor);
    
    assert_equals(
        page2,
        utils.paged_result(
            data = [
                (
                    type = "LOCK1",
                    amount = 100L
                ).to_gtv_pretty()       
            ],
            next_cursor = null
        )
    );
}

function test_locked_asset_balance_can_be_aggregated_for_specific_asset_when_locked_in_different_lock_accounts() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 7L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 3L).run();

    val balances = locking.get_locked_asset_aggregated_balance(alice.account, asset);
    assert_equals(balances, 10L);
}

function test_locked_asset_balance_can_be_aggregated_for_specific_asset_when_locked_in_different_lock_accounts_and_filtered_by_lock_account() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 7L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 3L).run();

    val balances = locking_ext.get_locked_asset_aggregated_balance(alice.account.id, asset.id, ["LOCK2"]);
    assert_equals(balances, 3L);
}

function test_lock_fails_when_insufficient_balance() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 7L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 5L)
        .run_must_fail("Balance is too low");
}

function test_lock_accounts_with_balance_only_can_be_fetched() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);

    test_utils.mint(alice.account, asset, 10L);

    val lock_accounts_with_balances1 = locking_ext.get_lock_accounts_with_non_zero_balances(alice.account.id);        
    assert_true(empty(lock_accounts_with_balances1));

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 1L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 2L).run();
    
    val lock_accounts_with_balances2 = locking_ext.get_lock_accounts_with_non_zero_balances(alice.account.id);
    assert_equals(
        lock_accounts_with_balances2,
        [
            (
                id = locking.get_lock_account_id(alice.account, "LOCK1"),
                type = "LOCK1"
            ),
            (
                id = locking.get_lock_account_id(alice.account, "LOCK2"),
                type = "LOCK2"
            )
        ]
    );
    
    op_locking.unlock_asset("LOCK2", alice.account.id, asset.id, 2L).run();

    val lock_accounts_with_balances3 = locking_ext.get_lock_accounts_with_non_zero_balances(alice.account.id);
    assert_equals(
        lock_accounts_with_balances3,
        [
            (
                id = locking.get_lock_account_id(alice.account, "LOCK1"),
                type = "LOCK1"
            )
        ]
    );

    op_locking.unlock_asset("LOCK1", alice.account.id, asset.id, 1L).run();

    val lock_accounts_with_balances4 = locking_ext.get_lock_accounts_with_non_zero_balances(alice.account.id);
    assert_true(empty(lock_accounts_with_balances4));
}
