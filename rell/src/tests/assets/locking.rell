function test_locked_asset_aggregated_balances_can_be_fetched_in_pages() {
    val alice = test_utils.register_alice();
    val asset1 = test_utils.create_asset("test1", "TST1", 0);
    val asset2 = test_utils.create_asset("test2", "TST2", 0);
    val asset3 = test_utils.create_asset("test3", "TST3", 0);
    
    test_utils.mint(alice.account, asset1, 10L);
    test_utils.mint(alice.account, asset2, 20L);
    test_utils.mint(alice.account, asset3, 30L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset3.id, 3L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset2.id, 2L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset1.id, 1L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset1.id, 9L).run();
    op_locking.lock_asset("LOCK3", alice.account.id, asset2.id, 18L).run();
    op_locking.lock_asset("LOCK3", alice.account.id, asset3.id, 27L).run();

    val page1 = locking_ext.get_locked_asset_aggregated_balances(alice.account.id, null, 1);
    assert_equals(
        page1.data,
        [
            (
                asset = assets.map_asset(asset1),
                amount = 10L
            ).to_gtv_pretty()
        ]
    );

    val page2 = locking_ext.get_locked_asset_aggregated_balances(alice.account.id, null, 2, page1.next_cursor);
    assert_equals(
        page2,
        utils.paged_result(
            data = [
                (
                    asset = assets.map_asset(asset2),
                    amount = 20L
                ).to_gtv_pretty(),
                (
                    asset = assets.map_asset(asset3),
                    amount = 30L
                ).to_gtv_pretty()
            ],
            next_cursor = null
        )
    );
}

function test_locked_asset_balance_can_be_fetched_for_specific_asset() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 3L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 4L).run();

    val balances = locking_ext.get_locked_asset_balance(alice.account.id, asset.id);
    assert_equals(
        balances.data,
        [
            (
                type = "LOCK1",
                amount = 3L
            ).to_gtv_pretty(),
            (
                type = "LOCK2",
                amount = 4L
            ).to_gtv_pretty()
        ]
    );
}

