@test
module;

import test_utils: ^.utils;
import op_locking: ^^.operations.locking;

import lib.ft4.utils;
import lib.ft4.admin;
import lib.ft4.assets;
import lib.ft4.assets.locking;
import lib.ft4.accounts.linking;
import assets_ext: lib.ft4.assets.external;
import locking_ext: lib.ft4.assets.locking.external;

function test_asset_is_locked() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 10L);

    op_locking.lock_asset("TYPE", alice.account.id, asset.id, 5L).run();
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 5L);
    
    val lock_account_id = locking.get_lock_account_id(alice.account, "TYPE");
    assert_equals(assets_ext.get_asset_balance(lock_account_id, asset.id)!!.amount, 5L);
}

function test_unlocking_assets_transfers_them_back_to_main_account() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);    
    
    test_utils.mint(alice.account, asset, 10L);
    
    val lock_account_id = locking.get_lock_account_id(alice.account, "STAKE");

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 10L);
    assert_true(empty(assets_ext.get_asset_balance(lock_account_id, asset.id)));

    op_locking.lock_asset("STAKE", alice.account.id, asset.id, 9L).run();

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 1L);
    assert_equals(assets_ext.get_asset_balance(lock_account_id, asset.id)!!.amount, 9L);

    op_locking.unlock_asset("STAKE", alice.account.id, asset.id, 5L).run();

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 6L);
    assert_equals(assets_ext.get_asset_balance(lock_account_id, asset.id)!!.amount, 4L);

    op_locking.unlock_asset("STAKE", alice.account.id, asset.id, 4L).run();

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 10L);
    assert_true(empty(assets_ext.get_asset_balance(lock_account_id, asset.id)));    
}

function test_locked_asset_balances_can_be_fetched_when_one_asset_locked() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 10L);

    assert_true(empty(locking_ext.get_locked_asset_balances(alice.account.id).data));

    op_locking.lock_asset("LISTING", alice.account.id, asset.id, 5L).run();

    val balances = locking_ext.get_locked_asset_balances(alice.account.id);
    assert_equals(
        balances.data,
        [
            (
                type = "LISTING",
                asset = (
                    id = asset.id,
                    name = "test",
                    symbol = "TST",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 5L
            ).to_gtv_pretty()
        ]
    );
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 5L);
}

function test_locked_asset_balance_increments_when_asset_consecutively_locked() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 5L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 3L).run();

    val balances = locking_ext.get_locked_asset_balances(alice.account.id);
    assert_equals(
        balances.data,
        [
            (
                type = "LOCK1",
                asset = (
                    id = asset.id,
                    name = "test",
                    symbol = "TST",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 8L
            ).to_gtv_pretty()
        ]
    );
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 2L);
}

function test_locked_asset_balances_can_be_fetched_when_one_asset_lock_to_two_different_lock_accounts() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 5L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 3L).run();

    val balances = locking_ext.get_locked_asset_balances(alice.account.id);
    assert_equals(
        balances.data,
        [
            (
                type = "LOCK1",
                asset = (
                    id = asset.id,
                    name = "test",
                    symbol = "TST",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 5L
            ).to_gtv_pretty(),
            (
                type = "LOCK2",
                asset = (
                    id = asset.id,
                    name = "test",
                    symbol = "TST",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 3L
            ).to_gtv_pretty()
        ]
    );
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset.id)!!.amount, 2L); 
}

function test_locked_asset_balances_can_be_fetched_when_two_assets_locked() {
    val alice = test_utils.register_alice();
    val asset1 = test_utils.create_asset("test1", "TST1", 0);
    val asset2 = test_utils.create_asset("test2", "TST2", 0);
    
    test_utils.mint(alice.account, asset1, 10L);
    test_utils.mint(alice.account, asset2, 20L);      

    op_locking.lock_asset("LOCK1", alice.account.id, asset1.id, 3L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset2.id, 2L).run();

    val balances = locking_ext.get_locked_asset_balances(alice.account.id);
    assert_equals(
        balances.data,
        [
            (
                type = "LOCK1",
                asset = (
                    id = asset1.id,
                    name = "test1",
                    symbol = "TST1",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 3L
            ).to_gtv_pretty(),
            (
                type = "LOCK1",
                asset = (
                    id = asset2.id,
                    name = "test2",
                    symbol = "TST2",
                    decimals = 0,
                    blockchain_rid = chain_context.blockchain_rid,
                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 20L
                ),
                amount = 2L
            ).to_gtv_pretty()
        ]
    );
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset1.id)!!.amount, 7L); 
    assert_equals(assets_ext.get_asset_balance(alice.account.id, asset2.id)!!.amount, 18L);         
}

function test_locked_asset_balances_can_be_filtered_by_lock_type() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 5L).run();
