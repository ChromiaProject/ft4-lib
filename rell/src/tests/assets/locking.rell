                    icon_url = "",
                    type = assets.ASSET_TYPE_FT4,
                    supply = 10L
                ),
                amount = 3L
            ).to_gtv_pretty()
        ]
    );
}

function test_locked_asset_balances_can_be_fetched_in_pages() {
    val alice = test_utils.register_alice();
    val asset1 = test_utils.create_asset("test1", "TST1", 0);
    val asset2 = test_utils.create_asset("test2", "TST2", 0);
    
    test_utils.mint(alice.account, asset1, 200L);
    test_utils.mint(alice.account, asset2, 300L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset1.id, 10L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset2.id, 30L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset1.id, 20L).run();    
    op_locking.lock_asset("LOCK2", alice.account.id, asset2.id, 40L).run();
    
    op_locking.lock_asset("LOCK2", alice.account.id, asset1.id, 50L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset2.id, 70L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset1.id, 60L).run();
    op_locking.lock_asset("LOCK1", alice.account.id, asset2.id, 80L).run();

    val page1 = locking_ext.get_locked_asset_balances(alice.account.id, null, 2);

    assert_equals(
        page1.data,
        [
            (
                type = "LOCK1",
                asset = assets.map_asset(asset1),
                amount = 30L
            ).to_gtv_pretty(),
            (
                type = "LOCK2",
                asset = assets.map_asset(asset2),
                amount = 70L
            ).to_gtv_pretty()
        ]
    );

    val page2 = locking_ext.get_locked_asset_balances(alice.account.id, null, 2, page1.next_cursor);

    assert_equals(
        page2,
        utils.paged_result(
            data = [
                (
                    type = "LOCK2",
                    asset = assets.map_asset(asset1),
                    amount = 110L
                ).to_gtv_pretty(),
                (
                    type = "LOCK1",
                    asset = assets.map_asset(asset2),
                    amount = 150L
                ).to_gtv_pretty()
            ],
            next_cursor = null
        )
    );
}

function test_locked_asset_balances_can_be_aggregated_by_asset() {
    val alice = test_utils.register_alice();
    val asset = test_utils.create_asset("test", "TST", 0);
    
    test_utils.mint(alice.account, asset, 10L);

    op_locking.lock_asset("LOCK1", alice.account.id, asset.id, 3L).run();
    op_locking.lock_asset("LOCK2", alice.account.id, asset.id, 2L).run();

    val balances = locking_ext.get_locked_asset_aggregated_balances(alice.account.id);
    assert_equals(
        balances.data,
        [
            (
                asset = assets.map_asset(asset),
                amount = 5L
            ).to_gtv_pretty()
