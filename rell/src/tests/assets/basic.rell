@test module;

import ^.utils;
import acc: ^^^.lib.ft4.accounts;
import ^^^.lib.ft4.assets;
import ^^^.lib.ft4.admin;

val alice = rell.test.keypairs.alice;
val bob = rell.test.keypairs.bob;

function test_an_account_can_be_created() {
  val auth_descriptor = utils.create_auth_descriptor(alice.pub);
  
  utils.create_test_account(alice);
  
  assert_not_null(acc.account @? { auth_descriptor.hash() });
}

function test_multi_sig_auth_descriptor_can_be_added() {
  val auth_descriptor = acc.auth_descriptor(
    acc.auth_type.M,
    [
        ["T"].to_gtv(),
        0x2.to_gtv(),
        [
          alice.pub.to_hex(),
          bob.pub.to_hex()
        ].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_multi_sig([alice, bob], auth_descriptor);

  assert_not_null(acc.account_auth_descriptor @? { .id == auth_descriptor.hash() });
}

function test_an_invalid_descriptor_can_not_be_added() {
  val auth_descriptor = acc.auth_descriptor(
    acc.auth_type.M,
    [
        ["T"].to_gtv(),
        alice.pub.to_hex().to_gtv(),
        bob.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );

  assert_fails(
    "Operation 'lib.ft4.admin:register_account' failed",
    utils._create_test_acc_from_auth_desc_multi_sig([alice, bob], auth_descriptor, *)
  );
}

function test_an_asset_can_be_created() {
  utils.create_asset("a", "a", 0);
  utils.create_asset("b", "b", 1);
  utils.create_asset("c", "c", 50);
  utils.create_asset("d", "d", 78);
}

function test_an_invalid_asset_cannot_be_created() {
  val error = "Decimals must be between 0 and 78 (included)";
  admin.register_asset("e", "e", -1, "")
    .sign(utils.admin_priv_key())
    .run_must_fail(error);
  admin.register_asset("f", "f", 79, "")
    .sign(utils.admin_priv_key())
    .run_must_fail(error);
}

function test_asset_amounts_are_correctly_formatted() {
  assert_equals(assets.format_amount_with_decimals(1L, 0), "1");
  assert_equals(assets.format_amount_with_decimals(10L, 0), "10");
  assert_equals(assets.format_amount_with_decimals(100000000L, 0), "100000000");
  assert_equals(assets.format_amount_with_decimals(1L, 1), "0.1");
  assert_equals(assets.format_amount_with_decimals(10L, 1), "1.0");
  assert_equals(assets.format_amount_with_decimals(100000000L, 1), "10000000.0");
  assert_equals(assets.format_amount_with_decimals(1L, 6), "0.000001");
  assert_equals(assets.format_amount_with_decimals(10L, 6), "0.000010");
  assert_equals(assets.format_amount_with_decimals(100000000L, 6), "100.000000");
}