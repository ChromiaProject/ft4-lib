@test
module;

import lib.ft4.auth;
import lib.ft4.assets;
import lib.ft4.accounts;
import lib.ft4.test.utils. { evm_sign };

import test_utils: lib.ft4.test.utils;
import ^^.extensions.*;
import ^.utils;
import test_ops: ^^.operations;

val too_big = assets.max_asset_amount + 1;

function test_before_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 1);

    utils.mint(alice.account, asset, 1);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(assets.external.transfer(bob.account.id, asset.id, 1L))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_before_transfer_called);
    assert_equals(transfer_extensions_state.before_transfer_from, alice.account.id);
    assert_equals(transfer_extensions_state.before_transfer_to, bob.account.id);
    assert_equals(transfer_extensions_state.before_transfer_asset, asset.id);
    assert_equals(transfer_extensions_state.before_transfer_amount, 1L);
}

function test_after_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 1);

    utils.mint(alice.account, asset, 1);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(assets.external.transfer(bob.account.id, asset.id, 1L))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_after_transfer_called);
    assert_equals(transfer_extensions_state.after_transfer_from, alice.account.id);
    assert_equals(transfer_extensions_state.after_transfer_to, bob.account.id);
    assert_equals(transfer_extensions_state.after_transfer_asset, asset.id);
    assert_equals(transfer_extensions_state.after_transfer_amount, 1L);
}

function test_correct_auth_message_is_used() {
    val asset = utils.create_asset("test", "TEST", 1);
    val args = struct<assets.external.transfer>(
        receiver_id=x"abcd",
        asset_id=asset.id,
        10L
    );
    val expected_msg = "Please sign the message\nto transfer 1.0 test\n(id: %s)\n\nfrom:\n{account_id}\n\nto:\n0xabcd".format(asset.id);
    assert_equals(assets.external.transfer_message(args.to_gtv()), expected_msg);
}

function test_transfer_fails_when_insufficient_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(test_utils.ft_auth_operation_for(alice.keypair.pub))
        .op(assets.external.transfer(bob.account.id, asset.id, 11))
        .sign(alice.keypair)
        .run_must_fail("Balance is too low");
}

function test_transfer_fails_when_amount_is_negative() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(bob.account.id, asset.id, -1))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %d".format(-1));
}

function test_transfer_fails_when_amount_is_too_high() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);

    val tx = rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(bob.account.id, asset.id, too_big))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be lower than 2^256, actual: %d".format(too_big));
}

function test_transfer_fails_when_sender_is_same_as_receiver() {
    val alice = utils.register_alice();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(alice.account.id, asset.id, 5))
        .sign(alice.keypair)
        .run_must_fail("Sender and receiver have to be different");
}

function test_transfer_succeeds_when_more_than_enough_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(bob.account.id, asset.id, 3))
        .sign(alice.keypair)
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset), 7);
    assert_equals(assets.get_asset_balance(bob.account, asset), 3);
}

function test_transfer_when_just_enough_balance_will_delete_balance_entity() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(bob.account.id, asset.id, 10))
        .sign(alice.keypair)
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset), 0);
    assert_null(assets.balance @? { alice.account, asset });
    assert_equals(assets.get_asset_balance(bob.account, asset), 10);
}

function test_transfer_fails_when_auth_descriptor_does_not_have_transfer_flag() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val auth_descriptor = accounts.single_sig_auth_descriptor(rell.test.keypairs.alice.pub, set(list<text>()));
    test_ops.add_ad_to_account(alice.account, auth_descriptor).run();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, auth_descriptor.hash()))
        .op(assets.external.transfer(bob.account.id, asset.id, 1))
        .sign(alice.keypair)
        .run_must_fail("Some required flags [T] are missing on the (single sig) Auth Descriptor.");
}

function test_evm_authenticated_transfer_succeeds_when_enough_balance() {
    val alice = utils.evm_register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 15);

    val receiver_id = bob.account.id;
    val asset_id = asset.id;
    val amount = 5L;

    val template = auth.external.get_auth_message_template(
        "ft4.transfer", 
        [
            receiver_id.to_gtv(), 
            asset_id.to_gtv(), 
            amount.to_gtv()
        ].to_gtv()
    );
    val op = assets.external.transfer(bob.account.id, asset.id, 5);
    val message = utils.create_evm_auth_message(op, template, alice);
    val signature = evm_sign(message, alice.keypair.priv);

    rell.test.tx()
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .op(op)
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset), 10);
    assert_equals(assets.get_asset_balance(bob.account, asset), 5);
}

function test_evm_authenticated_transfer_fails_when_signature_is_not_created_by_sender() {
    val alice = utils.evm_register_alice();
    val bob = utils.evm_register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 15);

    val receiver_id = bob.account.id;
    val asset_id = asset.id;
    val amount = 10L;

    val template = auth.external.get_auth_message_template(
        "ft4.transfer", 
        [
            receiver_id.to_gtv(), 
            asset_id.to_gtv(), 
            amount.to_gtv()
        ].to_gtv()
    );
    val op = assets.external.transfer(receiver_id, asset_id, amount);
    val message = utils.create_evm_auth_message(op, template, alice);
    val invalid_signature = evm_sign(message, bob.keypair.priv);

    rell.test.tx()
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [invalid_signature]))
        .op(op)
        .run_must_fail("Invalid signature");
}

function test_transfer_fails_when_recipient_id_does_not_exists_and_create_on_transfer_strategy_is_not_enabled() {
    val alice = utils.register_alice();
    val bogus_recipient_id = "bogus".hash();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(bogus_recipient_id, asset.id, 1))
        .sign(alice.keypair)
        .run_must_fail("Account <%s> does not exist and creating accounts on transfer is not enabled".format(bogus_recipient_id));
}
