@test
module;

import ^^^.lib.ft4.auth;
import ^^^.main.*;
import ^^.extensions.*;
import ^^^.lib.ft4.assets;
import ^^^.lib.ft4.ft4_basic_dev.*;
import ^^^.lib.ft4.auth;
import ^.utils;

val too_big = assets.max_asset_amount + 1;

function test_before_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 1);

    utils.mint(alice.account, asset, 1);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 1L))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_before_transfer_called);
    assert_equals(transfer_extensions_state.before_transfer_from, alice.account.id);
    assert_equals(transfer_extensions_state.before_transfer_to, bob.account.id);
    assert_equals(transfer_extensions_state.before_transfer_asset, asset.id);
    assert_equals(transfer_extensions_state.before_transfer_amount, 1L);
}

function test_after_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 1);

    utils.mint(alice.account, asset, 1);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 1L))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_after_transfer_called);
    assert_equals(transfer_extensions_state.after_transfer_from, alice.account.id);
    assert_equals(transfer_extensions_state.after_transfer_to, bob.account.id);
    assert_equals(transfer_extensions_state.after_transfer_asset, asset.id);
    assert_equals(transfer_extensions_state.after_transfer_amount, 1L);
}

function test_correct_auth_message_is_used() {
    val asset = utils.create_asset("test", "TEST", 1);
    val args = struct<ft4.assets_ext.transfer>(
        receiver_id=x"abcd",
        asset_id=asset.id,
        10L
    );
    val expected_msg = "Please sign the message\nto transfer 1.0 test\n(id: %s)\n\nfrom:\n{account_id}\n\nto:\n0xabcd\n\nNonce: {nonce}".format(asset.id);
    assert_equals(ft4.assets_ext.transfer_message(args.to_gtv()), expected_msg);
}

function test_transfer_fails_when_insufficient_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 11))
        .sign(alice.keypair)
        .run_must_fail("Balance is too low");
}

function test_transfer_fails_when_amount_is_negative() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, -1))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %d".format(-1));
}

function test_transfer_fails_when_amount_is_too_high() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);

    val tx = rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, too_big))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be lower than 2^256, actual: %d".format(too_big));
}

function test_transfer_fails_when_sender_is_same_as_receiver() {
    val alice = utils.register_alice();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(alice.account.id, asset.id, 5))
        .sign(alice.keypair)
        .run_must_fail("Sender and receiver have to be different");
}

function test_transfer_succeeds_when_enough_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 3))
        .sign(alice.keypair)
        .run();

    assert_equals(assets.ensure_balance(alice.account, asset).amount, 7);
    assert_equals(assets.ensure_balance(bob.account, asset).amount, 3);
}

function test_transfer_fails_when_auth_descriptor_does_not_have_transfer_flag() {
    val auth_descriptor = ft4.acc.single_sig_auth_descriptor(rell.test.keypairs.alice.pub, set(["A"]));
    val alice = utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.alice, auth_descriptor);
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 1))
        .sign(alice.keypair)
        .run_must_fail("Some required flags [T] are missing on the (single sig) Auth Descriptor.");
}

function test_evm_authenticated_transfer_succeeds_when_enough_balance() {
    val alice = utils.evm_register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 15);

    val receiver_id = bob.account.id;
    val asset_id = asset.id;
    val amount = 5L;

    val template = auth.get_auth_message_template(
        "ft4.transfer", 
        [
            receiver_id.to_gtv(), 
            asset_id.to_gtv(), 
            amount.to_gtv()
        ].to_gtv(),
        is_strict = true
    );
    val message = utils.create_auth_message(template, alice);
    val signature = utils.metamask_sign(message, alice.keypair.priv);

    rell.test.tx()
        .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .op(ft4.assets_ext.transfer(bob.account.id, asset.id, 5))
        .run();

    assert_equals(assets.ensure_balance(alice.account, asset).amount, 10);
    assert_equals(assets.ensure_balance(bob.account, asset).amount, 5);
}

function test_evm_authenticated_transfer_fails_when_signature_is_not_created_by_sender() {
    val alice = utils.evm_register_alice();
    val bob = utils.evm_register_bob();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 15);

    val receiver_id = bob.account.id;
    val asset_id = asset.id;
    val amount = 10L;

    val template = auth.get_auth_message_template(
        "ft4.transfer", 
        [
            receiver_id.to_gtv(), 
            asset_id.to_gtv(), 
            amount.to_gtv()
        ].to_gtv(),
        true
    );
    val message = utils.create_auth_message(template, alice);
    val invalid_signature = utils.metamask_sign(message, bob.keypair.priv);

    rell.test.tx()
        .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [invalid_signature]))
        .op(ft4.assets_ext.transfer(receiver_id, asset_id, amount))
        .run_must_fail("Invalid signature");
}