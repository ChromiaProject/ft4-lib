@test module;

import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import acc: ^^^.lib.ft4.accounts;
import auth_ext: ^^^.lib.ft4.auth.external;
import ^^^.lib.ft4.assets;
import ^^^.lib.ft4.admin;
import ^^.operations;

struct module_args {
    admin_priv_key: byte_array;
}

import ^^^.lib.ft4.auth;

struct account_data {
    ft_auth: () -> rell.test.op;
    acc.account;
    auth_descriptor_id: byte_array;
    rell.test.keypair;
}

function register_alice() = create_test_account(rell.test.keypairs.alice);

function register_bob() = create_test_account(rell.test.keypairs.bob);

function register_eve() = create_test_account(rell.test.keypairs.eve);

function register_trudy() = create_test_account(rell.test.keypairs.trudy);

function evm_register_alice(flags: list<text> = ["T"]) = create_evm_auth_test_account(rell.test.keypairs.alice, flags);

function evm_register_bob(flags: list<text> = ["T"]) = create_evm_auth_test_account(rell.test.keypairs.bob, flags);

function create_test_account(rell.test.keypair, permissions: list<text> = ["T"]): account_data {
    val auth_descriptor = create_auth_descriptor(keypair.pub, permissions);
    val auth_descriptor_id = auth_descriptor.hash();

    create_test_account_with_auth_descriptor(auth_descriptor, keypair);
    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor_id
    } ( .account );

    return account_data(
        account = account,
        auth_descriptor_id = auth_descriptor_id,
        ft_auth = auth_ext.ft_auth(account.id, auth_descriptor_id, *),
        keypair = keypair
    );
}

function admin_priv_key() = chain_context.args.admin_priv_key;

function create_test_account_with_auth_descriptor(
    acc.auth_descriptor,
    user_keypair: rell.test.keypair
) {
    rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards
    admin.register_account(auth_descriptor)
        .sign(chain_context.args.admin_priv_key)
        .sign(user_keypair)
        .run();
}

function create_evm_auth_test_account(rell.test.keypair, flags: list<text> = ["T"]): account_data {
    val address = crypto.eth_privkey_to_address(keypair.priv);
    val auth_descriptor = create_auth_descriptor(address, flags);
    val auth_descriptor_id = auth_descriptor.hash();

    rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards
    operations.register_account_test(auth_descriptor)
        .sign(keypair)
        .run();

    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor_id
    } ( .account );

    return account_data(
        account = account,
        auth_descriptor_id = auth_descriptor_id,
        ft_auth = auth_ext.ft_auth(account.id, auth_descriptor_id, *),
        keypair = keypair
    );
}

function create_auth_descriptor(
    signer: byte_array,
    permissions: list<text> = ["T"],
    rules: gtv = null.to_gtv()
): acc.auth_descriptor {
    return acc.auth_descriptor(
            acc.auth_type.S,
            [
                set(permissions).to_gtv(),
                signer.to_hex().to_gtv()
            ],
            rules
        );
}

function create_asset(name: text, symbol: text, decimals: integer, icon_url: text = "") {
    admin.register_asset(
            name,
            symbol,
            decimals,
            icon_url
        )
        .sign(chain_context.args.admin_priv_key)
        .run();

    return assets.asset @ { .id == (name, chain_context.blockchain_rid).hash() };
}

function create_crosschain_asset(
    name,
    symbol: text,
    decimals: integer,
    issuing_blockchain_rid: byte_array,
    icon_url: text,
    origin_blockchain_rid: byte_array
) {
    admin_crosschain.register_crosschain_asset(
            name,
            symbol,
            decimals,
            issuing_blockchain_rid,
            icon_url,
            origin_blockchain_rid
        )
        .sign(chain_context.args.admin_priv_key)
        .run();

    return assets.asset @ { .id == (name, issuing_blockchain_rid).hash() };
}

function mint(acc.account, assets.asset, amount: big_integer) {
    admin.mint(
            account.id,
            asset.id,
            amount
        )
        .sign(chain_context.args.admin_priv_key)
        .run();
}

function create_asset_tx(name: text, symbol: text, decimals: integer): rell.test.tx {
    return admin.register_asset(
            name,
            symbol,
            decimals,
            icon_url = ""
        )
        .sign(rell.test.keypairs.alice);
}

/*
 * Creates a single sig Auth Desc.
 * 
 * returns "account_data"
 */
function _create_test_acc_from_auth_desc_single_sig(rell.test.keypair, acc.auth_descriptor): account_data {
    rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards
    admin.register_account(auth_descriptor)
        .sign(chain_context.args.admin_priv_key)
        .sign(keypair)
        .run();

    val auth_descriptor_id = auth_descriptor.hash();
    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor_id
    } .account;

    return account_data(
        account,
        auth_descriptor_id,
        ft_auth = auth_ext.ft_auth(account.id, auth_descriptor_id, *),
        keypair = keypair
    );
}

/*
 * Creates a multi sig Auth Desc.
 * 
 * returns "account_data"
 */
function _create_test_acc_from_auth_desc_multi_sig(keys: list<rell.test.keypair>, acc.auth_descriptor): account_data {
    rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards
    val op = admin.register_account(auth_descriptor);
    val admin_keypair = rell.test.keypair(
            priv=chain_context.args.admin_priv_key,
            pub=crypto.privkey_to_pubkey(chain_context.args.admin_priv_key, true)
        );
    keys.add(admin_keypair);
    var tx = _sign_many(op, keys);
    tx.run();

    val auth_descriptor_id = auth_descriptor.hash();
    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor_id
    } .account;

    return account_data(
        account,
        auth_descriptor_id,
        ft_auth = auth_ext.ft_auth(account.id, auth_descriptor_id, *),
        keypair = keys[0] // Doesn't matter much which we use
    );
}

function _sign_many(op: rell.test.op, keys: list<rell.test.keypair>) {
    val tx = rell.test.tx(op);
    keys @* { } ( tx.sign($) );
    return tx;
}

function add_auth_op(rell.test.tx, message: text) {
    return tx
        .op(operations.test_auth.test_authenticated_operation());
}

function perform_large_transfer(rell.test.tx, amount: integer, to_address: text) {
    return tx
        .op(operations.test_auth.test_perform_large_transfer(1000, to_address));
}

function mint_to_account(account_data, assets.asset, amount: big_integer) {
    admin.mint(account_data.account.id, asset.id, amount)
        .sign(admin_priv_key())
        .run();
}

function create_auth_message(template: text, account_data) {
    val nonce = acc.account_auth_descriptor @ {
        account_data.account,
        .id == account_data.auth_descriptor_id
    }.ctr;

    return template
        .replace("{account_id}", account_data.account.id.to_hex())
        .replace("{auth_descriptor_id}", account_data.auth_descriptor_id.to_hex())
        .replace("{brid}", chain_context.blockchain_rid.to_hex())
        .replace("{nonce}", nonce.to_text());
}

function evm_sign(hash: byte_array, privkey: byte_array) {
    val (r, s, rec_id) = crypto.eth_sign(hash, privkey);
    return auth.signature(
            r = r,
            s = s,
            v = 27 + rec_id
        );
}

function evm_hex_address_from_pubkey(evm_pubkey: byte_array) = "0x" + crypto.eth_pubkey_to_address(evm_pubkey).to_hex();
