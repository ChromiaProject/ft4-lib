function test_get_paginated_crosschain_transfer_history_entries_filtered_by_op_index_and_transaction_rids() {
    val crosschain_transfer_history_entry = common_helpers.mock_crosschain_transfer();
    val fetched_crosschain_transfer_history_entries = assets.external.get_crosschain_transfer_history_entries_filtered(
        helpers.set_crosschain_transfer_history_entry_filter(
            op_index = crosschain_transfer_history_entry.op_index,
            transaction_rids = [crosschain_transfer_history_entry.transaction.tx_rid]
        ),
        1,
        null
    );
    assert_equals(fetched_crosschain_transfer_history_entries, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_crosschain_transfer_history_entry_assertion(crosschain_transfer_history_entry).to_gtv_pretty()]
    ));
}

