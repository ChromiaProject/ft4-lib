}

function test_get_paginated_crosschain_transfer_history_entries_filtered_by_multiple_account_ids() {
    val alice = test.register_alice();
    val eve = test.register_eve();
    val crosschain_transfer_history_entry_one = common_helpers.mock_crosschain_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = eve.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val crosschain_transfer_history_entry_two = common_helpers.mock_crosschain_transfer(
        "test_asset_2",
        "TEST_SYMBOL_2",
        sender_account_id = alice.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id,
        recipient_account_id = eve.account.id
    );
    val fetched_crosschain_transfer_history_entries = assets.external.get_crosschain_transfer_history_entries_filtered(
        helpers.set_crosschain_transfer_history_entry_filter(
            account_ids = [
                crosschain_transfer_history_entry_one.account_id,
                crosschain_transfer_history_entry_two.account_id
            ]
        ),
        2,
        null
    );
    assert_equals(fetched_crosschain_transfer_history_entries, utils.paged_result(
        next_cursor = null,
        data = [
            mocks.format_expected_crosschain_transfer_history_entry_assertion(crosschain_transfer_history_entry_one).to_gtv_pretty(),
            mocks.format_expected_crosschain_transfer_history_entry_assertion(crosschain_transfer_history_entry_two).to_gtv_pretty()
        ]
    ));
}

