    assert_fails(
        "INVALID FILTER: Composite index (transaction_rids, op_index) - transaction_rids filter cannot be empty",
        assets.external.get_crosschain_transfer_history_entries_filtered(
            helpers.set_crosschain_transfer_history_entry_filter(
                op_index = crosschain_transfer_history_entry.op_index
            ),
            1,
            null, *
        )
    );
}

function test_get_crosschain_transfer_history_entries_filtered_requires_op_index_composite_index() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val crosschain_transfer_history_entry = common_helpers.mock_crosschain_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    assert_fails(
        "INVALID FILTER: Composite index (transaction_rids, op_index) - op_index filter is required",
        assets.external.get_crosschain_transfer_history_entries_filtered(
            helpers.set_crosschain_transfer_history_entry_filter(
                transaction_rids = [crosschain_transfer_history_entry.transaction.tx_rid]
            ),
            1,
            null, *
        )
    );
}

function test_get_paginated_crosschain_transfer_history_entries_filtered_by_op_index_and_transaction_rids() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val crosschain_transfer_history_entry = common_helpers.mock_crosschain_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val fetched_crosschain_transfer_history_entries = assets.external.get_crosschain_transfer_history_entries_filtered(
        helpers.set_crosschain_transfer_history_entry_filter(
            op_index = crosschain_transfer_history_entry.op_index,
            transaction_rids = [crosschain_transfer_history_entry.transaction.tx_rid]
        ),
        1,
        null
    );
    assert_equals(fetched_crosschain_transfer_history_entries, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_crosschain_transfer_history_entry_assertion(crosschain_transfer_history_entry).to_gtv_pretty()]
    ));
}

function test_get_paginated_crosschain_transfer_history_entries_using_all_filter_no_crosschain_transfer_history_entries() {
