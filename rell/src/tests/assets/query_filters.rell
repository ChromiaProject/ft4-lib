@test module;

import test: lib.ft4.test.core;
import lib.ft4.assets;
import lib.ft4.utils;
import ^.helpers;
import ^.mocks;
import common_helpers: ^^.common.helpers;

function test_get_paginated_assets_without_filter_no_assets() {
    val fetched_assets = assets.external.get_assets_filtered(null, 1, null);
    assert_equals(fetched_assets, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_paginated_assets_without_filter() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val asset = minted_assets[0];

    val fetched_assets = assets.external.get_assets_filtered(null, 1, null);
    assert_equals(fetched_assets, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_assertion(asset).to_gtv_pretty()]
    ));
}

function test_get_paginated_assets_filtered_by_single_asset_id() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val asset = minted_assets[0];

    val fetched_assets = assets.external.get_assets_filtered(
        helpers.set_asset_filter(
            ids = [asset.id]
        ),
        1,
        null
    );
    assert_equals(fetched_assets, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_assertion(asset).to_gtv_pretty()]
    ));
}

