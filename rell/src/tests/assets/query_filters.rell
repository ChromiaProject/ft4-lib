function test_get_paginated_balances_filtered_by_single_account_id() {
    val (alice, minted_assets) = helpers.register_account_create_and_mint_assets();
    val balance = helpers.get_last_balance();

    val fetched_balances = assets.external.get_balances_filtered(
        helpers.set_balance_filter(
            account_ids = [alice.account.id]
        ),
        1,
        null
    );

    assert_equals(fetched_balances, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_balance_assertion(balance).to_gtv_pretty()]
    ));
}

function test_get_paginated_balances_filtered_by_multiple_account_ids() {
    val (alice, minted_assets) = helpers.register_account_create_and_mint_assets();
    val alice_balance = helpers.get_last_balance();

    val bob = test.register_bob();
    admin.external.mint(bob.account.id, minted_assets[0].id, 10L)
        .sign(test.admin_priv_key())
        .run();
    val bob_balance = helpers.get_last_balance();

    val fetched_balances = assets.external.get_balances_filtered(
        helpers.set_balance_filter(
            account_ids = [alice.account.id, bob.account.id]
        ),
        2,
        null
    );

    assert_equals(fetched_balances, utils.paged_result(
        next_cursor = null,
        data = [
            mocks.format_expected_balance_assertion(alice_balance).to_gtv_pretty(),
            mocks.format_expected_balance_assertion(bob_balance).to_gtv_pretty()
        ]
    ));
}

