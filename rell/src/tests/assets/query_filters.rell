function test_get_paginated_crosschain_transfer_history_entries_without_filter_no_crosschain_transfer_history_entries() {
    val fetched_crosschain_transfer_history_entries = assets.external.get_crosschain_transfer_history_entries_filtered(null, 1, null);
    assert_equals(fetched_crosschain_transfer_history_entries, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_paginated_crosschain_transfer_history_entries_without_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val crosschain_transfer_history_entry = common_helpers.mock_crosschain_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val fetched_crosschain_transfer_history_entries = assets.external.get_crosschain_transfer_history_entries_filtered(null, 1, null);
    assert_equals(fetched_crosschain_transfer_history_entries, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_crosschain_transfer_history_entry_assertion(crosschain_transfer_history_entry).to_gtv_pretty()]
    ));
}

function test_get_paginated_crosschain_transfer_history_entries_filtered_by_single_account_id() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val crosschain_transfer_history_entry = common_helpers.mock_crosschain_transfer(
