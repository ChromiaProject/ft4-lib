function test_get_transfer_history_entries_filtered_requires_transaction_rids_composite_index() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val transfer_history_entry = common_helpers.get_last_transfer_history_entry();
    assert_fails(
        "INVALID FILTER: Composite index (transaction_rids, op_index) - transaction_rids filter cannot be empty",
        assets.external.get_transfer_history_entries_filtered(
            helpers.set_transfer_history_entry_filter(
                op_index = transfer_history_entry.op_index
            ),
            1,
            null, *
        )
    );
}

function test_get_transfer_history_entries_filtered_requires_op_index_composite_index() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val transfer_history_entry = common_helpers.get_last_transfer_history_entry();
    assert_fails(
        "INVALID FILTER: Composite index (transaction_rids, op_index) - op_index filter is required",
        assets.external.get_transfer_history_entries_filtered(
            helpers.set_transfer_history_entry_filter(
                transaction_rids = [transfer_history_entry.transaction.tx_rid]
            ),
            1,
            null, *
        )
    );
}

function test_get_paginated_transfer_history_entries_without_filter() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val transfer_history_entry = common_helpers.get_last_transfer_history_entry();

    val fetched_transfer_history_entries = assets.external.get_transfer_history_entries_filtered(
        helpers.set_transfer_history_entry_filter(),
        1,
        null
