function test_get_paginated_balances_filtered_by_multiple_asset_ids() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets(2);
    val balances = assets.balance @* {} (@omit @sort_desc .rowid, $) limit 2;

    val fetched_balances = assets.external.get_balances_filtered(
        helpers.set_balance_filter(
            asset_ids = [minted_assets[0].id, minted_assets[1].id]
        ),
        2,
        null
    );

    assert_equals(fetched_balances, utils.paged_result(
        next_cursor = null,
        data = [
            mocks.format_expected_balance_assertion(balances[1]).to_gtv_pretty(),
            mocks.format_expected_balance_assertion(balances[0]).to_gtv_pretty()
        ]
    ));
}

