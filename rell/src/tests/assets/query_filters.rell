function test_get_paginated_assets_using_all_filters_no_assets() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets();
    val assets = assets.external.get_assets(
        helpers.set_asset_filters(
            [rowid(1)],
            x"0000",
            "unknown",
            "UNKNOWN",
            "UNKNOWN"
        ),
        1,
        null
    );
    assert_equals(assets, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_paginated_assets_using_all_filters() {
    val (_, minted_assets) = helpers.register_account_create_and_mint_assets(2);
    val (asset1, asset2) = (minted_assets[0], minted_assets[1]);

    val fetched_assets = assets.external.get_assets(
        helpers.set_asset_filters(
            rowids = [asset1.rowid, asset2.rowid],
            id = asset1.id,
            name = asset1.name,
            symbol = asset1.symbol,
            type = asset1.type
        ),
        1,
        null
    );
    assert_equals(fetched_assets, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_assertion(asset1).to_gtv_pretty()]
    ));
}

