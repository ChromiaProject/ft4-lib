@test
module;
import ^^^.main.*;
import ^^.extensions.*;
import ^^^.lib.ft4.ft4_basic_dev.*;
import ^^^.lib.ft4.admin;
import ^^^.lib.ft4.auth;
import ^^^.lib.ft4.assets;
import ft4_utils: ^^^.lib.ft4.utils;
import ^.utils;

val too_big = assets.max_asset_amount + 1;

function test_mint() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();
    
    assert_equals(asset.total_supply, 10L);
    assert_equals(assets.balance @ { .account == alice.account, .asset == asset }.amount, 10L);
}

function test_burn() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();
    
    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, 10L))
        .sign(alice.keypair)
        .run();

    assert_equals(asset.total_supply, 0);
    assert_equals(assets.balance @ { .account == alice.account, .asset == asset }.amount, 0L);
}

function test_mint_fails_if_amount_is_too_high() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, too_big)
        .sign(utils.admin_priv_key())
        .run_must_fail("Parameter amount: value must be lower than 2^256, actual: %d".format(too_big));
}

function test_mint_fails_if_amount_is_too_low() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 0)
        .sign(utils.admin_priv_key())
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %d".format(0));
}

function test_mint_fails_if_supply_is_too_high() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, too_big-1)
        .sign(utils.admin_priv_key())
        .run();
    admin.mint(alice.account.id, asset.id, 1)
        .sign(utils.admin_priv_key())
        .run_must_fail("End total supply must be lower than 2^256");
}

function test_burn_fails_if_amount_is_too_high() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, too_big))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be lower than 2^256, actual: %d".format(too_big));
}

function test_burn_fails_if_amount_is_too_low() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, 0))
        .sign(alice.keypair)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %d".format(0));
}

function test_burn_fails_if_balance_is_too_low() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 1)
        .sign(utils.admin_priv_key())
        .run();
    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, 2))
        .sign(alice.keypair)
        .run_must_fail("Insufficient balance");
}

function test_before_mint_extensions_are_called() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();
    
    assert_true(mint_extensions_state.is_before_mint_called);
    assert_equals(mint_extensions_state.before_mint_arg_asset_id, asset.id);
    assert_equals(mint_extensions_state.before_mint_arg_account_id, alice.account.id);
    assert_equals(mint_extensions_state.before_mint_arg_amount, 10);
}

function test_after_mint_extensions_are_called() {
    val alice = utils.create_test_account(rell.test.keypairs.alice);
    val asset = utils.create_asset("test", "TST", 0);
    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();
    
    assert_true(mint_extensions_state.is_after_mint_called);
    assert_equals(mint_extensions_state.after_mint_arg_asset_id, asset.id);
    assert_equals(mint_extensions_state.after_mint_arg_account_id, alice.account.id);
    assert_equals(mint_extensions_state.after_mint_arg_amount, 10L);
}

function test_before_burn_extensions_are_called() {
    val alice = utils.register_alice();
    val asset = utils.create_asset("test", "TST", 0);
    
    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();
    
    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, 10L))
        .sign(alice.keypair)
        .run();

    assert_true(burn_extensions_state.is_before_burn_called);
    assert_equals(burn_extensions_state.before_burn_arg_asset_id, asset.id);
    assert_equals(burn_extensions_state.before_burn_arg_account_id, alice.account.id);
    assert_equals(burn_extensions_state.before_burn_arg_amount, 10);
}

function test_after_burn_extensions_are_called() {
    val alice = utils.create_test_account(rell.test.keypairs.alice);
    val asset = utils.create_asset("test", "TST", 0);

    admin.mint(alice.account.id, asset.id, 10L)
        .sign(utils.admin_priv_key())
        .run();

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.burn(asset.id, 10L))
        .sign(alice.keypair)
        .run();
    
    assert_true(burn_extensions_state.is_after_burn_called);
    assert_equals(burn_extensions_state.after_burn_arg_asset_id, asset.id);
    assert_equals(burn_extensions_state.after_burn_arg_account_id, alice.account.id);
    assert_equals(burn_extensions_state.after_burn_arg_amount, 10L);
}

function test_register_asset_with_invalid_icon_url() {
    val invalid_icon_url = "invalidurl";

    admin.register_asset("test", "TST", 0, invalid_icon_url)
        .sign(utils.admin_priv_key())
        .run_must_fail("Invalid URL for icon");
}

function test_register_asset_with_valid_icon_url() {
    val valid_icon_url = "https://example.com/icon.png";

    admin.register_asset("test", "TST", 0, valid_icon_url)
        .sign(utils.admin_priv_key())
        .run();

    val asset = assets.asset @ { .id == ("test", chain_context.blockchain_rid).hash() };
    assert_equals(asset.icon_url, valid_icon_url);
}

function test_register_asset_with_empty_icon_url() {
    admin.register_asset("test", "TST", 0, "")
        .sign(utils.admin_priv_key())
        .run();

    val asset = assets.asset @ { .id == ("test", chain_context.blockchain_rid).hash() };
    assert_equals(asset.icon_url, "");
}

function test_register_asset_with_ipfs_icon_url() {
    val ipfs_icon_url = "ipfs://example/ipfs/QmTtqW4D6dbnar8UX2sbgHNszxzKN7xX1gJGU1MzCX1TvY";

    admin.register_asset("test", "TST", 0, ipfs_icon_url)
        .sign(utils.admin_priv_key())
        .run();

    val asset = assets.asset @ { .id == ("test", chain_context.blockchain_rid).hash() };
    assert_equals(asset.icon_url, ipfs_icon_url);
}

function test_register_asset_with_long_icon_url() {
    val long_icon_url = "a".repeat(2049);

    admin.register_asset("test", "TST", 0, long_icon_url)
        .sign(utils.admin_priv_key())
        .run_must_fail("Invalid URL for icon");
}

function test_register_asset_with_trimmed_icon_url() {
    val icon_url_with_spaces = "   https://example.com/icon.png   ";

    admin.register_asset("test", "TST", 0, icon_url_with_spaces)
        .sign(utils.admin_priv_key())
        .run();

    val asset = assets.asset @ { .id == ("test", chain_context.blockchain_rid).hash() };
    assert_equals(asset.icon_url, icon_url_with_spaces.trim());
}

struct gtv_asset {
    id: byte_array;
    name;
    symbol: text;
    decimals: integer;
    brid: byte_array;
    supply: big_integer;
    icon_url: text;
}

struct gtv_balance {
    amount: big_integer;
    asset: gtv_asset;
}

function test_asset_balances_are_returned_in_correct_order() {
    val alice = utils.create_test_account(rell.test.keypairs.alice);
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val asset2 = utils.create_asset("test2", "TST2", 0);
    val asset3 = utils.create_asset("test3", "TST3", 0);
    val asset4 = utils.create_asset("test4", "TST4", 0);
    
    admin.mint(alice.account.id, asset1.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset2.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset3.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset4.id, 10L).sign(utils.admin_priv_key()).run();
    
    val balances = ft4.assets_ext.get_asset_balances_paginated(alice.account.id, 4, null).data;

    assert_equals(gtv_balance.from_gtv_pretty(balances[0]).asset.name, asset1.name);
    assert_equals(gtv_balance.from_gtv_pretty(balances[1]).asset.name, asset2.name);
    assert_equals(gtv_balance.from_gtv_pretty(balances[2]).asset.name, asset3.name);
    assert_equals(gtv_balance.from_gtv_pretty(balances[3]).asset.name, asset4.name);
}

function test_asset_balances_are_paginated() {
    val alice = utils.create_test_account(rell.test.keypairs.alice);
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val asset2 = utils.create_asset("test2", "TST2", 0);
    val asset3 = utils.create_asset("test3", "TST3", 0);
    val asset4 = utils.create_asset("test4", "TST4", 0);
    
    admin.mint(alice.account.id, asset1.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset2.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset3.id, 10L).sign(utils.admin_priv_key()).run();
    admin.mint(alice.account.id, asset4.id, 10L).sign(utils.admin_priv_key()).run();
    
    val balances_p1 = ft4.assets_ext.get_asset_balances_paginated(alice.account.id, 3, null);

    assert_equals(gtv_balance.from_gtv_pretty(balances_p1.data[0]).asset.name, asset1.name);
    assert_equals(gtv_balance.from_gtv_pretty(balances_p1.data[1]).asset.name, asset2.name);
    assert_equals(gtv_balance.from_gtv_pretty(balances_p1.data[2]).asset.name, asset3.name);

    val balances_p2 = ft4.assets_ext.get_asset_balances_paginated(alice.account.id, 3, balances_p1.next_cursor);

    assert_equals(gtv_balance.from_gtv_pretty(balances_p2.data[0]).asset.name, asset4.name);
}

function test_paginated_asset_balances_have_correct_format() {
    val alice = utils.create_test_account(rell.test.keypairs.alice);
    val asset1 = utils.create_asset("test1", "TST1", 0);
    admin.mint(alice.account.id, asset1.id, 10L).sign(utils.admin_priv_key()).run();
    val result = ft4.assets_ext.get_asset_balances_paginated(alice.account.id, 1, null);

    assert_equals(result, ft4_utils.paged_result(     
        data = [
            (
                asset = (
                    id = asset1.id,
                    name = "test1",
                    symbol = "TST1",
                    decimals = 0,
                    icon_url = "",
                    supply = 10L,
                    brid = asset1.issuing_brid
                ),
                amount = 10L
            ).to_gtv_pretty()
        ],
        next_cursor = null
    ));
}

function test_assets_are_returned_in_correct_order() {
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val asset2 = utils.create_asset("test2", "TST2", 0);
    val asset3 = utils.create_asset("test3", "TST3", 0);

    val assets = ft4.assets_ext.get_all_assets_paginated(3, null).data;
    assert_equals(gtv_asset.from_gtv_pretty(assets[0]).name, asset1.name);
    assert_equals(gtv_asset.from_gtv_pretty(assets[1]).name, asset2.name);
    assert_equals(gtv_asset.from_gtv_pretty(assets[2]).name, asset3.name);
}
function test_assets_are_paginated() {
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val asset2 = utils.create_asset("test2", "TST2", 0);
    val asset3 = utils.create_asset("test3", "TST3", 0);

    val assets_p1 = ft4.assets_ext.get_all_assets_paginated(2, null);
    assert_equals(assets_p1.data.size(), 2);
    assert_equals(gtv_asset.from_gtv_pretty(assets_p1.data[0]).name, asset1.name);
    assert_equals(gtv_asset.from_gtv_pretty(assets_p1.data[1]).name, asset2.name);
    
    val assets_p2 = ft4.assets_ext.get_all_assets_paginated(2, assets_p1.next_cursor);
    assert_equals(assets_p2.data.size(), 1);
    assert_equals(gtv_asset.from_gtv_pretty(assets_p2.data[0]).name, asset3.name);

}
function test_paginated_assets_have_correct_format() {
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val assets = ft4.assets_ext.get_all_assets_paginated(3, null).data;
    assert_equals(gtv_asset.from_gtv_pretty(assets[0]), gtv_asset(
        id = asset1.id,
        name = asset1.name,
        symbol = asset1.symbol,
        decimals = asset1.decimals,
        brid = chain_context.blockchain_rid,
        supply = 0,
        icon_url = asset1.icon_url
    ));
}
function test_it_gets_asset_by_symbol() {
    val asset1 = utils.create_asset("test1", "TST1", 0);
    val asset2 = utils.create_asset("test2", "TST2", 0);
    val actual_asset = ft4.assets_ext.get_asset_by_symbol(asset1.symbol);
    
    assert_equals(
        actual_asset,
        (
            id = asset1.id,
            symbol = "TST1",
            name = "test1",
            decimals = 0,
            brid = asset1.issuing_brid,
            icon_url = "",
            supply = 0L
        )
    );
}
