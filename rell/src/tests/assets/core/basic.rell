@test module;

import ^.utils;
import acc: ^^^.lib.ft3.accounts;
import ^^^.lib.ft3.admin;

val alice = rell.test.keypairs.alice;
val bob = rell.test.keypairs.bob;

function test_an_account_can_be_created() {
  val auth_descriptor = utils.create_auth_descriptor(alice.pub);
  
  utils.create_test_account(alice);
  
  assert_equals(acc.account @ {}( .id ), auth_descriptor.hash());
}

function test_multi_sig_auth_descriptor_can_be_added() {
  val auth_descriptor = acc.auth_descriptor(
    acc.auth_type.M,
    [
        ["T"].to_gtv(),
        0x2.to_gtv(),
        [
          alice.pub.to_hex(),
          bob.pub.to_hex()
        ].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_multi_sig([alice, bob], auth_descriptor);

  assert_equals(acc.account_auth_descriptor @ {}( .id ), auth_descriptor.hash());
}

function test_an_invalid_descriptor_can_not_be_added() {
  val auth_descriptor = acc.auth_descriptor(
    acc.auth_type.M,
    [
        ["T"].to_gtv(),
        alice.pub.to_hex().to_gtv(),
        bob.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );

  assert_fails(
    //* creates an "uncalled" function, see release notes 0.10.6 section 2 or
    //https://docs.chromia.com/rell/tests#other-functions example at the end
    utils._create_test_acc_from_auth_desc_multi_sig([alice, bob], auth_descriptor, *)
  );
}

function test_an_asset_can_be_created() {
  utils.create_asset("a", "a", 0);
  utils.create_asset("b", "b", 1);
  utils.create_asset("c", "c", 50);
  utils.create_asset("d", "d", 78);
}

function test_an_invalid_asset_cannot_be_created() {
  val error = "Decimals must be between 0 and 78 (included)";
  admin.register_asset("e", "e", -1, "")
    .sign(utils.admin_priv_key())
    .run_must_fail(error);
  admin.register_asset("f", "f", 79, "")
    .sign(utils.admin_priv_key())
    .run_must_fail(error);
}
