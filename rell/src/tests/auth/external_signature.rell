function test_operation_without_auth_message_template_can_be_evm_authenticated() {
  val alice = utils.evm_register_alice();

  var message = "Please sign the message to call\noperation:\n- operation_without_auth_message_template\n\nwith arguments:\n";
  message = message + "- 10\n- 100L\n- 1000.1\n- 0\n- ABCDEF\n- text value\n- null\n\nNonce: {nonce}";

  val signature = utils.metamask_sign(utils.create_auth_message(message, alice), alice.keypair.priv);

  rell.test.tx()
    .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
    // Operation internally calls authenticate but doesn't pass auth message template
    .op(test_operations.operation_without_auth_message_template(
      10,
      100L,
      1000.1,
      false,
      x"abcdef",
      "text value",
      null
    ))
    .run();
}

function test_evm_authenticated_operation_without_message_template_fails_if_signature_is_based_on_invalid_message() {
  val alice = utils.evm_register_alice();

  var message = "Invalid message template. Nonce: {nonce}";
  val signature = utils.metamask_sign(utils.create_auth_message(message, alice), alice.keypair.priv);

  rell.test.tx()
    .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
    // Operation internally calls authenticate but doesn't pass auth message template
    .op(test_operations.operation_without_auth_message_template(
      10,
      100L,
      1000.1,
      false,
      x"abcdef",
      "text value",
      null
    ))
    .run_must_fail("Invalid signature");
}
