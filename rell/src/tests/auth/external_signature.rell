    [
      set(["A"]).to_gtv(),
      0x1.to_gtv(),
      [utils.eth_address_from_privkey(rell.test.keypairs.alice.priv).to_gtv()].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.bob, desc);

  val signature0 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.bob.priv
  );

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.evm_auth(auth_descriptor_id, auth_descriptor_id, [signature0, signature1]))
