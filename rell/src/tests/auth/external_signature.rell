@test
module;

import lib.ft4.auth;
import lib.ft4.accounts;
import ^^^.lib.ft4.utils.{ make_auth_message, derive_nonce };
import test: lib.ft4.test.core;
import test_op: lib.ft4.test.operations;
import test_operations: ^^.operations;

val to_addr = "0xba1691c407f14bccaf6ddc08c4626d462640962ab37b7356aea2e43d104fe96a";

function test_operation_without_auth_operation() {
  test.register_alice();
  rell.test.tx()
    .op(test_operations.test_auth.test_empty_auth_message())
    .run_must_fail("Expected at least two operations");
}

function test_fails_if_insufficient_permissions() {
  val external_auth_data = test.register_alice_evm();
  val signature = test.evm_sign("", external_auth_data.keypair.priv);

  rell.test.tx()
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature]))
    .op(test_operations.test_auth.test_empty_auth_message())
    .run_must_fail("The auth descriptor does not have the required permissions");
}

function test_it_decorates_messages_with_blockchain_rid_and_nonce() {
  val message = auth.external.get_auth_message_template("test_empty_auth_message", null);
  assert_true(message.contains("{blockchain_rid}"));
  assert_true(message.contains("{nonce}"));
}

function test_it_rejects_wrong_evm_signatures() {
  val external_auth_data = test.register_alice_evm([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]);
  val wrong_signature = test.evm_sign("abc", external_auth_data.keypair.priv);
  
  rell.test.tx()
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [wrong_signature]))
    .op(test_op.authenticated_operation())
    .sign(rell.test.keypairs.alice)
    .run_must_fail("Invalid signature");
}

function test_perform_evm_auth_transaction() {
  val external_auth_data = test.register_alice_evm([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]);
  val op = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);
  rell.test.tx()
    .op(test.evm_auth_operation_for(external_auth_data.keypair.priv, op))
    .op(op)
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_multisig_external_signature() {
  val alice_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
  val bob_address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
  val desc = accounts.auth_descriptor(
    accounts.auth_type.M,
    [
      set([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]).to_gtv(),
      (2).to_gtv(),
      [alice_address, bob_address].to_gtv()
    ],
    rules = null.to_gtv()
  );

  test.register_account_with_auth_descriptor(desc, rell.test.keypairs.bob);

  val op = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);

  val signature0 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.bob.priv 
  );

  val account_id = [alice_address, bob_address].hash();
  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.external.evm_auth(account_id, auth_descriptor_id, [signature0, signature1]))
    .op(op)
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_it_rejects_transactions_if_not_enough_signatures() {
  val alice_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
  val bob_address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
  val charlie_address = crypto.eth_privkey_to_address(rell.test.keypairs.charlie.priv);
  val desc = accounts.auth_descriptor(
    accounts.auth_type.M,
    [
      set([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]).to_gtv(),
      (3).to_gtv(),
      [alice_address, bob_address, charlie_address].to_gtv()
    ],
    rules = null.to_gtv()
  );

  test.register_account_with_auth_descriptor(desc, rell.test.keypairs.bob);

  val op = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);

  val signature0 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.bob.priv 
  );

  val account_id = [alice_address, bob_address, charlie_address].hash();
  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.external.evm_auth(account_id, auth_descriptor_id, [signature0, signature1]))
    .op(op)
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Minimum number of valid signatures not reached. Expected <3>, found <2>.");
}

function test_it_rejects_signatures_not_part_of_a_d() {
  val alice_address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
  val desc = accounts.auth_descriptor(
    accounts.auth_type.M,
    [
      set([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]).to_gtv(),
      (1).to_gtv(),
      [alice_address].to_gtv()
    ],
    rules = null.to_gtv()
  );

  test.register_account_with_auth_descriptor(desc, rell.test.keypairs.bob);

  val op = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);

  val signature0 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op.to_gtx_operation(), 0)
    ),
    rell.test.keypairs.bob.priv 
  );

  val account_id = alice_address.hash();
  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.external.evm_auth(account_id, auth_descriptor_id, [signature0, signature1]))
    .op(op)
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Invalid signature");
}

function test_works_with_correct_ctr() {
  val external_auth_data = test.register_alice_evm([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]);
  val op1 = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);
  val op2 = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);
  val signature0 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op1.to_gtx_operation(), 0)
    ),
    external_auth_data.keypair.priv
  );
  val signature1 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op2.to_gtx_operation(), 1)
    ),
    external_auth_data.keypair.priv
  );

  rell.test.tx()
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(op1)
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature1]))
    .op(op2)
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_rejects_wrong_ctr() {
  val external_auth_data = test.register_alice_evm([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]);
  val op1 = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);
  val op2 = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);
  val op3 = test_operations.test_auth.test_perform_large_transfer(1000, to_addr);

  val signature0 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op1.to_gtx_operation(), 0)
    ),
    external_auth_data.keypair.priv
  );
  val signature1 = test.evm_sign(
    "Blockchain:\n%s\n\nDo you want to send 1000 CHR to %s?\n\nNonce: %s".format(
      chain_context.blockchain_rid.to_hex(),
      to_addr,
      derive_nonce(op3.to_gtx_operation(), 1)
    ),
    external_auth_data.keypair.priv 
  );

  rell.test.tx()
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(op1)
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(op2)
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Invalid signature");

  rell.test.tx()
    .op(auth.external.evm_auth(external_auth_data.account.id, external_auth_data.auth_descriptor_id, [signature1]))
    .op(op3)
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Invalid signature");
}

function test_ft_auth_fails_if_key_invalid() {
  val keypair = rell.test.keypairs.alice;
  val desc = accounts.auth_descriptor(
    accounts.auth_type.S,
    [
      set([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]).to_gtv(),
      keypair.pub.to_gtv()
    ],
    rules = null.to_gtv()
  );
  test.register_account_with_auth_descriptor(desc, keypair);

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.external.ft_auth(keypair.pub.hash(), auth_descriptor_id))
    .op(test_operations.test_auth.test_perform_large_transfer(1000, to_addr))
    .sign(rell.test.keypairs.bob.priv)
    .run_must_fail("The auth descriptor signer did not sign the transaction.");
}

function test_perform_ft_auth_transaction() {
  val external_key = rell.test.keypairs.alice;
  val auth_descriptor = accounts.auth_descriptor(
    accounts.auth_type.S,
    [
      set([accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]).to_gtv(),
      external_key.pub.to_gtv()
    ],
    rules = null.to_gtv()
  );

  test.register_account_with_auth_descriptor(auth_descriptor, external_key);

  val auth_descriptor_id = auth_descriptor.hash();
  rell.test.tx()
    .op(auth.external.ft_auth(external_key.pub.hash(), auth_descriptor_id))
    .op(test_operations.test_auth.test_perform_large_transfer(1000, to_addr))
    .sign(external_key.priv)
    .run();
}

function test_auth_message_is_generated_without_arguments_when_operation_has_no_arguments() {
  val op = gtx_operation(
    name = "foo",
    args = []
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op), 
    "Please sign the message to call\noperation:\n- foo"
  );
}

function test_auth_message_is_generated_with_arguments_when_operation_has_arguments() {
  val op = gtx_operation(
    name = "foo",
    args = [
      (1).to_gtv(),
      "text_value".to_gtv()
    ]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op), 
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 1\n- text_value"
  );
}

function test_auth_message_is_correctly_generated_with_byte_array_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [x"0123456789abcdef".to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op), 
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 0123456789ABCDEF"
  );
}

function test_auth_message_is_correctly_generated_with_decimal_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [(3.14).to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 3.14"
  );
}

function test_auth_message_is_correctly_generated_with_enum_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [accounts.auth_type.S.to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 0"
  );
}

function test_auth_message_is_correctly_generated_with_boolean_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [true.to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 1"
