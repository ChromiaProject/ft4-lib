@test
module;

import ^^.assets.utils;
import ^^^.lib.ft4.auth;
import acc: ^^^.lib.ft4.accounts;
import acc_ext: ^^^.lib.ft4.accounts.external;
import test_operations: ^^.operations;

val to_addr = "0xba1691c407f14bccaf6ddc08c4626d462640962ab37b7356aea2e43d104fe96a";

function test_operation_without_auth_operation() {
  utils.register_alice();
  rell.test.tx()
    .op(test_operations.auth.test_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .run_must_fail("Expected at least two operations");
}

function test_fails_if_insufficient_permissions() {
  val external_auth_data = utils.evm_register_alice(set(["X"]));
  val signature = utils.metamask_sign("", external_auth_data.keypair.priv);

  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature]))
    .op(test_operations.auth.test_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .run_must_fail("The auth descriptor does not have the required permissions");
}

function test_it_rejects_messages_without_nonce() {
  val external_auth_data = utils.evm_register_alice(set(["A"]));
  val signature = utils.metamask_sign("", external_auth_data.keypair.priv);

  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature]))
    .op(test_operations.auth.test_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Message template has to include '{nonce}'");
}

function test_it_rejects_wrong_eth_signatures() {
  val external_auth_data = utils.evm_register_alice(set(["A"]));
  val wrong_signature = utils.metamask_sign("abc", external_auth_data.keypair.priv);
  
  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [wrong_signature]))
    .op(test_operations.auth.test_authenticated_operation("Some message {nonce}"))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice)
    .run_must_fail("Invalid signature");
}

function test_perform_eth_auth_transaction() {
  val external_auth_data = utils.evm_register_alice(set(["A"]));
  val signature = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    external_auth_data.keypair.priv
  );

  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_multisig_external_signature() {
  val desc = acc.auth_descriptor(
    acc.auth_type.EM,
    [
      set(["A"]).to_gtv(),
      0x2.to_gtv(),
      [
        utils.eth_address_from_privkey(rell.test.keypairs.alice.priv).to_gtv(),
        utils.eth_address_from_privkey(rell.test.keypairs.bob.priv).to_gtv()
      ].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.bob, desc);

  val signature0 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.bob.priv 
  );

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.evm_auth(auth_descriptor_id, auth_descriptor_id, [signature0, signature1]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_it_rejects_transactions_if_not_enough_signatures() {
  val desc = acc.auth_descriptor(
    acc.auth_type.EM,
    [
      set(["A"]).to_gtv(),
      0x3.to_gtv(),
      [
        utils.eth_address_from_privkey(rell.test.keypairs.alice.priv).to_gtv(),
        utils.eth_address_from_privkey(rell.test.keypairs.bob.priv).to_gtv()
      ].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.bob, desc);

  val signature0 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.alice.priv
  );
  val signature1 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    rell.test.keypairs.bob.priv
  );

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.evm_auth(auth_descriptor_id, auth_descriptor_id, [signature0, signature1]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Minimum number of valid signatures not reached");
}

