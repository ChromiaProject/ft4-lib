}

function test_auth_message_is_correctly_generated_with_big_integer_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [1234567890L.to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 1234567890L"
  );
}

function test_auth_message_is_correctly_generated_with_null_argument_value() {
  val op = gtx_operation(
    name = "foo",
    args = [null.to_gtv()]
  );

  assert_equals(
    auth.generate_operation_auth_message(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- null"
  );
}

function test_operation_without_auth_message_template_can_be_evm_authenticated() {
  val alice = test.register_alice_evm();

  val op = test_operations.operation_without_auth_message_template();
  val signature = test.evm_sign(test.create_evm_auth_message(op, alice), alice.keypair.priv);

  rell.test.tx()
    .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
    // Operation internally calls authenticate but doesn't pass auth message template
    .op(op)
    .run();
}

function test_evm_authenticated_operation_without_message_template_fails_if_signature_is_based_on_invalid_message() {
  val alice = test.register_alice_evm();

  val op = test_operations.operation_with_invalid_auth_message_template();
  var message = "Invalid message template. Nonce: {nonce}".replace(auth.NONCE_PLACEHOLDER, derive_nonce(op.to_gtx_operation(), 0));
  
  val signature = test.evm_sign(message, alice.keypair.priv);

  rell.test.tx()
    .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
    .op(op)
    .run_must_fail("Invalid signature");
}

function test_fails_if_evm_signatures_does_not_correspond_to_signers() {
  val alice_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.alice);
  val bob_address = crypto.eth_pubkey_to_address(rell.test.pubkeys.bob);
  val original_ad = test.create_multisig_auth_descriptor(2, [alice_address, bob_address], [accounts.AUTH_FLAG_ACCOUNT, accounts.AUTH_FLAG_TRANSFER]);
  test.register_account_with_multisig_auth_descriptor(original_ad, [rell.test.keypairs.alice, rell.test.keypairs.bob]);
  val account = accounts.account @ {} ( @omit @sort_desc .rowid, $ ) limit 1;
  
  val op = test_op.authenticated_operation();
  val message = make_auth_message("")
    .replace("{blockchain_rid}", chain_context.blockchain_rid.to_hex())
    .replace("{nonce}", derive_nonce(op.to_gtx_operation(), 0));
  val signature = test.evm_sign(message, rell.test.keypairs.alice.priv);

  rell.test.tx()
    .op(auth.external.evm_auth(account.id, original_ad.hash(), [signature, signature]))
    .op(op)
    .run_must_fail("Expected signer at index <1> to be <%s> but was: <%s>".format(bob_address, alice_address));
}

function test_it_correctly_verifies_message_with_non_ascii_characters_signed_by_ethers() {
  // Message signature is generated using ethers.js
  // > const { utils, ethers } = require("ethers")
  // > const wallet = new ethers.Wallet("2222222222222222222222222222222222222222222222222222222222222222")
  // > ethers.Signature.from(await wallet.signMessage("👋🌎"))
  // Signature { 
  //  r: "0x4de541f92b06a96becb0acd0e4912d067d161cc7353f35157e69a0d1726df122", 
  //  s: "0x0b4c13f9f8a9bf067bfb595fa2ec0ad0111b500c7616f6638c8f043c0885e14f", 
  //  yParity: 1, 
  //  networkV: null 
  // }

  val signature = auth.signature(
    r = x"4de541f92b06a96becb0acd0e4912d067d161cc7353f35157e69a0d1726df122",
    s = x"0b4c13f9f8a9bf067bfb595fa2ec0ad0111b500c7616f6638c8f043c0885e14f",
    v = 28
  );
  
  val address = crypto.eth_privkey_to_address(rell.test.keypairs.alice.priv);
  assert_equals(auth._recover_evm_address("👋🌎", signature), address);
}
