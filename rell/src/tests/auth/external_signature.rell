}

function test_works_with_correct_ctr() {
  val external_auth_data = utils.evm_register_alice(set(["A"]));
  val signature0 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    external_auth_data.keypair.priv
  );
  val signature1 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "1"
    ),
    external_auth_data.keypair.priv
  );

  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature1]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_rejects_wrong_ctr() {
  val external_auth_data = utils.evm_register_alice(set(["A"]));
  val signature0 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    external_auth_data.keypair.priv
  );
  val signature1 = utils.metamask_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "1"
    ),
    external_auth_data.keypair.priv
  );

  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature0]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Invalid signature");
  rell.test.tx()
    .op(auth.evm_auth(external_auth_data.auth_descriptor_id, external_auth_data.auth_descriptor_id, [signature1]))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Invalid signature");
}

function test_ft_auth_fails_if_key_invalid() {
  val keypair = rell.test.keypairs.alice;
  val desc = acc.auth_descriptor(
    acc.auth_type.S,
    [
      ["A"].to_gtv(),
      keypair.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );
  utils._create_test_acc_from_auth_desc_single_sig(keypair, desc);

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.ft_auth(auth_descriptor_id, auth_descriptor_id))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.bob.priv)
    .run_must_fail("The provided key(s) is not a signer of this auth descriptor");
}

function test_perform_ft_auth_transaction() {
  val external_key = rell.test.keypairs.alice;
  val auth_descriptor = acc.auth_descriptor(
    acc.auth_type.S,
    [
      ["A"].to_gtv(),
      external_key.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils.create_test_account_with_auth_descriptor(auth_descriptor, external_key);

  val auth_descriptor_id = auth_descriptor.hash();
  rell.test.tx()
    .op(auth.ft_auth(auth_descriptor_id, auth_descriptor_id))
    .op(test_operations.auth.test_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(external_key.priv)
    .run();
}

function test_auth_message_is_generated_without_arguments_when_operation_has_no_arguments() {
  val op = gtx_operation(
    name = "foo",
    args = []
  );

  assert_equals(
    auth.generate_auth_message_template(x"", op), 
    "Please sign the message to call\noperation:\n- foo\n\nNonce: {nonce}"
  );
}

function test_auth_message_is_generated_with_arguments_when_operation_has_arguments() {
  val op = gtx_operation(
    name = "foo",
    args = [
      (1).to_gtv(),
      "text_value".to_gtv()
    ]
  );

  assert_equals(
    auth.generate_auth_message_template(x"", op), 
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 1\n- text_value\n\nNonce: {nonce}"
  );
}

function test_auth_message_is_correctly_generated_with_byte_array_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [x"0123456789abcdef".to_gtv()]
  );

  assert_equals(
    auth.generate_auth_message_template(x"", op), 
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- 0123456789ABCDEF\n\nNonce: {nonce}"
  );
}

function test_auth_message_is_correctly_generated_with_decimal_argument() {
  val op = gtx_operation(
    name = "foo",
    args = [(3.14).to_gtv()]
