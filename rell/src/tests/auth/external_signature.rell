function test_auth_message_is_correctly_generated_with_null_argument_value() {
  val op = gtx_operation(
    name = "foo",
    args = [null.to_gtv()]
  );

  assert_equals(
    auth.generate_auth_message_template(x"", op),
    "Please sign the message to call\noperation:\n- foo\n\nwith arguments:\n- null\n\nNonce: {nonce}"
  );
