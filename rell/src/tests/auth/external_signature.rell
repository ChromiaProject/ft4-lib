@test
module;

import ^^.core.utils;
import ^^^.lib.ft3.auth;
import acc: ^^^.lib.ft3.account;
import acc_ext: ^^^.lib.ft3.account.external;
import dev_op: ^^^.lib.ft3.operations.dev_op_auth;
import test_operations: ^^.operations;

val external_priv_key = byte_array
  .from_hex("78542bc0fa5278d4c4f2a8244f1b76c02494de806a97c55a708c00ad4bdf71cb");
val external_address = byte_array
  .from_hex("a28f6f9f591ac13ee2d9f374fcb8c1401c2f1209");

val second_external_priv_key = byte_array
  .from_hex("9ad64e7ce9723b2c04e101c24cea8e36e336726efd7dec8f61b3a9a68f49f548");
val second_external_address = byte_array
  .from_hex("0011df4f2514c4e94f4f6e3598c360a5925b4d9e");

val to_addr = "0xba1691c407f14bccaf6ddc08c4626d462640962ab37b7356aea2e43d104fe96a";

function eth_sign(msg: text, priv: byte_array = external_priv_key): auth.signature {
  val sig = crypto.eth_sign(
    keccak256(("\u0019Ethereum Signed Message:\n" + msg.size().to_text() + msg).to_bytes()),
    priv
  );

  return auth.signature(
    r=sig[0],
    s=sig[1],
    v=sig[2] + 27
  );
}

function setup_extended_auth(rell.test.keypair, flags: gtv = set(["A"]).to_gtv()) {
  val desc = acc.auth_descriptor(
    acc.auth_type.ES,
    [
      flags,
      external_address.to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(keypair, desc);

  return desc.hash();
}


function test_operation_without_auth_operation() {
  utils.register_alice();
  var tx = rell.test.tx()
    .op(dev_op.dev_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .run_must_fail("Expected at least two operations");
}

function test_fails_if_insufficient_permissions() {
  val alice_auth_desc_id = setup_extended_auth(rell.test.keypairs.alice, set(["X"]).to_gtv());
  val signature = eth_sign("");

  var tx = rell.test.tx()
    .op(auth.evm_auth(alice_auth_desc_id, alice_auth_desc_id, [signature]))
    .op(dev_op.dev_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .run_must_fail("The auth descriptor does not have the required permissions");
}

function test_it_rejects_messages_without_nonce() {
  val alice_auth_desc_id = setup_extended_auth(rell.test.keypairs.alice);
  val signature = eth_sign("");

  var tx = rell.test.tx()
    .op(auth.evm_auth(alice_auth_desc_id, alice_auth_desc_id, [signature]))
    .op(dev_op.dev_authenticated_operation(""))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    //gets thrown before "Empty messages are not allowed"
    .run_must_fail("Message template has to include '{nonce}'");
}

function test_it_rejects_wrong_eth_signatures() {
  val auth_desc_id = setup_extended_auth(rell.test.keypairs.alice);
  val wrong_signature = eth_sign("abc");

  val args = [
    auth_desc_id.to_gtv(),
    [wrong_signature].to_gtv(),
    [0].to_gtv(),
    rell.test.keypairs.alice.pub.to_gtv()
  ];

  var tx = rell.test.tx()
    .op(auth.evm_auth(auth_desc_id, auth_desc_id, [wrong_signature]))
    .op(dev_op.dev_authenticated_operation("Some message {nonce}"))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice)
    .run_must_fail("Invalid signature");
}

function test_perform_eth_auth_transaction() {
  val alice_acc_desc_id = setup_extended_auth(rell.test.keypairs.alice);
  val desc = acc.account_auth_descriptor @ { .id == alice_acc_desc_id };
  val signature = eth_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      desc.ctr.to_text().replace("\"", "")
    ) 
  );

  rell.test.tx()
    .op(auth.evm_auth(alice_acc_desc_id, alice_acc_desc_id, [signature]))
    .op(dev_op.dev_perform_large_transfer(1000, to_addr))
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_multisig_external_signature() {
  val desc = acc.auth_descriptor(
    acc.auth_type.EM,
    [
      set(["A"]).to_gtv(),
      0x2.to_gtv(),
      [external_address, second_external_address].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.bob, desc);

  val alice_acc = acc.account_auth_descriptor @ {}(.account);

  val signature0 = eth_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ) 
  );
  val signature1 = eth_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    second_external_priv_key 
  );

  val auth_descriptor_id = desc.hash();
  rell.test.tx()
    .op(auth.evm_auth(auth_descriptor_id, auth_descriptor_id, [signature0, signature1]))
    .op(dev_op.dev_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_it_rejects_transactions_if_not_enough_signatures() {
  val desc = acc.auth_descriptor(
    acc.auth_type.EM,
    [
      set(["A"]).to_gtv(),
      0x3.to_gtv(),
      [external_address, second_external_address].to_gtv()
    ],
    rules = null.to_gtv()
  );

  utils._create_test_acc_from_auth_desc_single_sig(rell.test.keypairs.bob, desc);

  val signature0 = eth_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ) 
  );
  val signature1 = eth_sign(
    "Do you want to send 1000 CHR to %s? Nonce: %s".format(
      to_addr,
      "0"
    ),
    second_external_priv_key
  );

  val auth_descriptor_id = desc.hash();
  var tx = rell.test.tx()
    .op(auth.evm_auth(auth_descriptor_id, auth_descriptor_id, [signature0, signature1]))
    .op(dev_op.dev_perform_large_transfer(1000, to_addr))
    .sign(utils.admin_priv_key())
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail("Minimum number of valid signatures not reached");
}

