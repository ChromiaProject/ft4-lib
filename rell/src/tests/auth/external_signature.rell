@test
module;

import ^^.core.utils;
import acc: ^^^.lib.ft3.account;
import acc_ext: ^^^.lib.ft3.account.external;
import dev_op: ^^^.lib.ft3.operations.dev_op_auth;

val external_key = byte_array.from_hex("dc922451d86a9c802257066592122a7cc9a64d16");

function setup_extended_auth() {
  val desc = acc.auth_descriptor(
    "S",
    [ external_key ],
    [
      ["E"].to_gtv(),
      external_key.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );

  rell.test.tx()
    .op(dev_op.create_eth_account(desc))
    .run();

    return desc.hash();
}

function test_correctly_format_message() {
  val args = ["100 CHR", "0xabc123"];
  val msg = acc.format("transfer '%s' to '%s'", args);
  assert_equals(msg, "transfer '100 CHR' to '0xabc123'");
}

function test_operation_without_auth_operation() {
  utils.create_ft3_test_acc(rell.test.keypairs.alice).auth_id;
  rell.test.tx()
    .op(dev_op.authenticated_operation(acc.auth_details(flags=list<text>(), messages=[""]), acc.account_auth_descriptor @ {}))
    .run_must_fail();
}

function test_fails_if_insufficient_permissions() {
  val alice_auth_desc_id = setup_extended_auth();

  val signature = acc.signature(
    r="",
    s="",
    v=1
  );

  rell.test.tx()
    .op(acc.eth_auth(alice_auth_desc_id, [external_key], [0], [signature]))
    .op(dev_op.authenticated_operation(acc.auth_details(flags=["E"], messages=[""]), acc.account_auth_descriptor @ {}))
    .run_must_fail();
}

function test_it_rejects_empty_messages() {
  val alice_auth_desc_id = setup_extended_auth();
  val message = "";
  val signature = acc.signature(
    r="a93754f90fe2a42f2b5705eeb7f7cd4e13f2f70ae049ebac035c5401ed663e8d",
    s="1e926edb77543a4d50310ac792a5cc615cf648320915e353e55af779146fd30f",
    v=28
  );

  val acc_desc = acc.account_auth_descriptor @* {};

  rell.test.tx()
    .op(acc.eth_auth(alice_auth_desc_id, [external_key], [0], [signature]))
    .op(dev_op.authenticated_operation(acc.auth_details(flags=["E"], message_template="", messages=[message]), acc_desc[0]))
    .sign(rell.test.keypairs.alice.priv)
    .run_must_fail();
}

function test_perform_eth_auth_transaction() {
  val alice_acc_desc_id = setup_extended_auth();
  val msg_template = "Do you want to send %s CHR to %s? Nonce: %s";
  val signature = acc.signature(
    r="b62cce38c2c5fbd3041f2369cc5e859121b4fbca25c043d3a4f31cc8cb0a1be2",
    s="10bde20497c1a51532cdd301cde1d4285b59a4422b1977babb9c38b515e131c7",
    v=28
  );

  val alice_acc_desc = acc.account_auth_descriptor @ { .id == alice_acc_desc_id };
  val alice_acc = alice_acc_desc.account;

  val auth_details = acc.auth_details(
    flags=["E"],
    message_template=msg_template,
    disposable_key=rell.test.keypairs.alice.pub
  );

  rell.test.tx()
    .op(acc.eth_auth(alice_acc_desc_id, [external_key], [acc_ext.get_ctr_for_external_key(alice_acc_desc_id, external_key)], [signature]))
    .op(dev_op.perform_large_transfer(auth_details, alice_acc_desc, alice_acc, alice_acc, 1000))
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_multisig_external_signature() {
  val second_external_key = byte_array.from_hex("859304192d439DB42DFFD47b87b794509e6c9B9e");
  val desc = acc.auth_descriptor(
    "M",
    [ external_key, second_external_key ],
    [
      ["E"].to_gtv(),
      external_key.to_hex().to_gtv(),
      second_external_key.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );

  rell.test.tx()
    .op(dev_op.create_eth_account(desc))
    .run();

  val alice_acc_desc = acc.account_auth_descriptor @ {};
  val alice_acc = alice_acc_desc.account;

  val msg_template = "Do you want to send %s CHR to %s? Nonce: %s";
  val signature0 = acc.signature(
    r="a148762f624a0cb7b4e346feb6cf5fa85559b56f4006844c9b3ae3c3370e34d3",
    s="4766e6ff17abe57140a37bcfb60452486b2ec69b2e334c685a93efe9446ab6d8",
    v=28
  );
  val signature1 = acc.signature(
    r="e49d73012d42d33388fba929de5b423ebc7cec6b7b01a05459785f4d1f8f87ba",
    s="6ae3ee3dbc393f2d8ed49c4effa480c3832989d46eac2ca141d1b2069b88fcf3",
    v=28
  );

  val auth_details = acc.auth_details(
    flags=["E"],
    message_template=msg_template,
    disposable_key=rell.test.keypairs.alice.pub
  );

  rell.test.tx()
    .op(acc.eth_auth(desc.hash(), [external_key, second_external_key], [0, 0], [signature0, signature1]))
    .op(dev_op.perform_large_transfer(auth_details, alice_acc_desc, alice_acc, alice_acc, 1000))
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_requires_correct_ctr() {
  val alice_acc_desc_id = setup_extended_auth();
  val msg_template = "Do you want to send %s CHR to %s? Nonce: %s";
  val signature0 = acc.signature(
    r="b62cce38c2c5fbd3041f2369cc5e859121b4fbca25c043d3a4f31cc8cb0a1be2",
    s="10bde20497c1a51532cdd301cde1d4285b59a4422b1977babb9c38b515e131c7",
    v=28
  );

  val signature1 = acc.signature(
    r="2106eda77e00f608f158784d8095ac63a97aa89d2a7d14da1678fe6552942ffd",
    s="6b446296c6926cce4d64db6f0aa4b4f3ff333798a82266dabe63bb0ce67d55fd",
    v=27
  );

  val alice_acc_desc = acc.account_auth_descriptor @ { .id == alice_acc_desc_id };
  val alice_acc = alice_acc_desc.account;

  val auth_details = acc.auth_details(
    flags=["E"],
    message_template=msg_template,
    disposable_key=rell.test.keypairs.alice.pub
  );

  rell.test.tx()
    .op(acc.eth_auth(alice_acc_desc_id, [external_key], [0], [signature0]))
    .op(dev_op.perform_large_transfer(auth_details, alice_acc_desc, alice_acc, alice_acc, 1000))
    .op(acc.eth_auth(alice_acc_desc_id, [external_key], [1], [signature1]))
    .op(dev_op.perform_large_transfer(auth_details, alice_acc_desc, alice_acc, alice_acc, 1000))
    .sign(rell.test.keypairs.alice.priv)
    .run();
}

function test_ft4_auth_fails_if_key_invalid() {
  val msg_template = "Do you want to send %s CHR to %s? Nonce: %s";
  val external_key = rell.test.keypairs.alice;
  val external_key_bob = rell.test.keypairs.bob;
  val desc = acc.auth_descriptor(
    "S",
    [ external_key.pub ],
    [
      ["E"].to_gtv(),
      external_key.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );
  rell.test.tx()
    .op(dev_op.create_ft4_account(desc))
    .sign(external_key.priv)
    .run();

  val alice_acc_desc = acc.account_auth_descriptor @ { .id == desc.hash() };
  val alice_acc = alice_acc_desc.account;

  rell.test.tx()
    .op(acc.ft4_auth(desc.hash(), [external_key.pub], [0]))
    .op(dev_op.perform_large_transfer(acc.auth_details(flags=["E"], message_template=msg_template), alice_acc_desc, alice_acc, alice_acc, 1000))
    .sign(external_key_bob.priv)
    .run_must_fail();
}

function test_perform_ft4_auth_transaction() {
  val msg_template = "Do you want to send %s CHR to %s? Nonce: %s";
  val external_key = rell.test.keypairs.alice;
  val desc = acc.auth_descriptor(
    "S",
    [ external_key.pub ],
    [
      ["E"].to_gtv(),
      external_key.pub.to_hex().to_gtv()
    ],
    rules = null.to_gtv()
  );
  rell.test.tx()
    .op(dev_op.create_ft4_account(desc))
    .sign(external_key.priv)
    .run();

  val alice_acc_desc = acc.account_auth_descriptor @ { .id == desc.hash() };
  val alice_acc = alice_acc_desc.account;

  rell.test.tx()
    .op(acc.ft4_auth(desc.hash(), [external_key.pub], [0]))
    .op(dev_op.perform_large_transfer(acc.auth_details(flags=["E"], message_template=msg_template), alice_acc_desc, alice_acc, alice_acc, 1000))
    .sign(external_key.priv)
    .run();
}
