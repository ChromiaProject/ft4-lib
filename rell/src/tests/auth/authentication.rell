@test
module;

import lib.ft4.auth;
import test: lib.ft4.test.core;
import test_op: lib.ft4.test.operations;
import auth_ext: ^^.extensions.auth.*;
import ^^^.lib.ft4.utils.{ derive_nonce };
import ^^^.lib.ft4.utils.{ latest_time };
import test_operations: ^^.operations;

function test_before_and_after_authenticate_extensions_are_called_with_ft_auth() {
    val alice = test.register_account_open(rell.test.keypairs.alice, ["A", "T"]);

    // Perform an authentication operation
    rell.test.tx()
        .op(alice.ft_auth(test_op.authenticated_operation()))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(auth_ext.auth_extensions_state.is_before_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.before_authenticate_account, alice.account.id);
    assert_true(auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_id.size() > 0);
    assert_equals(auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_ctr, 0);

    assert_true(auth_ext.auth_extensions_state.is_after_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_account, alice.account.id);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_auth_descriptor_id,
        auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_id);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_auth_descriptor_ctr, 1);
}

function test_before_and_after_authenticate_extensions_are_called_with_evm_auth() {
    val alice = test.register_alice_evm(["A", "T", "E"]); // "E" flag is required by `test_empty_auth_message`

    val op = test_operations.test_auth.test_empty_auth_message();
    val signature = test.evm_sign(
      "Blockchain:\n%s\n\n\n\nNonce: %s".format(
        chain_context.blockchain_rid.to_hex(),
        derive_nonce(op.to_gtx_operation(), 0)
      ),
      alice.keypair.priv
    );

    // Perform an authentication operation
    rell.test.tx()
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .op(op)
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(auth_ext.auth_extensions_state.is_before_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.before_authenticate_account, alice.account.id);
    assert_true(auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_id.size() > 0);
    assert_equals(auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_ctr, 0);

    assert_true(auth_ext.auth_extensions_state.is_after_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_account, alice.account.id);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_auth_descriptor_id,
        auth_ext.auth_extensions_state.before_authenticate_auth_descriptor_id);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_auth_descriptor_ctr, 1);
}

function test_cannot_sign_only_ft_auth_op() {
    val alice = test.register_alice();
    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("<ft4.ft_auth> must be followed by an operation to authorize");
}

function test_cannot_sign_only_evm_auth_op() {
    val alice = test.register_alice_evm();

    val op = test_operations.test_auth.test_empty_auth_message();
    val signature = test.evm_sign(
      "Blockchain:\n%s\n\n\n\nNonce: %s".format(
        chain_context.blockchain_rid.to_hex(),
        derive_nonce(op.to_gtx_operation(), 0)
      ),
      alice.keypair.priv
    );

    rell.test.tx()
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("<ft4.evm_auth> must be followed by an operation to authorize");
}

function test_cannot_sign_invalid_ops_with_ft_auth() {
    val alice = test.register_alice();
    val invalid_ops = [
        rell.test.op("nop"),
        gtx_operation(name = "timeb", args = [(latest_time()).to_gtv(), (latest_time() * 2).to_gtv()]).to_test_op(),
        gtx_operation(name = "iccf_proof", args = [x"".to_gtv(), x"".to_gtv(), x"".to_gtv(), x"".to_gtv(), (0).to_gtv(), x"".to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.ft_auth", args = [x"".to_gtv(), x"".to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.evm_auth", args = [x"".to_gtv(), x"".to_gtv(), list<auth.signature>().to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.evm_signatures", args = [list<byte_array>().to_gtv(), list<auth.signature>().to_gtv()]).to_test_op(),
    ];


    for (invalid_op in invalid_ops) {
        rell.test.tx()
            .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
            .op(invalid_op)
            .sign(rell.test.keypairs.alice)
            .run_must_fail("<ft4.ft_auth> cannot authorize <%s>".format(invalid_op.name));
    }
}

function test_cannot_sign_invalid_ops_with_evm_auth() {
    val alice = test.register_alice_evm();
    val invalid_ops = [
        rell.test.op("nop"),
        gtx_operation(name = "timeb", args = [(latest_time()).to_gtv(), (latest_time() * 2).to_gtv()]).to_test_op(),
        gtx_operation(name = "iccf_proof", args = [x"".to_gtv(), x"".to_gtv(), x"".to_gtv(), x"".to_gtv(), (0).to_gtv(), x"".to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.ft_auth", args = [x"".to_gtv(), x"".to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.evm_auth", args = [x"".to_gtv(), x"".to_gtv(), list<auth.signature>().to_gtv()]).to_test_op(),
        gtx_operation(name = "ft4.evm_signatures", args = [list<byte_array>().to_gtv(), list<auth.signature>().to_gtv()]).to_test_op(),
        gtx_operation(name = "unauthable_op", args = []).to_test_op(),
    ];

    for (invalid_op in invalid_ops) {
        val op = test_operations.test_auth.test_empty_auth_message();
        val signature = test.evm_sign(
            "Blockchain:\n%s\n\n\n\nNonce: %s".format(
                chain_context.blockchain_rid.to_hex(),
                derive_nonce(op.to_gtx_operation(), 0)
            ),
            alice.keypair.priv
        );

        rell.test.tx()
            .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
            .op(invalid_op)
            .sign(rell.test.keypairs.alice)
            .run_must_fail("<ft4.evm_auth> cannot authorize <%s>".format(invalid_op.name));
    }
}
