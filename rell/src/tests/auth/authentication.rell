@test
module;

import ^^.assets.utils;
import auth_ext: ^^.extensions.auth.*;
import test_operations: ^^.operations;

function test_before_authenticate_extension_is_called() {
    val alice = utils.register_alice(); // Assuming register_alice is a helper function

    // Perform an authentication operation
    rell.test.tx()
        .op(alice.ft_auth())
        .op(test_operations.test_auth.test_authenticated_operation_no_auth_handler())
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(auth_ext.auth_extensions_state.is_before_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.before_authenticate_account, alice.account.id);
}

function test_after_authenticate_extension_is_called() {
    val alice = utils.register_alice(); // Assuming register_alice is a helper function

    // Perform an authentication operation
    rell.test.tx()
        .op(alice.ft_auth())
        .op(test_operations.test_auth.test_authenticated_operation_no_auth_handler())
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(auth_ext.auth_extensions_state.is_after_authenticate_called);
    assert_equals(auth_ext.auth_extensions_state.after_authenticate_account, alice.account.id);
}
