@test
module;

import ^^^.main.*;
import ^^.extensions.*;
import ^^^.lib.ft3.core;
import ^^^.lib.ft3.ft3_basic_dev.*;
import acc: ^^^.lib.ft3.account;
import ^.utils;

function test_history() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 5);

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id,
            asset_id = asset.id,
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id = asset.id,
            amount = 1,
            extra = map()
        )
    ];

    utils.mint(alice.account, asset, 1);

    rell.test.tx()
        .op(ft3.core_ext.transfer(inputs, outputs))
        .sign(rell.test.keypairs.alice)
        .run();

    val filter = core.filter(null);
    val start_cursor = core.encode_cursor(core.page_cursor());
    val response_small = ft3.core_ext.get_transfer_history(alice.account.id, filter, 10, start_cursor);
    val response_big = ft3.core_ext.get_transfer_history(alice.account.id, filter, 110, start_cursor);
    val expected_data = core.extract_data_from_payment_history_list(
            core.payment_history_entry @* {
                acc.account @ { .id == alice.account.id }
            } (@sort_desc @omit .rowid, $) limit 2
        ) @* {} (.data);
    val expected = core.paged_result(
        next_cursor = null, 
        data = expected_data
    );
    
    assert_equals(response_small, expected);
    assert_equals(ft3.core_ext.get_payment_history_size(alice.account.id), 2);
    assert_equals(response_big, expected);
    assert_true(response_small!!.data.size() == 2);
    assert_true(response_big!!.data.size() == 2);
}

function test_transfer_history() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 0);

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id,
            asset_id = asset.id,
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id = asset.id,
            amount = 1,
            extra = map()
        )
    ];

    utils.mint(alice.account, asset, 5L); //adds one entry to the history

    rell.test.tx()
        .op(ft3.core_ext.transfer(inputs, outputs))
        .op(ft3.core_ext.transfer([inputs[0], inputs[0], inputs[0]], outputs))
        .sign(rell.test.keypairs.alice)
        .run();
    
    val filter = core.filter(null);
    var response = ft3.core_ext.get_transfer_history(alice.account.id, filter, 2, core.encode_cursor(core.page_cursor()));
    var expected_result = core.extract_data_from_payment_history_list(
            core.payment_history_entry @* {
                acc.account @ { .id == alice.account.id }
            } (@sort_desc @omit .rowid, $) limit 2
        );
    var expected_data = expected_result @* {} (.data);
    var next_cursor = core.encode_cursor(core.page_cursor(expected_result[1].rowid));
    var expected = core.paged_result(
        next_cursor = next_cursor,
        data = expected_data
    );
    
    assert_true(expected_result.size() == 2);
    assert_equals(response, expected);

    //vvv entry index, checks if they're ordered LIFO vvv
    val entry_index1 = map<text, gtv>.from_gtv(expected_data[0])['entry_index'];
    assert_equals(entry_index1, (2).to_gtv());

    response = ft3.core_ext.get_transfer_history(alice.account.id, filter, 2, next_cursor);
    expected_result = core.extract_data_from_payment_history_list(
            core.payment_history_entry @* {
                acc.account @ { .id == alice.account.id }
            } (@sort_desc @omit .rowid, $) offset 2 limit 2
        );
    expected_data = expected_result @* {} (.data);
    next_cursor = core.encode_cursor(core.page_cursor(expected_result[1].rowid));;
    expected = core.paged_result(
        next_cursor = next_cursor,
        data = expected_data
    );
    assert_equals(expected_result.size(), 2);
    assert_equals(response, expected);

    val entry_index2 = map<text, gtv>.from_gtv(expected_data[0])['entry_index'];
    assert_equals(entry_index2, (0).to_gtv());

    val entry_index3 = map<text, gtv>.from_gtv(expected_data[1])['entry_index'];
    assert_equals(entry_index3, (0).to_gtv());

    response = ft3.core_ext.get_transfer_history(alice.account.id, filter, 2, next_cursor);
    expected_result = core.extract_data_from_payment_history_list(
            core.payment_history_entry @* {
                acc.account @ { .id == alice.account.id }
            } (@sort_desc @omit .rowid, $) offset 4 limit 2
        );
    expected_data = expected_result @* {} (.data);
    expected = core.paged_result(
        next_cursor = null, 
        data = expected_data
    );
    assert_true(expected_result.size() == 1);
    assert_equals(response, expected);
    assert_equals(ft3.core_ext.get_payment_history_size(alice.account.id), 5);
}

function test_history_filtering() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 0);

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id,
            asset_id = asset.id,
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id = asset.id,
            amount = 1,
            extra = map()
        )
    ];

    utils.mint(alice.account, asset, 5L);

    rell.test.tx()
        .op(ft3.core_ext.transfer(inputs, outputs))
        .sign(rell.test.keypairs.alice)
        .run();

    val cursor = core.encode_cursor(core.page_cursor());
    assert_equals(ft3.core_ext.get_transfer_history(alice.account.id, core.filter(core.transfer_type.sent), 10, cursor)!!.data.size(), 1);
    assert_equals(ft3.core_ext.get_transfer_history(alice.account.id, core.filter(core.transfer_type.received), 10, cursor)!!.data.size(), 1);
    assert_equals(ft3.core_ext.get_transfer_history(bob.account.id, core.filter(core.transfer_type.sent), 10, cursor)!!.data.size(), 0);
    assert_equals(ft3.core_ext.get_transfer_history(bob.account.id, core.filter(core.transfer_type.received), 10, cursor)!!.data.size(), 1);
}

function test_transfer_history_entry() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", "t", 0);

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id,
            asset_id = asset.id,
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id = asset.id,
            amount = 1,
            extra = map()
        )
    ];

    utils.mint(alice.account, asset, 5L);

    rell.test.tx()
        .op(ft3.core_ext.transfer(inputs, outputs))
        .sign(rell.test.keypairs.alice)
        .run();
    
    val entry = core.payment_history_entry @* {}[0];
    assert_equals(
        ft3.core_ext.get_transfer_history_entry(entry.rowid),
        (
            id = '%d'.format(entry.rowid),
            delta = entry.delta,
            decimals = entry.asset.decimals,
            asset = entry.asset.name,
            asset_id = entry.asset.id,
            is_input = entry.is_input,
            timestamp = entry.transaction.block.timestamp,
            block_height = entry.transaction.block.block_height,
            entry_index = entry.entry_index,
            transfer_args = entry.transfer_args,
            tx_rid = entry.transaction.tx_rid,
            tx_data = entry.transaction.tx_data
        )
    );
}
