@test module;
import acc: ^^^.lib.ft3.account;
import ^^^.lib.ft3.operations.dev_op_account;
import ^^^.lib.ft3.operations.dev_op_asset;
import ^^^.lib.ft3.operations.dev_op_balance;
import ^^^.lib.ft3.operations.dev_op_auth;
import cu: ^^.core.utils;

struct module_args {
    admin_priv_key: text; 
}

struct auth_id {
    account_id: byte_array;
    auth_descriptor_id: byte_array;
}

struct auth_data {
    auth_id;
    rell.test.keypair;
}

function create_ft3_test_acc(rell.test.keypair): auth_data {
    val auth_descriptor = create_auth_descriptor(keypair.pub);
    dev_op_account.dev_register_account(auth_descriptor)
        .sign(byte_array(chain_context.args.admin_priv_key))
        .sign(keypair)
        .run();

    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor.hash()
    } ( .account.id );

    return auth_data(
        auth_id(account_id = account, auth_descriptor_id = auth_descriptor.hash()),
        keypair = keypair
    );
}

function get_ft3_test_acc(rell.test.keypair): auth_data {
    val auth_descriptor = create_auth_descriptor(keypair.pub);

    val account = acc.account_auth_descriptor @ {
        .id == auth_descriptor.hash()
    } ( .account.id );

    return auth_data(
        auth_id(account_id = account, auth_descriptor_id = auth_descriptor.hash()),
        keypair = keypair
    );
}

function create_auth_descriptor(pubkey): acc.auth_descriptor {
    return acc.auth_descriptor(
        acc.auth_type.S,
        [
            ["T"].to_gtv(),
            pubkey.to_hex().to_gtv()
        ],
        rules = null.to_gtv());
}

function create_asset(name: text): byte_array {
    dev_op_asset.dev_register_asset(
            name,
            issuing_brid = chain_context.blockchain_rid
        )
        .sign(byte_array(chain_context.args.admin_priv_key))
        .run();

    return (name, chain_context.blockchain_rid).hash();
}

function give_balance(asset_id: byte_array, account_id: byte_array, amount:integer) {
    rell.test.tx()
        .op(dev_op_balance.dev_give_balance(asset_id, account_id, amount))
        .sign(byte_array(chain_context.args.admin_priv_key))
        .run();
}

function auth(account_id:byte_array, auth_descriptor_id:byte_array, required_flags:list<text>, keypairs: list<rell.test.keypair>) {
    rell.test.tx()
        .op(dev_op_auth.dev_auth(account_id, auth_descriptor_id, required_flags))
        .sign(byte_array(chain_context.args.admin_priv_key))
        .sign(keypairs)
        .run();
}

/*
 * Looks up the "account Auth Desc" and uses the found id to build the "auth_id" struct.
 */
function _build_auth_id(auth_desc_id: byte_array) {
    val account = acc.account_auth_descriptor @ {
        .id == auth_desc_id 
    } ( .account.id );

    return auth_id(account_id = account, auth_descriptor_id = auth_desc_id);
}

/*
 * Creates a single sig Auth Desc.
 *
 * returns "auth_data"
 */
function _create_test_acc_from_auth_desc_single_sig(rell.test.keypair, acc.auth_descriptor): auth_data {
    dev_op_account.dev_register_account(auth_descriptor)
        .sign(byte_array(chain_context.args.admin_priv_key))
        .sign(keypair)
        .run();

    return auth_data(
        _build_auth_id(auth_descriptor.hash()),
        keypair = keypair
    ); 
}


/*
 * Creates a multi sig Auth Desc.
 *
 * returns "auth_data"
 */
function _create_test_acc_from_auth_desc_multi_sig(keys: list<rell.test.keypair>, acc.auth_descriptor): auth_data {
    val op = dev_op_account.dev_register_account(auth_descriptor);
    val admin_privkey = byte_array(chain_context.args.admin_priv_key);
    val admin_keypair = rell.test.keypair(
        priv=admin_privkey, 
        pub=crypto.privkey_to_pubkey(admin_privkey, true)
    );
    keys.add(admin_keypair);
    var tx = _sign_many(op, keys); 
    tx.run();

    return auth_data(
        _build_auth_id(auth_descriptor.hash()),
        keypair = keys[0] // Doesn't matter much which we use
    ); 
}

function _sign_many(op: rell.test.op, keys: list<rell.test.keypair>) {
    var tx: rell.test.tx = op.sign(keys[0]); // Yeah, it's ugly but it was hard to get the types right.
    var i = 0;
    for (k in keys) {
        if (i > 0) {
            tx = tx.sign(k);
        }
        i += 1;
    }    
    return tx;
}

function add_auth_op(rell.test.tx, message: text) {
    return tx
        .op(dev_op_auth.dev_authenticated_operation(message))
        .sign(byte_array(chain_context.args.admin_priv_key));
}

function perform_large_transfer(rell.test.tx, amount: integer, to_address: text) {
    return tx
        .op(dev_op_auth.dev_perform_large_transfer(1000, to_address))
        .sign(byte_array(chain_context.args.admin_priv_key));
}