@test
module;

import ^^^.main.*;
import ^^.extensions.*;
import ^^^.lib.ft3.core;
import acc: ^^^.lib.ft3.account;
import core: ^^^.lib.ft3.core;
import ^.utils;
import ^^.rell;

function test_before_transfer_extension_is_called() {
    val acc_data_1 = utils.create_ft3_test_acc(rell.test.keypair.alice).auth_id;
    val acc_data_2 = utils.create_ft3_test_acc(rell.test.keypair.bob).auth_id;
    val asset_id = create core.asset(
            id = ("test", chain_context.blockchain_rid).hash(), 
            name = "test", 
            issuing_chain_rid = chain_context.blockchain_rid)
        .id;

    val inputs = list<core.xfer_input>();
    inputs.add(
        core.xfer_input(
            account_id = acc_data_1.account_id, 
            asset_id, 
            auth_descriptor_id = acc_data_1.auth_descriptor_id,
            1,
            extra = map()
        )
    );

    val outputs = list<core.xfer_output>();
    outputs.add(
        core.xfer_output(
            account_id = acc_data_2.account_id, 
            asset_id = asset_id, 
            amount = 1,
            extra = map()
        )
    );

    core._transfer(inputs, outputs);
    
    assert_true(transfer_extensions_state.is_before_transfer_called);
    assert_equals(transfer_extensions_state.before_transfer_arg_inputs, inputs.to_gtv().to_bytes());
    assert_equals(transfer_extensions_state.before_transfer_arg_outputs, outputs.to_gtv().to_bytes());
}

function test_after_transfer_extension_is_called() {
    val acc_data_1 = utils.create_ft3_test_acc(rell.test.keypair.alice).auth_id;
    val acc_data_2 = utils.create_ft3_test_acc(rell.test.keypair.bob).auth_id;
    val asset_id = create core.asset(
            id = ("test", chain_context.blockchain_rid).hash(), 
            name = "test", 
            issuing_chain_rid = chain_context.blockchain_rid)
        .id;

    val inputs = list<core.xfer_input>();
    inputs.add(
        core.xfer_input(
            account_id = acc_data_1.account_id, 
            asset_id, 
            auth_descriptor_id = acc_data_1.auth_descriptor_id,
            1,
            extra = map()
        )
    );

    val outputs = list<core.xfer_output>();
    outputs.add(
        core.xfer_output(
            account_id = acc_data_2.account_id, 
            asset_id = asset_id, 
            amount = 1,
            extra = map()
        )
    );

    core._transfer(inputs, outputs);
    
    assert_true(transfer_extensions_state.is_after_transfer_called);
    assert_equals(transfer_extensions_state.after_transfer_arg_inputs, inputs.to_gtv().to_bytes());
    assert_equals(transfer_extensions_state.after_transfer_arg_outputs, outputs.to_gtv().to_bytes());
}
