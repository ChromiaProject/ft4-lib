@test
module;

import ^^^.lib.ft3.auth;
import ^^^.main.*;
import ^^.extensions.*;
import ^^^.lib.ft3.ft3_basic_dev.*;
import ^^^.lib.ft3.operations.dev_op_balance;
import ^^^.lib.ft3.auth;
import ^.utils;

function test_before_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset_id = utils.create_asset("test", 1).id;

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id,
            asset_id,
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id,
            amount = 1,
            extra = map()
        )
    ];

    rell.test.tx()
        .op(dev_op_balance.dev_give_balance(asset_id, alice.account.id, 1))
        .op(ft3.transfer_op.transfer(inputs, outputs))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_before_transfer_called);
    assert_equals(transfer_extensions_state.before_transfer_arg_inputs, inputs.to_gtv().to_bytes());
    assert_equals(transfer_extensions_state.before_transfer_arg_outputs, outputs.to_gtv().to_bytes());
}

function test_after_transfer_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset_id = utils.create_asset("test", 1).id;

    val inputs = [
        core.xfer_input(
            account_id = alice.account.id, 
            asset_id, 
            auth_descriptor_id = alice.auth_descriptor_id,
            amount = 1,
            extra = map()
        )
    ];

    val outputs = [
        core.xfer_output(
            account_id = bob.account.id, 
            asset_id,
            amount = 1,
            extra = map()
        )
    ];

    rell.test.tx()
        .op(dev_op_balance.dev_give_balance(asset_id, alice.account.id, 1))
        .op(ft3.transfer_op.transfer(inputs, outputs))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_true(transfer_extensions_state.is_after_transfer_called);
    assert_equals(transfer_extensions_state.after_transfer_arg_inputs, inputs.to_gtv().to_bytes());
    assert_equals(transfer_extensions_state.after_transfer_arg_outputs, outputs.to_gtv().to_bytes());
}

function test_transfer_fails_when_insufficient_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 10);

    val tx = rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 11))
        .sign(alice.keypair);

    utils.assert_error(tx, "Balance is too low");
}

function test_transfer_fails_when_balance_is_negative() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 10);

    val tx = rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, -1))
        .sign(alice.keypair);

    utils.assert_error(tx, "Expected amount greater than 0. Found -1");
}

function test_transfer_fails_when_sender_is_same_as_receiver() {
    val alice = utils.register_alice();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 10);

    val tx = rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(alice.account.id, asset.id, 5))
        .sign(alice.keypair);

    utils.assert_error(tx, "Sender and reciver have to be different");
}

function test_transfer_succeeds_when_enough_balance() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 3))
        .sign(alice.keypair)
        .run();

    assert_equals(core.ensure_balance(alice.account, asset).amount, 7);
    assert_equals(core.ensure_balance(bob.account, asset).amount, 3);
}

function test_transfer_fails_when_auth_descriptor_does_not_have_transfer_flag() {
    assert_true(false);
}

function test_evm_authenticated_transfer_succeeds_when_enough_balance() {
    val alice = utils.evm_register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 15);

    val auth_data = ft3.transfer_op.transfer_one_auth_data(
        [
            bob.account.id.to_gtv(), 
            asset.id.to_gtv(), 
            (5L).to_gtv()
        ].to_gtv()
    );

    print(auth.auth_handler().keys());
    print(ft3.transfer_op.get_auth_handler_keys());
    val receiver_id = bob.account.id;
    val asset_id = asset.id;
    val amount = 5L;

    val message = utils.create_auth_message(auth_data.message, alice);
    // val message2 = auth.get_auth_message_template(
    //     "ft3.transfer_one", 
    //     [
    //         receiver_id.to_gtv(), 
    //         asset_id.to_gtv(), 
    //         amount.to_gtv()
    //     ].to_gtv()
    // );

    val signature = utils.metamask_sign(message, alice.keypair.priv);

    rell.test.tx()
        .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 5))
        .run();

    assert_equals(core.ensure_balance(alice.account, asset).amount, 10);
    assert_equals(core.ensure_balance(bob.account, asset).amount, 5);
}

function test_evm_authenticated_transfer_fails_when_signature_is_not_created_by_sender() {
    val alice = utils.evm_register_alice();
    val bob = utils.evm_register_bob();

    val asset = utils.create_asset("test", 1);
    utils.mint_to_account(alice, asset, 15);

    val auth_data = ft3.transfer_op.transfer_one_auth_data(
        [
            bob.account.id.to_gtv(), 
            asset.id.to_gtv(), 
            (10L).to_gtv()
        ].to_gtv()
    );

    val message = utils.create_auth_message(auth_data.message, alice);
    val invalid_signature = utils.metamask_sign(message, bob.keypair.priv);

    val tx = rell.test.tx()
        .op(auth.evm_auth(alice.account.id, alice.auth_descriptor_id, [invalid_signature]))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 10));

    utils.assert_error(tx, "Invalid signature");
}

function test_before_transfer_one_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("CHR", 9);
    utils.mint_to_account(alice, asset, 100);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 50))
        .sign(alice.keypair)
        .run();

    assert_true(transfer_one_extensions_state.is_before_transfer_called);
    assert_equals(transfer_one_extensions_state.before_transfer_from_account_id, alice.account.id);
    assert_equals(transfer_one_extensions_state.before_transfer_to_account_id, bob.account.id);
    assert_equals(transfer_one_extensions_state.before_transfer_asset_id, asset.id);
    assert_equals(transfer_one_extensions_state.before_transfer_amount, 50);
}

function test_after_transfer_one_extension_is_called() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();

    val asset = utils.create_asset("TEST", 3);
    utils.mint_to_account(alice, asset, 20);

    rell.test.tx()
        .op(auth.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft3.transfer_op.transfer_one(bob.account.id, asset.id, 15))
        .sign(alice.keypair)
        .run();

    assert_true(transfer_one_extensions_state.is_after_transfer_called);
    assert_equals(transfer_one_extensions_state.after_transfer_from_account_id, alice.account.id);
    assert_equals(transfer_one_extensions_state.after_transfer_to_account_id, bob.account.id);
    assert_equals(transfer_one_extensions_state.after_transfer_asset_id, asset.id);
    assert_equals(transfer_one_extensions_state.after_transfer_amount, 15);
}
