@test
module;

import ^^^.lib.ft4.accounts;

function assert_rule_result(
  variable: text,
  operator: text,
  value: integer,
  op_count: integer = 0,
  height: integer = 0,
  time: integer = 0, 
  result: boolean = true
) {
  val rule = accounts.rule_expression(variable, operator, value = value.to_gtv());
  val rule_variables = map<text, gtv>();
  rule_variables["op_count"] = op_count.to_gtv();

  assert_equals(
    accounts.evaluate_int_variable_rule(
      rule,
      rule_variables,
      height,
      time
    ),
    result
  );
}

namespace test_block_height {
  function test_block_height_rule_gt_works() {
    assert_rule_result(
      "block_height", "gt", 2,
      height = 3, result = true
    );
  }

  function test_block_height_rule_gt_fails() {
    assert_rule_result(
      "block_height", "gt", 2,
      height = 1, result = false
    );
  }

  function test_block_height_rule_ge_works() {
    assert_rule_result(
      "block_height", "ge", 2,
      height = 3, result = true
    );
    assert_rule_result(
      "block_height", "ge", 3,
      height = 3, result = true
    );
  }

  function test_block_height_rule_ge_fails() {
    assert_rule_result(
      "block_height", "ge", 2,
      height = 1, result = false
    );
  }

  function test_block_height_rule_eq_works() {
    assert_rule_result(
      "block_height", "eq", 2,
      height = 2, result = true
    );
  }

  function test_block_height_rule_eq_fails() {
    assert_rule_result(
      "block_height", "eq", 2,
      height = 1, result = false
    );
  }

  function test_block_height_rule_le_works() {
    assert_rule_result(
      "block_height", "le", 3,
      height = 3, result = true
    );
    assert_rule_result(
      "block_height", "le", 3,
      height = 2, result = true
    );
  }

  function test_block_height_rule_le_fails() {
    assert_rule_result(
      "block_height", "le", 2,
      height = 3, result = false
    );
  }

  function test_block_height_rule_lt_works() {
    assert_rule_result(
      "block_height", "lt", 2,
      height = 1, result = true
    );
  }

  function test_block_height_rule_lt_fails() {
    assert_rule_result(
      "block_height", "lt", 3,
      height = 4, result = false
    );
  }
}

