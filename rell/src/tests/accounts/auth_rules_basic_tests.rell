namespace test_op_count {
  function test_op_count_rule_gt_works() {
    assert_rule_result(
      greater_than(op_count(2)),
      op_count = 3, result = true
    );
  }

  function test_op_count_rule_gt_fails() {
    assert_rule_result(
      greater_than(op_count(2)),
      op_count = 1, result = false
    );
  }

  function test_op_count_rule_ge_works() {
    assert_rule_result(
      greater_or_equal(op_count(2)),
      op_count = 3, result = true
    );
    assert_rule_result(
      greater_or_equal(op_count(3)),
      op_count = 3, result = true
    );
  }

  function test_op_count_rule_ge_fails() {
    assert_rule_result(
      greater_or_equal(op_count(2)),
      op_count = 1, result = false
    );
  }

  function test_op_count_rule_eq_works() {
    assert_rule_result(
      equals(op_count(2)),
      op_count = 2, result = true
    );
  }

  function test_op_count_rule_eq_fails() {
    assert_rule_result(
      equals(op_count(2)),
      op_count = 1, result = false
    );
  }

  function test_op_count_rule_le_works() {
    assert_rule_result(
      less_or_equal(op_count(3)),
      op_count = 3, result = true
    );
    assert_rule_result(
      less_or_equal(op_count(3)),
      op_count = 2, result = true
    );
  }

  function test_op_count_rule_le_fails() {
    assert_rule_result(
      less_or_equal(op_count(2)),
      op_count = 3, result = false
    );
  }

  function test_op_count_rule_lt_works() {
    assert_rule_result(
      less_than(op_count(2)),
      op_count = 1, result = true
    );
  }

  function test_op_count_rule_lt_fails() {
    assert_rule_result(
      less_than(op_count(3)),
      op_count = 4, result = false
    );
  }
}

function test_it_creates_gtv_from_single_rule() {
  val expr = less_than(op_count(1));
  assert_equals(
    serialize_rules([expr]),
    [
      rule_operator.lt.name.to_gtv(),
      rule_variable.op_count.name.to_gtv(),
      0x1.to_gtv()
    ].to_gtv()
  );
}

function test_it_creates_gtv_from_multiple_rules() {
  val expr1 = less_than(op_count(1));
  val expr2 = less_than(op_count(2));
  assert_equals(
    serialize_rules([expr1, expr2]),
    [
      "and".to_gtv(),
      [
        rule_operator.lt.name.to_gtv(),
        rule_variable.op_count.name.to_gtv(),
        0x1.to_gtv()
      ].to_gtv(),
      [
        rule_operator.lt.name.to_gtv(),
        rule_variable.op_count.name.to_gtv(),
        0x2.to_gtv()
      ].to_gtv()
    ].to_gtv()
  );
}

function test_it_creates_gtv_from_no_rules() {
  assert_equals(
    serialize_rules([]),
    null.to_gtv()
  );
}
