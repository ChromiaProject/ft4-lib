@test
module;

import ^^^.lib.ft4.accounts.{
  rule_expression,
  rule_variable,
  rule_operator,
  serialize_rules,
  is_rule_violated,
  block_height,
  block_time,
  op_count,
  less_than,
  less_or_equal,
  equals,
  greater_than,
  greater_or_equal
};

function assert_rule_result(
  rule: rule_expression,
  op_count: integer = 0,
  height: integer = 0,
  time: integer = 0, 
  result: boolean = true
) {
  val rule_variables = map<text, gtv>();

	rule_variables[rule_variable.op_count.name] = op_count.to_gtv();
	rule_variables[rule_variable.block_height.name] = height.to_gtv();
	rule_variables[rule_variable.block_time.name] = time.to_gtv();

  assert_equals(
    is_rule_violated(
      rule,
      rule_variables
    ),
    not result
  );
}

namespace test_block_height {
  function test_block_height_rule_gt_works() {
    assert_rule_result(
      greater_than(block_height(2)),
      height = 3, result = true
    );
  }

  function test_block_height_rule_gt_fails() {
    assert_rule_result(
      greater_than(block_height(2)),
      height = 1, result = false
    );
  }

  function test_block_height_rule_ge_works() {
    assert_rule_result(
      greater_or_equal(block_height(2)),
      height = 3, result = true
    );
    assert_rule_result(
      greater_or_equal(block_height(3)),
      height = 3, result = true
    );
  }

  function test_block_height_rule_ge_fails() {
    assert_rule_result(
      greater_or_equal(block_height(2)),
      height = 1, result = false
    );
  }

  function test_block_height_rule_eq_works() {
    assert_rule_result(
      equals(block_height(2)),
      height = 2, result = true
    );
  }

  function test_block_height_rule_eq_fails() {
    assert_rule_result(
      equals(block_height(2)),
      height = 1, result = false
    );
  }

  function test_block_height_rule_le_works() {
    assert_rule_result(
      less_or_equal(block_height(3)),
      height = 3, result = true
    );
    assert_rule_result(
      less_or_equal(block_height(3)),
      height = 2, result = true
    );
  }

  function test_block_height_rule_le_fails() {
    assert_rule_result(
      less_or_equal(block_height(2)),
      height = 3, result = false
    );
  }

  function test_block_height_rule_lt_works() {
    assert_rule_result(
      less_than(block_height(2)),
      height = 1, result = true
    );
  }

  function test_block_height_rule_lt_fails() {
    assert_rule_result(
      less_than(block_height(3)),
      height = 4, result = false
    );
  }
}

