@test module;

import acc: ^^^.lib.ft4.accounts;
import test_utils: ^^.assets.utils;
import test_op: ^^.operations;

function test_too_many_account_descriptor_rules() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.gt, 1),
      acc.rule_expression(acc.rule_variable.block_time, acc.rule_operator.lt, 10),
      acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.gt, 2),
      acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.lt, 4)
  ]))
    .run_must_fail("Too many rules");
}

function test_valid_combinator() {
  rules_test([
    "and".to_gtv(),
    acc.rule_expression_to_gtv(acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.lt, 5))
  ].to_gtv())
    .run();
}

function test_invalid_combinator() {
  rules_test([
    "bogus".to_gtv(),
    acc.rule_expression_to_gtv(acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.lt, 5))
  ].to_gtv())
    .run_must_fail();
}

function test_block_height_negative() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.gt, -1)
  ]))
    .run_must_fail("rule variable block_height must be a non-negative value");
}

function test_block_time_negative() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_time, acc.rule_operator.gt, -1)
  ]))
    .run_must_fail("rule variable block_time must be a non-negative value");
}

function test_op_count_gt() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.gt, 1)
  ]))
    .run_must_fail("rule variable op_count must be lt or le");
}

function test_op_count_non_positive() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.op_count, acc.rule_operator.lt, 0)
  ]))
    .run_must_fail("rule variable op_count must be a positive value");
}

function test_inactive() {
  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.gt, 2),
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.lt, 4)
  ]))
    .run();
}

function test_active_and_valid() {
  rell.test.block().run();

  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.gt, 2),
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.lt, 4)
  ]))
    .run();
}

function test_active_and_invalid() {
  rell.test.block().run();
  rell.test.block().run();

  rules_test(acc.serialize_rules([
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.gt, 2),
      acc.rule_expression(acc.rule_variable.block_height, acc.rule_operator.lt, 4)
  ]))
    .run_must_fail("Active and invalid rules detected");
}

function rules_test(rules: gtv) {
  val account = test_utils.register_alice().account;
  val bob_ad = test_utils.create_auth_descriptor(rell.test.keypairs.bob.pub, rules = rules);
  return rell.test.tx().op(test_op.add_ad_to_account(account, bob_ad)).sign(rell.test.keypairs.bob);
}
