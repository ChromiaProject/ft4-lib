@test
module;

import cu: ^^.assets.utils;
import acc: ^^^.lib.ft4.accounts;
import ^^^.lib.ft4.ft4_basic_dev.*;
import ^^^.lib.ft4.operations.dev_op_auth;

/*
 * We aim to unit test the basic authentication rules (e.g. the number of signatures and required flags).
 *
 * Note: 
 * Ideally this should be simple unit tests, but since we have "op_context.is_signer()" inside the auth logic,
 * the code must come from a signed transaction, so we added a new method for this in the "dev_op_auth.rell" file.
 * We also have to go the roundabout way of storing the returned error message in a global object "dev_error".
 */

function required_flags() = ["T"];  


function test_multi_sig_valid_1_of_1() {
    val alice = cu._create_test_acc_from_auth_desc_multi_sig(
        [rell.test.keypairs.alice], 
        good_ad_1_of_1()
    );

    rell.test.tx()
        .op(dev_op_auth.dev_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .sign(rell.test.keypairs.alice) 
        .run();

    assert_equals(dev_op_auth.dev_error.msg, "valid");
}

function test_multi_sig_valid_2_of_2_signs() {
    val account_data = cu._create_test_acc_from_auth_desc_multi_sig(
        [rell.test.keypairs.alice, rell.test.keypairs.bob], 
        good_ad_2_of_2()
    );

    rell.test.tx()
        .op(dev_op_auth.dev_auth(
            account_data.account.id,
            account_data.auth_descriptor_id,
            required_flags()
        ))
        .sign(rell.test.keypairs.alice)
        .sign(rell.test.keypairs.bob)
        .run();

    assert_equals(dev_op_auth.dev_error.msg, "valid");
}

function test_multi_sig_valid_1_of_2_signs() {
    val account_data = cu._create_test_acc_from_auth_desc_multi_sig(
        [rell.test.keypairs.alice, rell.test.keypairs.bob], 
        good_ad_1_of_2() // <-- Only one required
    );

    rell.test.tx()
        .op(dev_op_auth.dev_auth(
            account_data.account.id,
            account_data.auth_descriptor_id,
            required_flags()
        ))
        .sign(rell.test.keypairs.bob) // <-- Omitting Alice should work
        .run();

    assert_equals(dev_op_auth.dev_error.msg, "valid");
}

function test_multi_sig_valid_3_of_3_signs() {
    val account_data = cu._create_test_acc_from_auth_desc_multi_sig(
        [rell.test.keypairs.alice, rell.test.keypairs.bob, rell.test.keypairs.trudy], 
        good_ad_3_of_3()
    );

    rell.test.tx()
        .op(dev_op_auth.dev_auth(account_data.account.id,
        account_data.auth_descriptor_id,
        required_flags()
    ))
        .sign(rell.test.keypairs.alice)
        .sign(rell.test.keypairs.bob)
        .sign(rell.test.keypairs.trudy)
        .run();

    assert_equals(dev_op_auth.dev_error.msg, "valid");
}

function test_multi_sig_wrong_required_flags() {
    val account_data = cu._create_test_acc_from_auth_desc_multi_sig(
        [rell.test.keypairs.alice, rell.test.keypairs.bob], 
        good_ad_2_of_2()
    );

    val bad_required_flags = ["A"]; // <---- Default test Auth Desc doesn't have "A"!!

    rell.test.tx()
        .op(dev_op_auth.dev_auth(
            account_data.account.id,
            account_data.auth_descriptor_id,
            bad_required_flags
        ))
        .sign(rell.test.keypairs.alice)
        .sign(rell.test.keypairs.bob)
        .run();

    assert_equals(dev_op_auth.dev_error.msg, "Some required flags [A] are missing on the (multi sig) Auth Descriptor.");
}

// ----- util -----

function good_ad_1_of_1() = create_auth_descriptor_M_1_pub(
        rell.test.keypairs.alice.pub
);

function good_ad_1_of_2() = create_auth_descriptor_M_2_pub(
        rell.test.keypairs.alice.pub, 
        rell.test.keypairs.bob.pub,
        1 // <--- should work too
);

function good_ad_2_of_2() = create_auth_descriptor_M_2_pub(
        rell.test.keypairs.alice.pub, 
        rell.test.keypairs.bob.pub,
        2 // <-- Two signers required
);

function good_ad_3_of_3() = create_auth_descriptor_M_3_pub(
        rell.test.keypairs.alice.pub, 
        rell.test.keypairs.bob.pub,
        rell.test.keypairs.trudy.pub,
        3 // <--- Will work
);


/*
 * This valid Auth Desc has only one pub key despite being "M".
 */
function create_auth_descriptor_M_1_pub(pubkey): acc.auth_descriptor {
    val number_of_sigs = 1;
    return acc.auth_descriptor(
        acc.auth_type.M,
        [
            ["T"].to_gtv(),
            number_of_sigs.to_gtv(), 
            [ pubkey.to_hex().to_gtv() ].to_gtv()
        ],
        rules = null.to_gtv());
}

/*
 * A normal Auth Desc with 2 participants.
 */
function create_auth_descriptor_M_2_pub(pubkey1: pubkey, pubkey2: pubkey, required_signs: integer): acc.auth_descriptor {
    return acc.auth_descriptor(
        acc.auth_type.M,
        [
            ["T"].to_gtv(),
            required_signs.to_gtv(), 
            [ pubkey1.to_hex().to_gtv(), pubkey2.to_hex().to_gtv()].to_gtv()
        ],
        rules = null.to_gtv());
}

/*
 * A normal Auth Desc with 3 participants.
 */
function create_auth_descriptor_M_3_pub(pubkey1: pubkey, pubkey2: pubkey, pubkey3: pubkey, required_signs: integer): acc.auth_descriptor {
    return acc.auth_descriptor(
        acc.auth_type.M,
        [
            ["T"].to_gtv(),
            required_signs.to_gtv(), 
            [ pubkey1.to_hex().to_gtv(), pubkey2.to_hex().to_gtv(), pubkey3.to_hex().to_gtv()].to_gtv()
        ],
        rules = null.to_gtv());
}



