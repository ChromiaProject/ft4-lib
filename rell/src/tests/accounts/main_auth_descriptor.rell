@test
module;

import lib.ft4.auth;
import lib.ft4.accounts;
import test_utils: lib.ft4.test.utils;

import ^^.assets.utils;

function test_update_main_auth_descriptor_can_replace_ft_with_ft_auth_descriptor() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);

    val current_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(current_main_auth_descriptor.id, alice.auth_descriptor_id);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(alice.keypair)
        .sign(rell.test.keypairs.bob)
        .run();

    val new_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(new_main_auth_descriptor.id, auth_descriptor.hash());
}

function test_update_main_auth_descriptor_deletes_old_main_auth_descriptor() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(alice.keypair)
        .sign(rell.test.keypairs.bob)
        .run();

    val old_auth_descriptor = accounts.account_auth_descriptor @? { alice.account, .id == alice.auth_descriptor_id };
    assert_null(old_auth_descriptor);
}

function test_update_main_auth_descriptor_can_replace_evm_with_evm_auth_descriptor() {
    val alice = utils.evm_register_alice();
    val address1 = crypto.eth_privkey_to_address(alice.keypair.priv); 
    val address2 = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
    val auth_descriptor = test_utils.create_auth_descriptor(address2, ["A", "T"]);

    val op = accounts.external.update_main_auth_descriptor(auth_descriptor);
    val message = utils.create_evm_auth_message(op, auth.external.get_auth_message_template(op.name, op.args.to_gtv()), alice);

    val signature1 = test_utils.evm_sign(message, alice.keypair.priv);
    val signature2 = test_utils.evm_sign(message, rell.test.keypairs.bob.priv);

    val current_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(current_main_auth_descriptor.id, alice.auth_descriptor_id);

    rell.test.tx()
        .op(auth.external.evm_signatures([address2], [signature2]))
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature1]))
        .op(op)
        .run();

    val new_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(new_main_auth_descriptor.id, auth_descriptor.hash());
}

function test_update_main_auth_descriptor_can_replace_evm_with_ft_auth_descriptor() {
    val alice = utils.evm_register_alice();
    val address = crypto.eth_privkey_to_address(alice.keypair.priv); 
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);

    val op = accounts.external.update_main_auth_descriptor(auth_descriptor);
    val message = utils.create_evm_auth_message(op, auth.external.get_auth_message_template(op.name, op.args.to_gtv()), alice);

    val signature = test_utils.evm_sign(message, alice.keypair.priv);

    rell.test.tx()
        .op(auth.external.evm_auth(alice.account.id, alice.auth_descriptor_id, [signature]))
        .op(op)
        .sign(rell.test.keypairs.bob)
        .run();

    val new_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(new_main_auth_descriptor.id, auth_descriptor.hash());    
}

function test_update_main_auth_descriptor_can_replace_ft_with_evm_auth_descriptor() {
    val alice = utils.register_alice();
    val address = crypto.eth_privkey_to_address(rell.test.keypairs.bob.priv);
    val auth_descriptor = test_utils.create_auth_descriptor(address, ["A", "T"]);

    val op = accounts.external.update_main_auth_descriptor(auth_descriptor);
    val message = utils.create_evm_auth_message(op, auth.external.get_auth_message_template(op.name, op.args.to_gtv()), alice);

    val signature = test_utils.evm_sign(message, rell.test.keypairs.bob.priv);

    val current_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(current_main_auth_descriptor.id, alice.auth_descriptor_id);

    rell.test.tx()
        .op(auth.external.evm_signatures([address], [signature]))
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(op)
        .sign(alice.keypair)
        .run();

    val new_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(new_main_auth_descriptor.id, auth_descriptor.hash());
}

function test_update_main_auth_descriptor_fails_when_new_main_auth_descriptor_does_not_sign_transaction() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);

    val current_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(current_main_auth_descriptor.id, alice.auth_descriptor_id);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(alice.keypair)
        .run_must_fail("Missing signature for public key <%s>".format(rell.test.pubkeys.bob));
}

function test_update_main_auth_descriptor_fails_when_current_main_auth_descriptor_does_not_sign_transaction() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"]);

    val current_main_auth_descriptor = accounts.main_auth_descriptor @ { alice.account } .auth_descriptor;
    assert_equals(current_main_auth_descriptor.id, alice.auth_descriptor_id);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(rell.test.keypairs.bob)
        .run_must_fail("The auth descriptor signer did not sign the transaction.");
}

function test_delete_auth_descriptor_fails_for_main_auth_descriptor() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.delete_auth_descriptor(alice.auth_descriptor_id))
        .sign(alice.keypair)
        .run_must_fail("Cannot delete main auth descriptor");
}

function test_delete_auth_descriptors_for_signer_fails_for_main_auth_descriptor_signer() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.delete_auth_descriptors_for_signer(alice.keypair.pub))
        .sign(alice.keypair)
        .run_must_fail("Cannot delete main auth descriptor");
}

function test_update_main_auth_descriptor_fails_if_new_auth_descriptor_miss_mandatory_flags() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["T"]);

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(alice.keypair)
        .sign(rell.test.keypairs.bob)
        .run_must_fail("Some of mandatory flags <[A, T]> missing, found only <[T]>");
}

function test_update_main_auth_descriptor_fails_if_new_auth_descriptor_is_restricted() {
    val alice = utils.register_alice();
    val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"],
        [
            "and".to_gtv(),
            accounts.rule_expression_to_gtv(accounts.rule_expression(accounts.rule_variable.op_count, accounts.rule_operator.lt, 5))
        ].to_gtv());

    rell.test.tx()
        .op(alice.ft_auth())
        .op(accounts.external.update_main_auth_descriptor(auth_descriptor))
        .sign(alice.keypair)
        .sign(rell.test.keypairs.bob)
        .run_must_fail("Main auth descriptor cannot be restricted");
}
