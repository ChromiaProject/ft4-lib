@test
module;

import lib.ft4.auth;
import lib.ft4.admin;
import lib.ft4.accounts;
import ^^.assets.utils;
import test_op: ^^.operations.auth;
import ^.rate_limit_helpers;
import test_utils: lib.ft4.test.utils;

function test_create_account_in_genesis_block() {
  val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);

  admin.external.register_account(auth_descriptor)
      .sign(utils.admin_priv_key())
      .run();

    val account = accounts.account_auth_descriptor @ {
        .id == auth_descriptor.hash()
    } ( .account );

    assert_equals(accounts.rl_state @ { .account == account } (.last_update), 0);
}

function test_create_account_after_genesis_block() {
  val auth_descriptor = test_utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A", "T"]);

  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  admin.external.register_account(auth_descriptor)
      .sign(utils.admin_priv_key())
      .run();

    val account = accounts.account_auth_descriptor @ {
        .id == auth_descriptor.hash()
    } ( .account );

    assert_equals(accounts.rl_state @ { .account == account } (.last_update), rell.test.DEFAULT_FIRST_BLOCK_TIME);
}

function test_rate_limit_points_increased_after_authenticated_operation_and_time_passed() {
  rell.test.set_block_interval(10000); // set block interval to 10 seconds

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A", "T"]);

  val rl_points_before = accounts.rl_state @ { .account == alice.account } (.points);
  assert_equals(rl_points_before, 1);

  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .sign(rell.test.keypairs.alice)
      .run();

  // Check if the points have increased after the transaction, indicating that the rate_limit function was called
  assert_equals(accounts.rl_state @ { .account == alice.account } (.points), rl_points_before + 1);
}

function test_authenticated_operation_is_rate_limited() {
  rell.test.set_block_interval(1000); // set block interval to 1 second

  assert_equals(accounts.get_rate_limit_config().active, true);
  assert_equals(accounts.get_rate_limit_config().points_at_account_creation, 1);

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A", "T"]);

  // Perform the transaction
  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();

  // Attempt to perform the transaction again quickly
  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run_must_fail("Insufficient rate limiter points");

  // Wait for a while to regain rate limit points
  for (_ in range(4)) {
    rell.test.block().run();
  }

  // Perform the transaction after a while
  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();
}

function test_max_rate_limit_points() {
  rell.test.set_block_interval(1000); // set block interval to 1 second

  assert_equals(accounts.get_rate_limit_config().active, true);
  assert_equals(accounts.get_rate_limit_config().points_at_account_creation, 1);

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A", "T"]);

  // Wait for long time to accumulate maximum amount of points
  for (_ in range(25)) {
    rell.test.block().run();
  }

  // Perform the transaction multiple times after a long time
  rell.test.tx()
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .nop()
     .sign(rell.test.keypairs.alice)
     .run();

  // Wait for long time to accumulate maximum amount of points
  for (_ in range(25)) {
    rell.test.block().run();
  }

  // Cannot get more than 5 points
  rell.test.tx()
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .nop()
     .sign(rell.test.keypairs.alice)
     .run_must_fail("Insufficient rate limiter points");
}

function test_disable_rate_limit_for_account() {
  rell.test.set_block_interval(1000); // set block interval to 1 second

  assert_equals(accounts.get_rate_limit_config().active, true);
  assert_equals(accounts.get_rate_limit_config().points_at_account_creation, 1);

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A", "T"]);

  rell.test.tx()
      .op(rate_limit_helpers.set_admin_account(alice.account))
      .run();

  // Perform the transaction
  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();

  // Attempt to perform the transaction again quickly
  rell.test.tx()
      .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();
}
