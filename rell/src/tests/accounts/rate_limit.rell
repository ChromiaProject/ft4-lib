@test
module;

import ^^.assets.utils;
import auth_ext: ^^^.lib.ft4.auth.external;
import acc: ^^^.lib.ft4.accounts;
import test_op: ^^.operations.auth;
import ^^^.lib.ft4.admin;

function test_create_account_in_genesis_block_is_not_allowed() {
  val auth_descriptor = utils.create_auth_descriptor(rell.test.pubkeys.alice, ["A"]);

  admin.register_account(auth_descriptor)
      .sign(utils.admin_priv_key())
      .sign(rell.test.keypairs.alice)
      .run_must_fail("Cannot create account in genesis block");
}

function test_rate_limit_points_increased_after_authenticated_operation_and_time_passed() {
  rell.test.set_block_interval(10000); // set block interval to 10 seconds

  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A"]);

  val rl_points_before = acc.rl_state @ { .account == alice.account } (.points);
  assert_equals(rl_points_before, 1);

  rell.test.tx()
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .sign(rell.test.keypairs.alice)
      .run();

  // Check if the points have increased after the transaction, indicating that the rate_limit function was called
  assert_equals(acc.rl_state @ { .account == alice.account } (.points), rl_points_before + 1);
}

function test_authenticated_operation_is_rate_limited() {
  rell.test.set_block_interval(1000); // set block interval to 1 second

  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A"]);

  // Get rate_limit points before the transaction
  val rl_points_before = acc.rl_state @ { .account == alice.account } (.points);

  // Perform the transaction
  rell.test.tx()
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();

  // Attempt to perform the transaction again quickly
  rell.test.tx()
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run_must_fail("Insufficient rate limiter points");

  // Wait for a while
  for (_ in range(4)) {
    rell.test.block().run();
  }

  // Perform the transaction after a while
  rell.test.tx()
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run();

  // Wait for a while
  for (_ in range(4)) {
    rell.test.block().run();
  }

  // Perform the transaction twice after a while
  rell.test.tx()
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
      .op(test_op.test_authenticated_operation())
      .nop()
      .sign(rell.test.keypairs.alice)
      .run_must_fail("Insufficient rate limiter points");

  // Wait for a longer time to accumulate more points
  for (_ in range(50)) {
    rell.test.block().run();
  }

  // Perform the transaction multiple times after a longer time
  rell.test.tx()
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .nop()
     .sign(rell.test.keypairs.alice)
     .run();

  // Wait for a even longer time to accumulate even more points
  for (_ in range(50)) {
    rell.test.block().run();
  }

  // Cannot get more than 5 points
  rell.test.tx()
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
     .op(test_op.test_authenticated_operation())
     .nop()
     .sign(rell.test.keypairs.alice)
     .run_must_fail("Insufficient rate limiter points");
}
