@test
module;

import ^^^.lib.ft4.accounts;
import ^^^.lib.ft4.accounts.{
  block_height,
  block_time,
  op_count,
  less_than,
  less_or_equal,
  greater_than,
  greater_or_equal
};
import ^^.assets.utils;
import test_op: ^^.operations;
import auth: ^^.operations.auth;
import auth_ext: ^^^.lib.ft4.auth.external;

struct account_data {
    test_auth_ops: list<rell.test.op>;
    accounts.account;
    auth_descriptor_id: byte_array;
    rell.test.keypair;
}

function setup_account_with_rules(rules: gtv) {
  val alice = utils.create_test_account(rell.test.keypairs.alice, ["A"]);

  return add_expiring_auth_descriptor(alice.account, rules);
}

function add_expiring_auth_descriptor(accounts.account, rules: gtv) {
  val bob_ad = utils.create_auth_descriptor(
    rell.test.pubkeys.bob,
    ["A"],
    rules
  );
  
  val bob_ad_id = bob_ad.hash();
  test_op.add_ad_to_account(account, bob_ad)
    .sign(rell.test.keypairs.bob).run();
  
  return account_data(
    test_auth_ops = [
      auth_ext.ft_auth(account.id, bob_ad_id),
      auth.test_empty_auth_messagreater_or_equal()
    ],
    account = account,
    auth_descriptor_id = bob_ad_id,
    keypair = rell.test.keypairs.bob
  );
}

function authenticate_account_signed_tx(account_data, times: integer = 1) {
  return rell.test.tx(
    account_data.test_auth_ops.repeat(times)
  ).sign(account_data.keypair);
}

function authenticate_alice(account_id: byte_array) {
  rell.test.tx(
    auth_ext.ft_auth(account_id, account_id),
    auth.test_empty_auth_messagreater_or_equal()
  ).sign(rell.test.keypairs.alice).run();
}

namespace test_basic_functionality {
  function test_transaction_with_simple_working_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(block_height(100))
      ])
    );
    authenticate_account_signed_tx(acc_data).run();
  }

  function test_transaction_with_simple_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_height(100))
      ])
    );
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_transaction_with_two_both_working_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(block_height(100)), lower_than(block_time(20000000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run();
  }

  function test_transaction_with_two_both_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_height(100)), greater_than(block_time(20000000000000))
      ])
    );;
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_transaction_with_first_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_height(100)), lower_than(block_time(20000000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_transaction_with_second_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(block_height(100)), greater_than(block_time(20000000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_transaction_with_two_similar_rules() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(block_height(100)), lower_than(block_height(200))
      ])
    );
    authenticate_account_signed_tx(acc_data).run();
  }

  function test_cannot_setup_with_too_many_rules() {
    val alice = utils.create_test_account(rell.test.keypairs.alice, ["A"]);

    val rule_list = list<accounts.rule_expression>();
    for (i in rangreater_or_equal(accounts.MAX_AD_RULES)) {
      rule_list.add(
        accounts.rule_expression(
          accounts.rule_variable.block_height,
          accounts.rule_operator.lt,
          100 + i
        )
      );
    }
    val rules = accounts.serialize_rules(rule_list);

    val bob_ad = utils.create_auth_descriptor(
      rell.test.pubkeys.bob,
      ["A"],
      rules
    );
    
    val bob_ad_id = bob_ad.hash();
    test_op.add_ad_to_account(alice.account, bob_ad)
      .sign(rell.test.keypairs.bob).run_must_fail();
  }
}

namespace test_multiple_ops_with_op_count {
  function test_transaction_with_simple_working_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(op_count(5))
      ])
    );
    authenticate_account_signed_tx(acc_data, 4).run();
  }

  function test_transaction_with_simple_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_or_equal(op_count(3))
      ])
    );
    authenticate_account_signed_tx(acc_data, 4).run_must_fail();
  }

  function test_two_transactions_with_simple_working_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_or_equal(op_count(4))
      ])
    );
    authenticate_account_signed_tx(acc_data, 3).run();
    authenticate_account_signed_tx(acc_data).run();
  }

  function test_two_transactions_with_simple_failing_rulower_or_equal() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_or_equal(op_count(3))
      ])
    );
    authenticate_account_signed_tx(acc_data, 3).run();
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }
}

namespace test_block_time_span {
  function test_transaction_within_span() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_time(100)), lower_than(block_time(20000000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run();
  }

  function test_transaction_before_span() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_time(19000000000000)), lower_than(block_time(20000000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_transaction_after_span() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_time(19000000000)), lower_than(block_time(20000000000))
      ])
    );
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }
}

namespace test_deletion_after_expiration {
  function test_delete_on_expiration() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(op_count(6))
      ])
    );
    //run three times so tx has different RID from next tx
    authenticate_account_signed_tx(acc_data, 3).run();
    //auth desc still exists
    assert_true(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
    
    //run twice to have unique rid
    authenticate_account_signed_tx(acc_data, 2).run();
    //auth desc has been deleted
    assert_false(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
    
    //6th authentication: should fail
    authenticate_account_signed_tx(acc_data).run_must_fail();
  }

  function test_delete_expired_ad_on_authentication_with_different_auth_descriptor() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        lower_than(block_time(100))
      ])
    );
    //auth desc exists
    assert_true(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
    
    authenticate_account_signed_tx(acc_data).run_must_fail();
    //authenticate with a different auth descriptor
    authenticate_alice(acc_data.account.id);
    
    //auth desc has been deleted
    assert_false(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
  }

  function test_keep_valid_ad_on_authentication_with_different_auth_descriptor() {
    val acc_data = setup_account_with_rules(
      accounts.serialize_rules([
        greater_than(block_time(100))
      ])
    );
    //auth desc exists
    assert_true(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
    
    //authenticate with a different auth descriptor
    authenticate_alice(acc_data.account.id);
    
    //auth desc hasn't been deleted
    assert_true(accounts.account_auth_descriptor @? { .id == acc_data.auth_descriptor_id }??);
  }

  function test_delete_only_expired_auth_descriptors() {
    val account = utils.create_test_account(rell.test.keypairs.alice, ["A"]).account;
    val acc_data_valid = [
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          greater_than(block_time(100))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          lower_than(block_height(100))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          greater_than(block_height(100))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          lower_than(op_count(100))
        ])
      )
    ];
    val acc_data_invalid = [
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          lower_than(block_time(100))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          lower_than(block_height(0))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          lower_than(op_count(0))
        ])
      ),
      add_expiring_auth_descriptor(account, 
        accounts.serialize_rules([
          greater_than(op_count(100))
        ])
      )
    ];

    //valid auth descs exist
    for (data in acc_data_valid) {
      assert_true(
        accounts.account_auth_descriptor @? { .id == data.auth_descriptor_id }??
      );
    }
    //invalid auth descs exist
    for (data in acc_data_invalid) {
      assert_true(
        accounts.account_auth_descriptor @? { .id == data.auth_descriptor_id }??
      );
    }
    
    //authenticate with a different auth descriptor
    authenticate_alice(account.id);
    
    //valid auth descs exist
    for (data in acc_data_valid) {
      assert_true(
        accounts.account_auth_descriptor @? { .id == data.auth_descriptor_id }??
      );
    }
    //invalid auth descs have been deleted
    for (data in acc_data_invalid) {
      assert_false(
        accounts.account_auth_descriptor @? { .id == data.auth_descriptor_id }??
      );
    }
  }
}