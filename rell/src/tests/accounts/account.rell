@test module;

import acc: ^^^.lib.ft3.accounts;
import acc_external: ^^^.lib.ft3.accounts.external;
import ^^.assets.utils;
import test_op: ^^.operations;

function setup_account_with_many_ads() {
  val alice_ad = utils.create_auth_descriptor(rell.test.keypairs.alice.pub);
  utils.create_test_account_with_auth_descriptor(alice_ad, rell.test.keypairs.alice);

  val account = acc.account @ {};
  val bob_ad = utils.create_auth_descriptor(rell.test.keypairs.bob.pub);
  val eve_ad = utils.create_auth_descriptor(rell.test.keypairs.eve.pub);
  val trudy_ad = utils.create_auth_descriptor(rell.test.keypairs.trudy.pub);
  
  rell.test.tx().op(test_op.add_ad_to_account(account, bob_ad)).sign(rell.test.keypairs.bob).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, eve_ad)).sign(rell.test.keypairs.eve).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, trudy_ad)).sign(rell.test.keypairs.trudy).run();

  return account;
}

function get_single_sig_args(gtv): acc.single_sig_args {
  return acc.single_sig_args.from_gtv(acc.auth_descriptor.from_gtv_pretty(gtv).args.to_gtv());
}

function test_auth_descriptors_are_returned_in_correct_order() {
  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors_paginated(account.id, 4, null);

  assert_equals(get_single_sig_args(descriptors.data[0]).pubkey, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors.data[1]).pubkey, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors.data[2]).pubkey, rell.test.keypairs.eve.pub);
  assert_equals(get_single_sig_args(descriptors.data[3]).pubkey, rell.test.keypairs.trudy.pub);
}

function test_auth_descriptors_are_paginated() {
  val account = setup_account_with_many_ads();
  
  val descriptors_p1 = acc_external.get_account_auth_descriptors_paginated(account.id, 3, null);

  assert_equals(get_single_sig_args(descriptors_p1.data[0]).pubkey, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors_p1.data[1]).pubkey, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors_p1.data[2]).pubkey, rell.test.keypairs.eve.pub);

  val descriptors_p2 = acc_external.get_account_auth_descriptors_paginated(account.id, 3, descriptors_p1.next_cursor);
  assert_equals(get_single_sig_args(descriptors_p2.data[0]).pubkey, rell.test.keypairs.trudy.pub);
}

function test_paginated_items_have_the_correct_return_format() {
  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors_paginated(account.id, 1, null);

  val alice_ad = utils.create_auth_descriptor(rell.test.keypairs.alice.pub);
  assert_equals(descriptors.data[0], alice_ad.to_gtv_pretty());
}
