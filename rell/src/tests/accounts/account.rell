@test module;

import acc: ^^^.lib.ft4.accounts;
import auth_ext: ^^^.lib.ft4.auth.external;
import utils: ^^^.lib.ft4.utils;
import acc_external: ^^^.lib.ft4.accounts.external;
import asset_utils: ^^.assets.utils;
import test_op: ^^.operations;
import test_utils: ^^^.lib.ft4.test.utils;

struct gtv_auth_descriptor {
    id: byte_array;
    account_id: byte_array;
    acc.auth_type;
    args: gtv;
    rules: gtv;
    created: timestamp;
}

function setup_account_with_many_ads() {
  val alice_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.alice.pub, ["A", "T"]);
  asset_utils.create_test_account_with_auth_descriptor(alice_ad, rell.test.keypairs.alice);

  val account = acc.account @ { alice_ad.hash() };
  val bob_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.bob.pub);
  val eve_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.eve.pub);
  val trudy_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.trudy.pub);
  
  rell.test.tx().op(test_op.add_ad_to_account(account, bob_ad)).sign(rell.test.keypairs.bob).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, eve_ad)).sign(rell.test.keypairs.eve).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, trudy_ad)).sign(rell.test.keypairs.trudy).run();

  return account;
}

function get_single_sig_args(args: gtv): acc.single_sig_args {
  return acc.single_sig_args.from_gtv(args);
}

function test_auth_descriptors_are_returned_in_correct_order() {
  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors(account.id);

  assert_equals(get_single_sig_args(descriptors[0].args).signer, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors[1].args).signer, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors[2].args).signer, rell.test.keypairs.eve.pub);
  assert_equals(get_single_sig_args(descriptors[3].args).signer, rell.test.keypairs.trudy.pub);
}

function test_items_have_the_correct_return_format() {
  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors(account.id);

  val alice_ad_id = acc.account_auth_descriptor @* {.account == account} ( .id )[0];
  val alice_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.alice.pub, ["A", "T"]);

  assert_equals(descriptors[0], (
    id = alice_ad_id,
    account_id = account.id,
    auth_type = alice_ad.auth_type,
    args = alice_ad.args.to_gtv(),
    rules = alice_ad.rules.to_gtv(),
    created = acc.account_auth_descriptor @ { .id == alice_ad_id }( .created )
  ));
}

function test_get_accounts_by_signer_is_paginated() {
  val account1 = asset_utils.create_test_account(rell.test.keypairs.alice, ["A"]);
  val account2 = asset_utils.create_test_account(rell.test.keypairs.alice, ["A", "2"]);

  val page1 = acc_external.get_accounts_by_signer(rell.test.keypairs.alice.pub, 1, null);
  val page2 = acc_external.get_accounts_by_signer(rell.test.keypairs.alice.pub, 1, page1.next_cursor);

  assert_equals(page1.data.size(), 1);
  assert_equals(page1.data[0], account1.account.to_struct().to_gtv_pretty());
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], account2.account.to_struct().to_gtv_pretty());
}

function test_accounts_by_ad_id_is_paginated() {
  val alice_ad = asset_utils.create_auth_descriptor(rell.test.keypairs.alice.pub, ["A"]);
  val bob = asset_utils.register_bob();
  val eve = asset_utils.register_eve();
  val trudy = asset_utils.register_trudy();

  rell.test.tx()
    .op(test_op.add_ad_to_account(bob.account, alice_ad))
    .op(test_op.add_ad_to_account(eve.account, alice_ad))
    .op(test_op.add_ad_to_account(trudy.account, alice_ad))
    .sign(rell.test.keypairs.alice)
    .run();

  val accounts_p1 = acc_external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, null);
  assert_equals(
    accounts_p1, 
    utils.paged_result(
        data = [bob.account.id.to_gtv(), eve.account.id.to_gtv()],
        next_cursor = accounts_p1.next_cursor
    )
  );
  
  val accounts_p2 = acc_external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, accounts_p1.next_cursor);
  assert_equals(byte_array.from_gtv_pretty(accounts_p2.data[0]), trudy.account.id);
  assert_equals(
    accounts_p2, 
    utils.paged_result(
        data = [trudy.account.id.to_gtv()],
        next_cursor = null
    )
  );
}

function test_ad_can_delete_itself_without_admin_flag() {
  val account_data = asset_utils.create_test_account(rell.test.keypairs.alice, ["A"]);
  val ad = asset_utils.create_auth_descriptor(rell.test.keypairs.bob.pub, ["T"]);
  rell.test
    .tx(test_op.add_ad_to_account(account_data.account, ad))
    .sign(rell.test.keypairs.bob)
    .sign(rell.test.keypairs.alice)
    .run();

  val ad_id = acc.account_auth_descriptor @ {} ( @sort_desc @omit .rowid, .id ) limit 1;
  val ads = acc.account_auth_descriptor @* { .account.id == account_data.account.id };
  assert_equals(ads.size(), 2);
  assert_equals(ads[1].id, ad_id);
  
  rell.test.tx()
    .op(test_utils.ft_auth_operation_for(rell.test.keypairs.bob.pub))
    .op(acc_external.delete_auth_descriptor(ad_id))
    .sign(rell.test.keypairs.bob)
    .run();
  
  val remaining_ads = acc.account_auth_descriptor @* { .account.id == account_data.account.id };
  assert_equals(remaining_ads.size(), 1);
  assert_equals(remaining_ads[0].id, account_data.auth_descriptor_id);
}

function test_the_remaining_ad_is_selected_when_calling_delete_all_auth_descriptors_exclude() {
  val account_data = asset_utils.create_test_account(rell.test.keypairs.alice, ["A"]);
  val ad = asset_utils.create_auth_descriptor(rell.test.keypairs.bob.pub, ["A"]);
  rell.test
    .tx(test_op.add_ad_to_account(account_data.account, ad))
    .sign(rell.test.keypairs.bob)
    .sign(rell.test.keypairs.alice)
    .run();

  val ad_id = acc.account_auth_descriptor @ {} ( @sort_desc @omit .rowid, .id ) limit 1;
  val ads = acc.account_auth_descriptor @* { .account.id == account_data.account.id };

  assert_equals(ads.size(), 2);
  assert_equals(ads[1].id, ad_id);

  val op_args = struct<acc_external.delete_all_auth_descriptors_exclude>(
    account_id=account_data.account.id,
    auth_descriptor_id=account_data.auth_descriptor_id
  ).to_gtv();

  val selected_ad_id = auth_ext.get_first_allowed_auth_descriptor(
    "ft4.delete_all_auth_descriptors_exclude",
    op_args,
    account_data.account.id,
    acc.account_auth_descriptor @* {} ( .id )
  );

  assert_equals(selected_ad_id, account_data.auth_descriptor_id);
}
