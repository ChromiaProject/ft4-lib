function test_get_main_auth_descriptors_filtered_is_paginated() {
  val account1 = test.register_account_open(
    rell.test.keypairs.alice,
    [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
  );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc
    .external
    .main_account_auth_descriptor_filter(
      account_ids = [account1.account.id, account2.account.id],
      account_auth_descriptor_id = null
    );

  val page1 = acc.external.get_main_auth_descriptors_filtered(test_filter, 1, null);
  val page2 = acc.external.get_main_auth_descriptors_filtered(test_filter, 1, page1.next_cursor);
  val page3 = acc.external.get_main_auth_descriptors_filtered(test_filter, null, page2.next_cursor);
  val account_ad_1 = acc.main_auth_descriptor @? { .account == account1.account }!!;
  val account_ad_2 = acc.main_auth_descriptor @? { .account == account2.account }!!;
  val compare_data_1 = (
    account_id = account1.account.id,
    account_type = account1.account.type,
    args = gtv.from_bytes(account_ad_1.auth_descriptor.args),
    auth_type = account_ad_1.auth_descriptor.auth_type,
    created = account_ad_1.auth_descriptor.created,
    ctr = account_ad_1.auth_descriptor.ctr,
    id = account_ad_1.auth_descriptor.id,
    rules = gtv.from_bytes(account_ad_1.auth_descriptor.rules),
  );
  val compare_data_2 = (
    account_id = account2.account.id,
    account_type = account2.account.type,
    args = gtv.from_bytes(account_ad_2.auth_descriptor.args),
    auth_type = account_ad_2.auth_descriptor.auth_type,
    created = account_ad_2.auth_descriptor.created,
    ctr = account_ad_2.auth_descriptor.ctr,
    id = account_ad_2.auth_descriptor.id,
    rules = gtv.from_bytes(account_ad_2.auth_descriptor.rules),
  );

  assert_equals(page1.data[0], compare_data_1.to_gtv_pretty());
  assert_equals(page2.data[0], compare_data_2.to_gtv_pretty());
}

function test_get_auth_descriptor_signers_filtered() {
  val account1 = test.register_account_open(
    rell.test.keypairs.alice,
    [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
  );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);
  test_op.add_ad_to_account(account1.account, test.create_auth_descriptor(rell.test.keypairs.alice.pub)).run();

  var test_filter = acc
    .external
    .auth_descriptor_signer_filter(
      ids = null,
      auth_descriptor_id = account1.auth_descriptor_id
    );
  val auth_descriptor_signer_ret = acc.external.get_auth_descriptor_signers_filtered(test_filter, 1, null);

  val account_ad = acc.account_auth_descriptor @* { .account == account1.account }[0];
  val auth_desc_signer = acc.auth_descriptor_signer @? { .account_auth_descriptor == account_ad }!!;
  val compare_data = (
    account_auth_descriptor_args = gtv.from_bytes(account_ad.args),
    account_auth_descriptor_auth_type = account_ad.auth_type,
    account_auth_descriptor_created = account_ad.created,
    account_auth_descriptor_ctr = account_ad.ctr,
    account_auth_descriptor_id = account_ad.id,
    account_auth_descriptor_rules = gtv.from_bytes(account_ad.rules),
    account_id = account1.account.id,
    account_type = account1.account.type,
    id = auth_desc_signer.id,
  );
  assert_equals(auth_descriptor_signer_ret.data[0], compare_data.to_gtv_pretty());
}

function test_get_auth_descriptor_signers_filtered_is_paginated() {
  val account1 = test.register_account_open(
    rell.test.keypairs.alice,
    [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
  );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);
  test_op.add_ad_to_account(account1.account, test.create_auth_descriptor(rell.test.keypairs.alice.pub)).run();

  var test_filter = acc.external.auth_descriptor_signer_filter(ids = null, auth_descriptor_id = null);
  val auth_descriptor_signer_ret = acc.external.get_auth_descriptor_signers_filtered(test_filter, 10, null);
  val account_ads = acc.account_auth_descriptor @* { .account == account1.account };
  val auth_desc_signer = acc.auth_descriptor_signer @? { .account_auth_descriptor == account_ads[0] }!!;
  val auth_desc_signer2 = acc.auth_descriptor_signer @? { .account_auth_descriptor == account_ads[1] }!!;
  val compare_data = (
    account_auth_descriptor_args = gtv.from_bytes(account_ads[0].args),
    account_auth_descriptor_auth_type = account_ads[0].auth_type,
    account_auth_descriptor_created = account_ads[0].created,
    account_auth_descriptor_ctr = account_ads[0].ctr,
    account_auth_descriptor_id = account_ads[0].id,
    account_auth_descriptor_rules = gtv.from_bytes(account_ads[0].rules),
    account_id = account1.account.id,
    account_type = account1.account.type,
    id = auth_desc_signer.id,
  );

  val compare_data2 = (
    account_auth_descriptor_args = gtv.from_bytes(account_ads[1].args),
    account_auth_descriptor_auth_type = account_ads[1].auth_type,
    account_auth_descriptor_created = account_ads[1].created,
    account_auth_descriptor_ctr = account_ads[1].ctr,
    account_auth_descriptor_id = account_ads[1].id,
    account_auth_descriptor_rules = gtv.from_bytes(account_ads[1].rules),
    account_id = account1.account.id,
    account_type = account1.account.type,
    id = auth_desc_signer.id,
  );
  assert_equals(auth_descriptor_signer_ret.data[1], compare_data.to_gtv_pretty());
  assert_equals(auth_descriptor_signer_ret.data[3], compare_data2.to_gtv_pretty());
}

function test_accounts_by_ad_id_is_paginated() {
  val alice_ad = test.create_auth_descriptor(rell.test.keypairs.alice.pub, [acc.auth_flags.ACCOUNT]);
  val bob = test.register_bob();
  val eve = test.register_eve();
  val trudy = test.register_trudy();

  rell.test.tx()
    .op(test_op.add_ad_to_account(bob.account, alice_ad))
    .op(test_op.add_ad_to_account(eve.account, alice_ad))
    .op(test_op.add_ad_to_account(trudy.account, alice_ad))
    .sign(rell.test.keypairs.alice)
    .run();

  val accounts_p1 = acc.external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, null);
  assert_equals(
    accounts_p1,
    utils.paged_result(
      data = [bob.account.id.to_gtv(), eve.account.id.to_gtv()],
      next_cursor = accounts_p1.next_cursor
    )
  );

  val accounts_p2 = acc.external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, accounts_p1.next_cursor);
  assert_equals(byte_array.from_gtv_pretty(accounts_p2.data[0]), trudy.account.id);
  assert_equals(
    accounts_p2,
    utils.paged_result(
      data = [trudy.account.id.to_gtv()],
      next_cursor = null
    )
  );
}

function test_get_config() {
  assert_equals(
    acc.external.get_config(),
    (
      rate_limit = acc.rate_limit_config(max_points = 5),
      auth_descriptor = acc.auth_descriptor_config(max_rules = 4)
    )
  );
}

function test_get_account_by_id() {
  val alice = test.register_alice();
  val found_account = acc.external.get_account_by_id(alice.account.id);
  assert_not_null(found_account);
  assert_equals(found_account, struct<acc.account>(
    id = alice.account.id,
    type = alice.account.type
  ));
}

function test_get_account_by_id_when_account_does_not_exist() {
  val found_account = acc.external.get_account_by_id(x"0000");
  assert_null(found_account);
}