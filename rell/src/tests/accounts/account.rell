@test module;

import acc: ^^^.lib.ft4.accounts;
import utils: ^^^.lib.ft4.utils;
import acc_external: ^^^.lib.ft4.accounts.external;
import test_utils: ^^.assets.utils;
import test_op: ^^.operations;

struct gtv_auth_descriptor {
    id: byte_array;
    acc.auth_type;
    args: gtv;
    rules: gtv;
    created: timestamp;
}

function setup_account_with_many_ads() {
  val alice_ad = test_utils.create_auth_descriptor(rell.test.keypairs.alice.pub);
  test_utils.create_test_account_with_auth_descriptor(alice_ad, rell.test.keypairs.alice);

  val account = acc.account @ {};
  val bob_ad = test_utils.create_auth_descriptor(rell.test.keypairs.bob.pub);
  val eve_ad = test_utils.create_auth_descriptor(rell.test.keypairs.eve.pub);
  val trudy_ad = test_utils.create_auth_descriptor(rell.test.keypairs.trudy.pub);
  
  rell.test.tx().op(test_op.add_ad_to_account(account, bob_ad)).sign(rell.test.keypairs.bob).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, eve_ad)).sign(rell.test.keypairs.eve).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, trudy_ad)).sign(rell.test.keypairs.trudy).run();

  return account;
}

function get_single_sig_args(gtv): acc.single_sig_args {
  return acc.single_sig_args.from_gtv(gtv_auth_descriptor.from_gtv_pretty(gtv).args.to_gtv());
}

function test_auth_descriptors_are_returned_in_correct_order() {
  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors(account.id, 4, null);

  assert_equals(get_single_sig_args(descriptors.data[0]).pubkey, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors.data[1]).pubkey, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors.data[2]).pubkey, rell.test.keypairs.eve.pub);
  assert_equals(get_single_sig_args(descriptors.data[3]).pubkey, rell.test.keypairs.trudy.pub);
}

function test_auth_descriptors_are_paginated() {
  val account = setup_account_with_many_ads();
  
  val descriptors_p1 = acc_external.get_account_auth_descriptors(account.id, 3, null);

  assert_equals(get_single_sig_args(descriptors_p1.data[0]).pubkey, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors_p1.data[1]).pubkey, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors_p1.data[2]).pubkey, rell.test.keypairs.eve.pub);

  val descriptors_p2 = acc_external.get_account_auth_descriptors(account.id, 3, descriptors_p1.next_cursor);
  assert_equals(get_single_sig_args(descriptors_p2.data[0]).pubkey, rell.test.keypairs.trudy.pub);
}

function test_paginated_items_have_the_correct_return_format() {
  val account = setup_account_with_many_ads();
  val descriptors = acc_external.get_account_auth_descriptors(account.id, 1, null);

  val alice_ad_id = acc.account_auth_descriptor @* {.account == account} ( .id )[0];
  val alice_ad = test_utils.create_auth_descriptor(rell.test.keypairs.alice.pub);
  val alice_gtv_ad = gtv_auth_descriptor(
    id = alice_ad_id,
    auth_type = alice_ad.auth_type,
    args = alice_ad.args.to_gtv_pretty(),
    rules = alice_ad.rules.to_gtv_pretty(),
    created = acc.account_auth_descriptor @ { .id == alice_ad_id }( .created )
  );
  assert_equals(descriptors.data[0], alice_gtv_ad.to_gtv_pretty());
}

function test_get_account_auth_descriptors_by_participant_id_is_paginated() {
  val account = test_utils.create_test_account(rell.test.keypairs.alice, ["A"]);
  val ad1 = test_utils.create_auth_descriptor(rell.test.keypairs.bob.pub, ["A"]);
  val ad2 = test_utils.create_auth_descriptor(rell.test.keypairs.bob.pub, ["T"]);
  
  rell.test.tx(test_op.add_ad_to_account(account.account, ad1)).sign(rell.test.keypairs.bob).run();
  rell.test.tx(test_op.add_ad_to_account(account.account, ad2)).sign(rell.test.keypairs.bob).run();
  
  val page1 = acc_external.get_account_auth_descriptors_by_participant_id(account.account.id, rell.test.keypairs.bob.pub, 1, null);
  val page2 = acc_external.get_account_auth_descriptors_by_participant_id(account.account.id, rell.test.keypairs.bob.pub, 1, page1.next_cursor);

  val descriptors = acc.auth_descriptor_participant @* {
    .id == rell.test.keypairs.bob.pub
  }( 
    acc.get_auth_descriptor_data($.account_auth_descriptor.to_struct()).to_gtv_pretty()
  );

  assert_equals(page1.data.size(), 1);
  assert_equals(page1.data[0], descriptors[0]);
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], descriptors[1]);
}

function test_get_accounts_by_participant_id_is_paginated() {
  val account1 = test_utils.create_test_account(rell.test.keypairs.alice, ["A"]);
  val account2 = test_utils.create_test_account(rell.test.keypairs.alice, ["2"]);

  val page1 = acc_external.get_accounts_by_participant_id(rell.test.keypairs.alice.pub, 1, null);
  val page2 = acc_external.get_accounts_by_participant_id(rell.test.keypairs.alice.pub, 1, page1.next_cursor);

  assert_equals(page1.data.size(), 1);
  assert_equals(page1.data[0], account1.account.to_struct().to_gtv_pretty());
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], account2.account.to_struct().to_gtv_pretty());
}

function test_accounts_by_ad_id_is_paginated() {
  val alice_ad = test_utils.create_auth_descriptor(rell.test.keypairs.alice.pub);
  val bob = test_utils.register_bob();
  val eve = test_utils.register_eve();
  val trudy = test_utils.register_trudy();

  rell.test.tx()
    .op(test_op.add_ad_to_account(bob.account, alice_ad))
    .op(test_op.add_ad_to_account(eve.account, alice_ad))
    .op(test_op.add_ad_to_account(trudy.account, alice_ad))
    .sign(rell.test.keypairs.alice)
    .run();

  val accounts_p1 = acc_external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, null);
  assert_equals(
    accounts_p1, 
    utils.paged_result(
        data = [bob.account.id.to_gtv(), eve.account.id.to_gtv()],
        next_cursor = accounts_p1.next_cursor
    )
  );
  
  val accounts_p2 = acc_external.get_accounts_by_auth_descriptor_id(alice_ad.hash(), 2, accounts_p1.next_cursor);
  assert_equals(byte_array.from_gtv_pretty(accounts_p2.data[0]), trudy.account.id);
  assert_equals(
    accounts_p2, 
    utils.paged_result(
        data = [trudy.account.id.to_gtv()],
        next_cursor = null
    )
  );
}
