@test module;

import acc: ^^^.lib.ft4.accounts;
import utils: ^^^.lib.ft4.utils;
import test_op: lib.ft4.test.operations;
import test: lib.ft4.test.core;

struct gtv_auth_descriptor {
  id: byte_array;
  account_id: byte_array;
  acc.auth_type;
  args: gtv;
  rules: gtv;
  created: timestamp;
}

function setup_account_with_many_ads() {
  val alice_ad = test
    .create_auth_descriptor(
      rell
        .test
        .keypairs
        .alice
        .pub,
      [
        acc
        .auth_flags
        .ACCOUNT,
        acc
        .auth_flags
        .TRANSFER
      ]
    );
  test.register_account_with_auth_descriptor(alice_ad, rell.test.keypairs.alice);

  val account = acc.account @ { rell.test.keypairs.alice.pub.hash() };
  val bob_ad = test.create_auth_descriptor(rell.test.keypairs.bob.pub);
  val eve_ad = test.create_auth_descriptor(rell.test.keypairs.eve.pub);
  val trudy_ad = test.create_auth_descriptor(rell.test.keypairs.trudy.pub);

  rell.test.tx().op(test_op.add_ad_to_account(account, bob_ad)).sign(rell.test.keypairs.bob).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, eve_ad)).sign(rell.test.keypairs.eve).run();
  rell.test.tx().op(test_op.add_ad_to_account(account, trudy_ad)).sign(rell.test.keypairs.trudy).run();

  return account;
}

function get_single_sig_args(args: gtv): acc.single_sig_args {
  return acc.single_sig_args.from_gtv(args);
}

function test_auth_descriptors_are_returned_in_correct_order() {
  rell.test.block().run(); // build genesis block to be able to use op_context.last_block_time afterwards

  val account = setup_account_with_many_ads();
  val descriptors = acc.external.get_account_auth_descriptors(account.id);

  assert_equals(get_single_sig_args(descriptors[0].args).signer, rell.test.keypairs.alice.pub);
  assert_equals(get_single_sig_args(descriptors[1].args).signer, rell.test.keypairs.bob.pub);
  assert_equals(get_single_sig_args(descriptors[2].args).signer, rell.test.keypairs.eve.pub);
  assert_equals(get_single_sig_args(descriptors[3].args).signer, rell.test.keypairs.trudy.pub);
}

function test_items_have_the_correct_return_format() {
  val account = setup_account_with_many_ads();
  val descriptors = acc.external.get_account_auth_descriptors(account.id);

  val alice_ad_id = acc.account_auth_descriptor @* {.account == account} ( .id )[0];
  val alice_ad = test.create_auth_descriptor(rell.test.keypairs.alice.pub, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);
  val alice_ad_mod = test
    .create_auth_descriptor(
      rell
        .test
        .keypairs
        .alice
        .pub,
      [
        acc
        .auth_flags
        .ACCOUNT,
        acc
        .auth_flags
        .TRANSFER
      ]
    );

  assert_equals(descriptors[0], (
    id = alice_ad_id,
    account_id = account.id,
    auth_type = alice_ad.auth_type,
    args = alice_ad.args.to_gtv(),
    rules = alice_ad.rules.to_gtv(),
    created = acc.account_auth_descriptor @ { .id == alice_ad_id }( .created )
  ));
}

function test_get_accounts_by_signer_is_paginated() {
  val account1 = test
    .register_account_open(
      rell
        .test
        .keypairs
        .alice,
      [
        acc
        .auth_flags
        .ACCOUNT,
        acc
        .auth_flags
        .TRANSFER
      ]
    );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  test_op.add_ad_to_account(account2.account, test.create_auth_descriptor(rell.test.keypairs.alice.pub)).run();

  val page1 = acc.external.get_accounts_by_signer(rell.test.keypairs.alice.pub, 1, null);
  val page2 = acc.external.get_accounts_by_signer(rell.test.keypairs.alice.pub, 1, page1.next_cursor);

  assert_equals(page1.data.size(), 1);
  assert_equals(page1.data[0], account1.account.to_struct().to_gtv_pretty());
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], account2.account.to_struct().to_gtv_pretty());
}

function test_get_rl_states_filtered() {
  val account1 = test
    .register_account_open(
      rell.test.keypairs.alice,
      [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
    );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc.external.rl_state_filter(account_ids = [account1.account.id]);
  val rl_states_filtered = acc.external.get_rl_states_filtered(test_filter, 1, null);
  val rl_state = acc.rl_state @? { .account == account1.account }!!;
  val compare_data = (
    account_id = account1.account.id,
    account_type = account1.account.type,
    points = rl_state.points,
    last_update = rl_state.last_update,
    recovery_time = rl_state.recovery_time,
  );
  assert_equals(rl_states_filtered.data[0], compare_data.to_gtv_pretty());
}

function test_get_accounts_filtered() {
  val account1 = test
    .register_account_open(
      rell.test.keypairs.alice,
      [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
    );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc.external.account_filter(ids = [account1.account.id], type = "FT4_USER");

  val account_ret = acc.external.get_accounts_filtered(test_filter, 1, null);
  assert_equals(account_ret.data[0], account1.account.to_struct().to_gtv_pretty());
}

function test_get_accounts_filtered_is_paginated() {
  val account1 = test
    .register_account_open(
      rell.test.keypairs.alice,
      [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
    );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc.external.account_filter(ids = null, type = "FT4_USER");
  val page1 = acc.external.get_accounts_filtered(test_filter, 1, null);
  val page2 = acc.external.get_accounts_filtered(test_filter, 1, page1.next_cursor);
  val page3 = acc.external.get_accounts_filtered(test_filter, 1, page2.next_cursor);
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], account1.account.to_struct().to_gtv_pretty());
  assert_equals(page3.data.size(), 1);
  assert_equals(page3.data[0], account2.account.to_struct().to_gtv_pretty());
}

function test_get_account_auth_descriptors_filtered() {
  val account1 = test.register_account_open(
    rell.test.keypairs.alice,
    [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
  );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc.external.account_auth_descriptor_filter(ids = null, account_id = account1.account.id);
  val account_ret = acc.external.get_account_auth_descriptors_filtered(test_filter, 1, null);

  val account_ad = acc.account_auth_descriptor @? { .account == account1.account }!!;
  val compare_data = (
    account_id = account1.account.id,
    account_type = account1.account.type,
    args = gtv.from_bytes(account_ad.args),
    auth_type = account_ad.auth_type,
    created = account_ad.created,
    ctr = account_ad.ctr,
    id = account_ad.id,
    rules = gtv.from_bytes(account_ad.rules)
  );
  assert_equals(account_ret.data[0], compare_data.to_gtv_pretty());
}

function test_get_account_auth_descriptors_filtered_is_paginated() {
  val account1 = test.register_account_open(
    rell.test.keypairs.alice,
    [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]
  );
  val account2 = test.register_account_open(rell.test.keypairs.bob, [acc.auth_flags.ACCOUNT, acc.auth_flags.TRANSFER]);

  var test_filter = acc.external.account_auth_descriptor_filter(ids = null, account_id = null);

  val page1 = acc.external.get_account_auth_descriptors_filtered(test_filter, 1, null);
  val page2 = acc.external.get_account_auth_descriptors_filtered(test_filter, 1, page1.next_cursor);
  val page3 = acc.external.get_account_auth_descriptors_filtered(test_filter, 1, page2.next_cursor);

  val account_ad_1 = acc.account_auth_descriptor @? { .account == account1.account }!!;
  val account_ad_2 = acc.account_auth_descriptor @? { .account == account2.account }!!;
  val compare_data_1 = (
    account_id = account1.account.id,
    account_type = account1.account.type,
    args = gtv.from_bytes(account_ad_1.args),
    auth_type = account_ad_1.auth_type,
    created = account_ad_1.created,
    ctr = account_ad_1.ctr,
    id = account_ad_1.id,
    rules = gtv.from_bytes(account_ad_1.rules)
  );
  val compare_data_2 = (
    account_id = account2.account.id,
    account_type = account2.account.type,
    args = gtv.from_bytes(account_ad_2.args),
    auth_type = account_ad_2.auth_type,
    created = account_ad_2.created,
    ctr = account_ad_2.ctr,
    id = account_ad_2.id,
    rules = gtv.from_bytes(account_ad_2.rules)
  );
  assert_equals(page2.data[0], compare_data_1.to_gtv_pretty());
  assert_equals(page3.data[0], compare_data_2.to_gtv_pretty());
}

