
@test
module;

import ^^.assets.utils;
import acc: ^^^.lib.ft4.accounts;
import ^^^.lib.ft4.ft4_basic_dev.*;
import test_operations: ^^.operations;

/*
 * We aim to unit test the basic authentication rules (e.g. the number of signatures and required flags).
 *
 * Note: 
 * Ideally this should be simple unit tests, but since we have "op_context.is_signer()" inside the auth logic,
 * the code must come from a signed transaction, so we added a new method for this in the "dev_op_auth.rell" file.
 * We also have to go the roundabout way of storing the returned error message in a global object "dev_error".
 */

function required_flags() = ["T"];  

function test_happy_valid() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(test_operations.test_auth.test_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_equals(test_operations.test_auth.test_error.msg, "valid");
}

function test_invalid_required_flags() {
    val alice = utils.register_alice();

    val bad_required_flags = ["X"]; // <---- Default test Auth Desc doesn't have "X"!!

    rell.test.tx()
        .op(test_operations.test_auth.test_auth(alice.account.id, alice.auth_descriptor_id, bad_required_flags))
        .sign(rell.test.keypairs.alice)
        .run();
    
    assert_equals(test_operations.test_auth.test_error.msg, "Some required flags [X] are missing on the (single sig) Auth Descriptor.");
}

function test_invalid_single_signer() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(test_operations.test_auth.test_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .sign(rell.test.keypairs.bob) // <---- We sign with wrong user "Bob"
        .run();
    
    assert_equals(test_operations.test_auth.test_error.msg, "The auth descriptor signer did not sign the transaction.");
}

function test_not_signed() {
    val alice = utils.register_alice();

    rell.test.tx()
        .op(test_operations.test_auth.test_auth(alice.account.id, alice.auth_descriptor_id, required_flags()))
        .run(); // <--- No signing at all

    assert_equals(test_operations.test_auth.test_error.msg, "The auth descriptor signer did not sign the transaction.");
}
