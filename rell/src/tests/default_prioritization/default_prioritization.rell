@test module;

import default_prioritization: ^^^.lib.ft4.prioritization.default;
import ^^^.lib.ft4.accounts;
import test: lib.ft4.test.core;
import test_op: lib.ft4.test.operations;

function test_rate_limit_config() {
    assert_equals(accounts.get_rate_limit_config().active, true);
    assert_equals(accounts.get_rate_limit_config().max_points, 5);
    assert_equals(accounts.get_rate_limit_config().recovery_time, 5000);
    assert_equals(accounts.get_rate_limit_config().points_at_account_creation, 1);
}

function test_no_authenticated_operations() {
    val priority_state = default_prioritization.priority_check_v1(
        gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = [
                gtx_operation("foo", list<gtv>())
            ],
            signers = list<gtv>()
        ),
        tx_size = 0,
        tx_enter_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME,
        current_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME
    );

    assert_null(priority_state.account_id);
    assert_equals(priority_state.priority, 0.0);
}

function test_one_authenticated_operation() {
    val alice = test.register_alice();
    
    test_op.consume_point(alice.account.id).run();
    
    val operations = alice.ft_auth(
        gtx_operation(name="foo", args=list<gtv>()).to_test_op()
    ) @* {} ( $.to_gtx_operation() );

    val priority_state = default_prioritization.priority_check_v1(
        gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = operations,
            signers = list<gtv>()
        ),
        tx_size = 0,
        tx_enter_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME,
        current_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME + 5001
    );

    assert_equals(priority_state.account_id, alice.account.id);
    assert_equals(priority_state.account_points, 1);
    assert_equals(priority_state.tx_cost_points, 1);
    assert_equals(priority_state.priority, 0.2);
}

function test_two_authenticated_operations() {
    val alice = test.register_alice();
    test_op.consume_point(alice.account.id).run();
    
    val operations = list<gtx_operation>();
    operations.add_all(
        alice.ft_auth(
            gtx_operation(name="foo", args=list<gtv>()).to_test_op()
        ) @* {} ( $.to_gtx_operation() )
    );
    operations.add_all(
        alice.ft_auth(
            gtx_operation(name="bar", args=list<gtv>()).to_test_op()
        ) @* {} ( $.to_gtx_operation() )
    );

    val priority_state = default_prioritization.priority_check_v1(
        gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = operations,
            signers = list<gtv>()
        ),
        tx_size = 0,
        tx_enter_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME,
        current_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME + 5001
    );

    assert_equals(priority_state.account_id, alice.account.id);
    assert_equals(priority_state.account_points, 1);
    assert_equals(priority_state.tx_cost_points, 2);
    assert_equals(priority_state.priority, 0.2);
}

function test_increase_current_points_with_time() {
    val alice = test.register_alice();

    test_op.consume_point(alice.account.id).run();

    val operations = alice.ft_auth(
        gtx_operation(name="foo", args=list<gtv>()).to_test_op()
    ) @* {} ( $.to_gtx_operation() );

    val priority_state = default_prioritization.priority_check_v1(
        gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = operations,
            signers = list<gtv>()
        ),
        tx_size = 0,
        tx_enter_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME,
        current_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME + 10001
    );

    assert_equals(priority_state.account_id, alice.account.id);
    assert_equals(priority_state.account_points, 2);
    assert_equals(priority_state.tx_cost_points, 1);
    assert_equals(priority_state.priority, 0.4);
}

function test_increase_current_points_with_time_up_to_max() {
    val alice = test.register_alice();
    val operations = alice.ft_auth(
        gtx_operation(name="foo", args=list<gtv>()).to_test_op()
    ) @* {} ( $.to_gtx_operation() );

    val priority_state = default_prioritization.priority_check_v1(
        gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = operations,
            signers = list<gtv>()
        ),
        tx_size = 0,
        tx_enter_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME,
        current_timestamp = rell.test.DEFAULT_FIRST_BLOCK_TIME + (10 * 5000)
    );

    assert_equals(priority_state.account_id, alice.account.id);
    assert_equals(priority_state.account_points, 5);
    assert_equals(priority_state.tx_cost_points, 1);
    assert_equals(priority_state.priority, 1.0);
}
