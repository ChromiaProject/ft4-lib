@test
module;

import ^^^.lib.ft4.accounts;
import ^^^.lib.ft4.ft4_basic_dev.*;
import strategies: ^^^.lib.ft4.accounts.strategies;
import ^^^.lib.ft4.accounts.strategies.open;
import ^^.assets.utils;

function test_create_account_open_success() {
    rell.test.tx()
        .op(open.ras_open(utils.create_auth_descriptor(rell.test.pubkeys.alice), null))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.alice)
        .run();

    assert_not_null(accounts.account @? { rell.test.pubkeys.alice.hash() });
}

function test_create_account_open_fails_when_tx_is_signed_with_wrong_key() {
    rell.test.tx()
        .op(open.ras_open(utils.create_auth_descriptor(rell.test.pubkeys.alice), null))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.bob)
        .run_must_fail("Missing signature for signer <%s>".format(rell.test.pubkeys.alice));

    assert_null(accounts.account @? { rell.test.pubkeys.alice.hash() });
    assert_null(accounts.account @? { rell.test.pubkeys.bob.hash() });
}

function test_create_account_open_fails_when_account_already_exists() {
    rell.test.tx()
        .op(open.ras_open(utils.create_auth_descriptor(rell.test.pubkeys.alice), null))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.alice)
        .run();

    assert_not_null(accounts.account @? { rell.test.pubkeys.alice.hash() });

    rell.test.tx()
        .op(open.ras_open(utils.create_auth_descriptor(rell.test.pubkeys.alice), null))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.alice)
        .nop()
        .run_must_fail("duplicate key value violates unique constraint");
}
