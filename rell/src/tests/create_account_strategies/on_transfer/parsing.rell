@test module;
import create_on_transfer: ^^^^.lib.ft4.accounts.strategies.transfer;

function test_get_config_reads_yml_correctly() {
    val cfg = create_on_transfer.get_config();
    assert_equals(
        cfg,
        [
            create_on_transfer.rule(
                timeout_days = 10,
                strategies = ["open"],

                blockchains = create_on_transfer.allowlist(
                    allow_all = false,
                    allowed_values = [
                        x"08B02E0E14B634031FDF2ED3FD78E7410A5849CD28",
                        chain_context.blockchain_rid
                    ]
                ),
                senders = create_on_transfer.allowlist(
                    allow_all = true
                ),
                recipients = create_on_transfer.allowlist(
                    allow_all = true
                ),

                require_same_address = true,

                allow_all_assets = true,
                asset_limits = map<byte_array, big_integer>()
            ),
            create_on_transfer.rule(
                timeout_days = 60,
                strategies = ["fee", "stake"],

                blockchains = create_on_transfer.allowlist(
                    allow_all = false,
                    allowed_values = [chain_context.blockchain_rid]
                ),
                senders = create_on_transfer.allowlist(
                    allow_all = true
                ),
                recipients = create_on_transfer.allowlist(
                    allow_all = true
                ),

                require_same_address = false,

                allow_all_assets = false,
                asset_limits = map<byte_array, big_integer>([(x"abcdef", 100000L)])
            ),
            create_on_transfer.rule(
                timeout_days = 60,
                strategies = ["open", "fee"],

                blockchains = create_on_transfer.allowlist(
                    allow_all = false,
                    allowed_values = [
                        x"6403ccac0c67f7cb6af78e5e15b3aaebb2b42370f0d12e099ed01fa5a068f9fb",
                        chain_context.blockchain_rid
                    ]
                ),
                senders = create_on_transfer.allowlist(
                    allow_all = true
                ),
                recipients = create_on_transfer.allowlist(
                    allow_all = true
                ),

                require_same_address = false,

                allow_all_assets = false,
                asset_limits = map<byte_array, big_integer>([
                    (x"b31ba66a11a28930d948c8f959cc306184096d1ee858542e765a139b3c79b1aa", 5L),
                    (x"0bdb46231fb6b6fde8efd06dbab99dff23de1ec3dcab2cc43d3acc7fe62da7ac", 3L),
                    (x"ad60efda802fec15e22a8c4691d1eb13e144dee4984772c05ab9163cf2cf2996", 5L),
                    (x"39b34b11bf6c1c301327d5824f977c9360895446a529bb980ebefd2183ca4831", 5L),
                    (x"cf45a2cf3033543c2664886c7d39f9f31087bd5949120fe2e69affc0f926a71f", 7L)
                ])
            )
        ]
    );
}

function test_get_config_uses_defaults() {
    val json = '[{timeout_days: 10}]';

    val cfg = create_on_transfer.get_config(gtv.from_json(json));

    assert_equals(
        cfg,
        [
            create_on_transfer.rule(
                timeout_days = 10,
                strategies = ["open"],

                blockchains = create_on_transfer.allowlist(
                    allow_all = false,
                    allowed_values = [chain_context.blockchain_rid]
                ),
                senders = create_on_transfer.allowlist(
                    allow_all = true
                ),
                recipients = create_on_transfer.allowlist(
                    allow_all = true
                ),

                require_same_address = false,

                allow_all_assets = true,
                asset_limits = map<byte_array, big_integer>()
            )
        ]
    );
}

function test_get_config_reads_dollar_sign_in_blockchain() {
    val json = '[{timeout_days: 10, sender_blockchain: ["012345", "$"]}]';

    val cfg = create_on_transfer.get_config(gtv.from_json(json));

    assert_equals(
        cfg,
        [
            create_on_transfer.rule(
                timeout_days = 10,
                strategies = ["open"],

                blockchains = create_on_transfer.allowlist(
                    allow_all = false,
                    allowed_values = [byte_array("012345"), chain_context.blockchain_rid]
                ),
                senders = create_on_transfer.allowlist(
                    allow_all = true
                ),
                recipients = create_on_transfer.allowlist(
                    allow_all = true
                ),

                require_same_address = false,

                allow_all_assets = true,
                asset_limits = map<byte_array, big_integer>()
            )
        ]
    );
}

function test_get_config_fails_when_only_one_X() {
    val json = '[{timeout_days: 10, sender: "X"}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): 'X' should appear in both or none of recipient and sender.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}

function test_get_config_fails_when_asterisk_alongside_others() {
    val json = '[{timeout_days: 10, sender: ["*", "abcdef"]}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): using multiple values alongside '*' is not allowed.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}

function test_get_config_fails_when_X_alongside_others() {
    val json = '[{timeout_days: 10, sender: ["X", "abcdef"], recipient: "X"}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): using multiple values alongside 'X' is not allowed.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}

function test_get_config_fails_when_value_not_buffer_string_or_list() {
    val json = '[{timeout_days: 10, sender: {id: "abcdef"}}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): blockchain, sender and recipient field only support strings, byte arrays and lists of these types.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}

function test_get_config_fails_when_list_has_wwrong_element_types() {
    val json = '[{timeout_days: 10, sender: ["012345", {id: "abcdef"}]}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): blockchain, sender and recipient lists only support strings and byte arrays.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}

function test_get_config_fails_when_dollar_not_in_blockchains() {
    val json = '[{timeout_days: 10, sender: "$"}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): $ is only allowed in sender_blockchain.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
    val json_2 = '[{timeout_days: 10, sender: ["$"]}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): $ is only allowed in sender_blockchain.",
        create_on_transfer.get_config(gtv.from_json(json_2), *)
    );
}

function test_get_config_fails_when_X_in_blockchains() {
    val json = '[{timeout_days: 10, sender_blockchain: "X"}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): X is not allowed in sender_blockchain.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
    val json_2 = '[{timeout_days: 10, sender_blockchain: ["X"]}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): X is not allowed in sender_blockchain.",
        create_on_transfer.get_config(gtv.from_json(json_2), *)
    );
}

function test_get_config_fails_when_assets_wrong_format() {
    val json = '[{timeout_days: 10, asset: "X"}]';

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): asset only accepts '*' and a list of ids and minimum amounts.",
        create_on_transfer.get_config(gtv.from_json(json), *)
    );
}
