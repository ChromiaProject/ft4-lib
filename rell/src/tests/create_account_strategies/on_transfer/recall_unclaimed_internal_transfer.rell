@test module;

import lib.ft4.auth;
import lib.ft4.admin;
import lib.ft4.utils;
import lib.ft4.assets;
import lib.ft4.accounts;
import test: lib.ft4.test.core;
import transfer_strategy: ^^^^.lib.ft4.accounts.strategies.transfer;

function get_last_transaction(): transaction {
    val last_block = block @ {} (@omit @sort_desc .block_height, $) limit 1;
    return transaction @ { last_block };
}

function test_can_reclaim_transfer_once_but_not_twice_and_not_before_timeout() {
    val alice = test.register_alice();
    val sender = alice.account;
    val recipient_id = rell.test.pubkeys.bob.hash();

    val asset = test.create_asset("test", "TEST", 1);
    test.mint(alice.account, asset, 10);

    val allowed_assets = map(require(transfer_strategy.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id)));
    val amount = allowed_assets[asset.id];

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.transfer(recipient_id, asset.id, amount))
        .sign(alice.keypair)
        .run();


    val last_block = block @ {} (@omit @sort_desc .block_height, $) limit 1;
    val tx_rid = transaction @ { last_block }.tx_rid;

    val account_creation_transfer_before = transfer_strategy.account_creation_transfer @? { recipient_id };
    assert_not_null(account_creation_transfer_before);
    assert_equals(account_creation_transfer_before.amount, amount);
    assert_equals(account_creation_transfer_before.state, transfer_strategy.account_creation_state.pending);

    val pool_account_id = (transfer_strategy.ACCOUNT_TYPE_POOL + chain_context.blockchain_rid).hash();
    val pool_account = accounts.account @? { .id == pool_account_id };
    assert_not_null(pool_account);
    
    assert_equals(assets.get_asset_balance(pool_account, asset), amount);
    assert_equals(assets.get_asset_balance(alice.account, asset), 10L - amount);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.recall_unclaimed_transfer(tx_rid, 1))
        .sign(alice.keypair)
        .run_must_fail("This transfer has not timed out yet");

    run_block_after_timeout();
    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.recall_unclaimed_transfer(tx_rid, 1))
        .nop()
        .sign(alice.keypair)
        .run();

    assert_equals(assets.get_asset_balance(pool_account, asset), 0L);
    assert_equals(assets.get_asset_balance(alice.account, asset), 10L);

    val account_creation_transfer_after = require(transfer_strategy.account_creation_transfer @? { recipient_id });
    assert_equals(account_creation_transfer_after.state, transfer_strategy.account_creation_state.recalled);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(assets.external.recall_unclaimed_transfer(tx_rid, 1))
        .nop()
        .sign(alice.keypair)
        .run_must_fail("No pending transfer found");
}

function run_block_after_timeout() {
    rell.test.set_next_block_time(rell.test.last_block_time + (utils.MILLISECONDS_PER_DAY * 60) + 1);
    rell.test.block().run();
}
