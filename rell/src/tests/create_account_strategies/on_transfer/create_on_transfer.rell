    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val recipient_id = rell.test.pubkeys.bob.hash();

    val sender_blockchain_rid = "sender_blockchain_rid".hash();
    val asset = utils.create_crosschain_asset("invalidAsset", "iva", 1, sender_blockchain_rid, "", sender_blockchain_rid);

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth_ext.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = recipient_id,
                    asset_id = asset.id,
                    amount = 10L,
                    hops = [chain_context.blockchain_rid]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(sender_blockchain_rid, tx.to_gtv().hash()))
        .op(xchain_ext.apply_transfer(tx, 1, tx, 1, 0))
