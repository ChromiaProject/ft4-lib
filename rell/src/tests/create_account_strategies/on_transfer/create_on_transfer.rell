@test
module;

import ^^^^.lib.ft4.accounts;
import ^^^^.lib.ft4.assets;
import ^^^^.lib.ft4.ft4_basic_dev.*;
import strategies: ^^^^.lib.ft4.accounts.strategies;
import create_on_transfer: ^^^^.lib.ft4.accounts.strategies.transfer;
import ^^^^.lib.ft4.accounts.strategies.transfer.open;
import ^^^.assets.utils;
import auth_ext: ^^^^.lib.ft4.auth.external;
import xchain_ext: ^^^^.lib.ft4.crosschain.external;
import iccf_op: ^^^.operations.iccf_op;

function test_create_account_on_internal_transfer_success() {
    val alice = utils.register_alice();
    val sender = alice.account;
    val recipient_id = rell.test.pubkeys.bob.hash();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    val allowed_assets = map(create_on_transfer.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id));
    val min_amount = allowed_assets[asset.id];
    val amount = min_amount;

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset.id, amount))
        .sign(alice.keypair)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset), amount);
    assert_not_null(create_on_transfer.account_creation_transfer @? {
        .sender_blockchain_rid == chain_context.blockchain_rid,
        .sender_id == sender.id,
        recipient_id,
        asset,
        amount,
        .state == create_on_transfer.account_creation_state.pending
    });
    assert_true("open" in create_on_transfer.get_pending_transfer_strategies(recipient_id));

    rell.test.tx()
        .op(open.ras_transfer_open(utils.create_auth_descriptor(rell.test.pubkeys.bob)))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset), 0L);
    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val bob = accounts.account_by_id(recipient_id);
    assert_equals(assets.get_asset_balance(bob, asset), amount);
    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.done}).size(),
        1
    );
}

function test_internal_transfer_fails_if_wrong_asset_is_transfereed() {
    val alice = utils.register_alice();
    val sender = alice.account;
    val recipient_id = rell.test.pubkeys.bob.hash();

    val asset = utils.create_asset("bogus", "BOGUS", 1);
    utils.mint_to_account(alice, asset, 10);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset.id, 10L))
        .sign(alice.keypair)
        .run_must_fail("No suitable transfer strategy found");
}

function test_internal_transfer_fails_if_same_asset_is_transferred_again() {
    val alice = utils.register_alice();
    val sender = alice.account;
    val recipient_id = rell.test.pubkeys.bob.hash();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 20);

    val allowed_assets = map(create_on_transfer.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id));
    val min_amount = allowed_assets[asset.id];
    val amount = min_amount;

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset.id, amount))
        .nop()
        .sign(alice.keypair)
        .run();
    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset.id, amount))
        .nop()
        .sign(alice.keypair)
        .run_must_fail("This asset is already transferred");
}

function test_internal_transfer_fails_if_insufficient_amount_is_transfereed() {
    val alice = utils.register_alice();
    val sender = alice.account;
    val recipient_id = rell.test.pubkeys.bob.hash();

    val asset = utils.create_asset("test", "TEST", 1);
    utils.mint_to_account(alice, asset, 10);

    val allowed_assets = map(create_on_transfer.get_allowed_assets(chain_context.blockchain_rid, sender.id, recipient_id));
    val min_amount = allowed_assets[asset.id];
    val amount = min_amount - 1L;

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset.id, amount))
        .sign(alice.keypair)
        .run_must_fail("No suitable transfer strategy found");
}

function test_create_account_on_transfer_fails_if_no_account_creation_transfer_exists() {
    val recipient_id = rell.test.pubkeys.bob.hash();

    rell.test.tx()
        .op(open.ras_transfer_open(utils.create_auth_descriptor(rell.test.pubkeys.bob)))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.bob)
        .run_must_fail("No pending transfer to account id <%s>".format(recipient_id));

    assert_null(accounts.account @? { recipient_id });
}

function test_multiple_internal_transfers_success() {
    val alice = utils.register_alice();
    val recipient_id = rell.test.pubkeys.charlie.hash();

    val asset1 = utils.create_asset("test", "TEST", 1);
    val asset2 = utils.create_asset("test1", "TEST1", 1);
    val allowed_assets = map(create_on_transfer.get_allowed_assets(chain_context.blockchain_rid, alice.account.id, recipient_id));
    val amount1 = allowed_assets[asset1.id];
    val amount2 = allowed_assets[asset2.id];
    utils.mint_to_account(alice, asset1, 10);
    utils.mint_to_account(alice, asset2, 10);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset1.id, amount1))
        .sign(alice.keypair)
        .run();

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(ft4.assets_ext.transfer(recipient_id, asset2.id, amount2))
        .sign(alice.keypair)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset1), amount1);
    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset2), amount2);
    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.pending}).size(),
        2
    );

    assert_true("open" in create_on_transfer.get_pending_transfer_strategies(recipient_id));

    rell.test.tx()
        .op(open.ras_transfer_open(utils.create_auth_descriptor(rell.test.pubkeys.charlie)))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.charlie)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset1), 0L);
    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset2), 0L);
    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val charlie = accounts.account_by_id(recipient_id);
    assert_equals(assets.get_asset_balance(charlie, asset1), amount1);
    assert_equals(assets.get_asset_balance(charlie, asset2), amount2);

    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.done}).size(),
        2
    );
}

function test_create_account_on_crosschain_transfer_success() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val recipient_id = rell.test.pubkeys.bob.hash();

    val sender_blockchain_rid = "sender_blockchain_rid".hash();
    val asset = utils.create_crosschain_asset("validAsset", "va", 1, sender_blockchain_rid, "", sender_blockchain_rid);

    val allowed_assets = map(create_on_transfer.get_allowed_assets(sender_blockchain_rid, sender_account_id, recipient_id));
    val min_amount = allowed_assets[asset.id];
    val amount = min_amount;

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth_ext.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = recipient_id,
                    asset_id = asset.id,
                    amount = amount,
                    hops = [chain_context.blockchain_rid]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(sender_blockchain_rid, tx.to_gtv().hash()))
        .op(xchain_ext.apply_transfer(tx, 1, tx, 1, 0))
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset), amount);
    assert_not_null(create_on_transfer.account_creation_transfer @? {
        .sender_blockchain_rid == sender_blockchain_rid,
        .sender_id == sender_account_id,
        recipient_id,
        asset,
        amount,
        .state == create_on_transfer.account_creation_state.pending
    });
    assert_true("open" in create_on_transfer.get_pending_transfer_strategies(recipient_id));

    rell.test.tx()
        .op(open.ras_transfer_open(utils.create_auth_descriptor(rell.test.pubkeys.bob)))
        .op(strategies.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset), 0L);
    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val bob = accounts.account_by_id(recipient_id);
    assert_equals(assets.get_asset_balance(bob, asset), amount);
    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.done}).size(),
        1
    );
}

