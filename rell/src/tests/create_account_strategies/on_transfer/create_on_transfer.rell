function test_multiple_crosschain_transfers_success() {
    val sender_account_id = "the first sender".hash();
    val sender_auth_descriptor_id = "first sender auth descriptor".hash();
    val recipient_id = rell.test.pubkeys.bob.hash();

    val sender_blockchain_rid = "sender_blockchain_rid".hash();
    val asset1 = test.create_crosschain_asset("test", "TEST", 1, sender_blockchain_rid, "", sender_blockchain_rid);
    val asset2 = test.create_crosschain_asset("test1", "TEST1", 1, sender_blockchain_rid, "", sender_blockchain_rid);
    val allowed_assets = map(require(create_on_transfer.get_allowed_assets(sender_blockchain_rid, sender_account_id, recipient_id)));
    val amount1 = allowed_assets[asset1.id];
    val amount2 = allowed_assets[asset2.id];

    val tx1 = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset_id = asset1.id,
                    amount = amount1,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(sender_blockchain_rid, tx1.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(tx1, 1, tx1, 1, 0))
        .run();

    val tx2 = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset_id = asset2.id,
                    amount = amount2,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(sender_blockchain_rid, tx2.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(tx2, 1, tx2, 1, 0))
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset1), amount1);
    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset2), amount2);
    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.pending }).size(),
        2
    );
    assert_true("open" in create_on_transfer.get_pending_transfer_strategies(recipient_id));

    rell.test.tx()
        .op(open.ras_transfer_open(test.create_auth_descriptor(rell.test.pubkeys.bob, [accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])))
        .op(strategies.external.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset1), 0L);
    assert_equals(assets.get_asset_balance(create_on_transfer.ensure_pool_account(chain_context.blockchain_rid), asset2), 0L);
    assert_true(empty(create_on_transfer.get_pending_transfer_strategies(recipient_id)));

    val bob = accounts.account_by_id(recipient_id);
    assert_equals(assets.get_asset_balance(bob, asset1), amount1);
    assert_equals(assets.get_asset_balance(bob, asset2), amount2);
    assert_equals(
        (create_on_transfer.account_creation_transfer @* { recipient_id, .state == create_on_transfer.account_creation_state.done}).size(),
        2
    );
}

function test_an_error_is_thrown_when_no_suceeding_op() {
    val auth_descriptor = accounts.single_sig_auth_descriptor(
        rell.test.keypairs.alice.pub,
        set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])
    );

    rell.test.tx()
        .op(open.ras_transfer_open(auth_descriptor))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("<ft4.ras_transfer_open> must be followed by a register account operation");
}

function test_an_error_is_thrown_when_not_followed_by_register_account_op() {
    val auth_descriptor = accounts.single_sig_auth_descriptor(
        rell.test.keypairs.alice.pub,
        set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])
    );

    rell.test.tx()
        .op(open.ras_transfer_open(auth_descriptor))
        .nop()
        .sign(rell.test.keypairs.alice)
        .run_must_fail("<ft4.ras_transfer_open> operation must be followed by a register account operation, not <nop>");
}

function test_original_sender_id_is_returned_on_account_creation() {
    val alice = test.register_alice();

    val asset = test.create_asset("filter_test", "FILTER_TEST", 1);
    test.mint(alice.account, asset, 100);

    val bob_account_id = rell.test.keypairs.bob.pub.hash();

    rell.test.tx()
        .op(alice.ft_auth(assets.external.transfer(bob_account_id, asset.id, 5L)))
        .sign(alice.keypair)
        .run();
    
    rell.test.tx()
        .op(open.ras_transfer_open(test.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"])))
        .op(strategies.external.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    val tx_rid = test.get_last_transaction().tx_rid;
    val sender_record = assets.external.get_transfer_details_by_asset(tx_rid, 1, asset.id) @ { .is_input } limit 1;
    assert_equals(sender_record.account_id, alice.account.id);
}

function test_original_recipient_id_is_returned_on_account_creation() {
    val alice = test.register_alice();

    val asset = test.create_asset("filter_test", "FILTER_TEST", 1);
    test.mint(alice.account, asset, 100);

    val bob_account_id = rell.test.keypairs.bob.pub.hash();

    rell.test.tx()
        .op(alice.ft_auth(assets.external.transfer(bob_account_id, asset.id, 5L)))
        .sign(alice.keypair)
        .run();
    
    rell.test.tx()
        .op(open.ras_transfer_open(test.create_auth_descriptor(rell.test.pubkeys.bob, ["A", "T"])))
        .op(strategies.external.register_account())
        .sign(rell.test.keypairs.bob)
        .run();

    val tx_rid = test.get_last_transaction().tx_rid;
    val sender_record = assets.external.get_transfer_details_by_asset(tx_rid, 1, asset.id) @ { .is_input == false } limit 1;
    assert_equals(sender_record.account_id, bob_account_id);
}

function test_crosschain_transfer_from_and_to_the_same_account_requires_no_signature_to_register_account() {
    val sender_id = rell.test.pubkeys.alice.hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val recipient_id = sender_id;

    val source_blockchain_rid = mocks.BLOCKCHAIN_RID_ONE;
    val asset = test.create_crosschain_asset("test", "TEST", 10, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset.id,
                    5L,
                    [chain_context.blockchain_rid],
                    10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .run();

    rell.test.tx()
        .op(open.ras_transfer_open(test.create_auth_descriptor(rell.test.pubkeys.alice, [accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])))
        .op(strategies.external.register_account())
        .run();
}

function test_crosschain_transfer_from_and_to_different_account_requires_signature_to_register_account() {
    val alice = test.register_alice();
    val bob_pubkey = rell.test.pubkeys.bob;
    val recipient_id = bob_pubkey.hash();

    val source_blockchain_rid = x"6403ccac0c67f7cb6af78e5e15b3aaebb2b42370f0d12e099ed01fa5a068f9fb";
    val asset = test.create_crosschain_asset("test", "TEST", 10, source_blockchain_rid, "", source_blockchain_rid);
    val amount = 5L;

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset.id,
                    amount,
                    [chain_context.blockchain_rid],
                    10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .run();

    rell.test.tx()
        .op(open.ras_transfer_open(test.create_auth_descriptor(bob_pubkey, [accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])))
        .op(strategies.external.register_account())
        .run_must_fail(
           "MISSING SIGNATURE: Missing signature for public key <%s>".format(bob_pubkey)
        );
}

function test_ensures_crosschain_transfer_from_and_to_the_same_account_with_disposable_fails_if_disposable_missing() {
    val sender_id = rell.test.pubkeys.alice.hash();
    val recipient_id = sender_id;
    val main_auth_descriptor = accounts.single_sig_auth_descriptor(
        rell.test.pubkeys.alice,
        set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])
    );

    val disposable_auth_descriptor = accounts.single_sig_auth_descriptor(rell.test.pubkeys.bob, set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER]));

    val source_blockchain_rid = mocks.BLOCKCHAIN_RID_ONE;
    val asset = test.create_crosschain_asset("test", "TEST", 10, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_id, main_auth_descriptor.hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset.id,
                    5L,
                    [chain_context.blockchain_rid],
                    10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .run();

    rell.test.tx()
        .op(open.ras_transfer_open(main_auth_descriptor, disposable_auth_descriptor))
        .op(strategies.external.register_account())
        .run_must_fail("MISSING SIGNATURE: Missing signature for public key <%s>".format(rell.test.pubkeys.bob));
}

function test_ensures_crosschain_transfer_from_and_to_the_same_account_with_disposable_succeeds_with_disposable() {
    val sender_id = rell.test.pubkeys.alice.hash();
    val recipient_id = sender_id;
     val main_auth_descriptor = accounts.single_sig_auth_descriptor(
        rell.test.pubkeys.alice,
        set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER])
    );
    val disposable_auth_descriptor = accounts.single_sig_auth_descriptor(rell.test.pubkeys.bob, set([accounts.auth_flags.ACCOUNT, accounts.auth_flags.TRANSFER]));

    val source_blockchain_rid = mocks.BLOCKCHAIN_RID_ONE;
    val asset = test.create_crosschain_asset("test", "TEST", 10, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_id, sender_id.hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id,
                    asset.id,
                    5L,
                    [chain_context.blockchain_rid],
                    10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .run();

    rell.test.tx()
        .op(open.ras_transfer_open(main_auth_descriptor, disposable_auth_descriptor))
        .op(strategies.external.register_account())
        .sign(rell.test.keypairs.bob)
        .run();
}