@test module;
import ^^^^.lib.ft4.accounts.strategies.transfer.fee;

function test_get_config_reads_yml_correctly() {
    val cfg = fee.fee_assets();
    assert_equals(
        cfg,
        [
            (asset_id = x"b31ba66a11a28930d948c8f959cc306184096d1ee858542e765a139b3c79b1aa", amount = 2L),
            (asset_id = x"0bdb46231fb6b6fde8efd06dbab99dff23de1ec3dcab2cc43d3acc7fe62da7ac", amount = 1L)
        ]
    );
}
