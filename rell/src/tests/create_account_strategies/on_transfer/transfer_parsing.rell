}

function test_get_config_fails_when_assets_wrong_format() {
    val rule_gtv_pretty = [(
        timeout_days = 10,
        sender_blockchain = "$",
        sender = "*",
        recipient = "*",
        asset = "X",
        strategy = ["open"]
    )].to_gtv_pretty();

    assert_fails(
        "Error in moduleArgs (lib.ft4.core.accounts.strategy.transfer): asset only accepts '*' and a list of ids and minimum amounts.",
        create_on_transfer.get_config(rule_gtv_pretty, *)
    );
}

function test_get_config_fails_when_mandatory_values_are_missing() {
    val rule_gtv_pretty = [(
        timeout_days = 10,
        sender_blockchain = "$",
        sender = "*",
        recipient = "*",
        asset = "X"
    )].to_gtv_pretty();

    assert_fails(
        "Key missing in Gtv dictionary: field 'lib.ft4.core.accounts.strategies.transfer:module_args_list_element.strategy'",
        create_on_transfer.get_config(rule_gtv_pretty, *)
    );
}

function test_get_config_fails_when_timeout_days_is_negative() {
    val rule_gtv_pretty = [(
        timeout_days = -1,
        sender_blockchain = ["012345"],
        sender = "*",
        recipient = "*",
        asset = "*",
        strategy = ["open"]
    )].to_gtv_pretty();

    assert_fails(
        "timeout_days cannot be negative",
        create_on_transfer.get_config(rule_gtv_pretty, *)
    );
}
