module;

import ^^^^.lib.ft4.accounts;
import ^^^^.lib.ft4.auth;
import ^^^^.lib.ft4.assets;

operation create_system_account(id: byte_array, type: text) {
    accounts.create_account_without_auth(id, type);
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(regular_operation).mount_name,
    flags = []
);

operation regular_operation() {
  auth.authenticate();
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
    scope = rell.meta(free_operation).mount_name,
    flags = []
);

operation free_operation() {
  auth.authenticate();
}

operation register_dummy_assets_for_rule3(wrong_brid: boolean = false) {
    // asset limits of rule3
    //     id=x"b31ba66a11a28930d948c8f959cc306184096d1ee858542e765a139b3c79b1aa",
    //     5L,
    val a1 = create assets.asset(
        name = "a1",
        symbol = "1111",
        decimals = 0,
        icon_url = "",
        total_supply = 0L,
        issuing_blockchain_rid = x"abcd",
        id = x"b31ba66a11a28930d948c8f959cc306184096d1ee858542e765a139b3c79b1aa",
    );
    
    // issuing_blockchain_rid = CURRENT_CHAIN_RID,
    // name = "test1",
    val a2 = create assets.asset(
        name = "test1",
        symbol = "2222",
        decimals = 0,
        icon_url = "",
        total_supply = 0L,
        issuing_blockchain_rid = chain_context.blockchain_rid,
        id = x"2222",
    );
    
    // issuing_blockchain_rid = CURRENT_CHAIN_RID,
    // name = "test2",
    val a3 = create assets.asset(
        name = "test2",
        symbol = "3333",
        decimals = 0,
        icon_url = "",
        total_supply = 0L,
        issuing_blockchain_rid = chain_context.blockchain_rid,
        id = x"3333",
    );

    // id=x"eb72b0d3de2ce5c8ec5ccf15ee8a9fbe4bed074f6d4385fdbf552904fc0b8dce",
    // issuing_blockchain_rid = x"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    val a4 = create assets.asset(
        name = "test1",
        symbol = "4444",
        decimals = 0,
        icon_url = "",
        total_supply = 0L,
        issuing_blockchain_rid = if (wrong_brid) byte_array.from_hex("1".repeat(64)) else byte_array.from_hex("A".repeat(64)),
        id = x"eb72b0d3de2ce5c8ec5ccf15ee8a9fbe4bed074f6d4385fdbf552904fc0b8dce",
    );

    // issuing_blockchain_rid = x"6403ccac0c67f7cb6af78e5e15b3aaebb2b42370f0d12e099ed01fa5a068f9fb",
    // name = "test1",
    val a5 = create assets.asset(
        name = "test1",
        symbol = "5555",
        decimals = 0,
        icon_url = "",
        total_supply = 0L,
        issuing_blockchain_rid = x"6403ccac0c67f7cb6af78e5e15b3aaebb2b42370f0d12e099ed01fa5a068f9fb",
        id = x"5555",
    );
}