@test module;

import lib.ft4.crosschain;
import ^.helpers;
import ^.mocks;

function test_get_asset_origin_by_rowid_no_asset_origin() {
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(rowid(0));
    assert_null(found_asset_origin);
}

function test_get_asset_origin_by_rowid_no_asset_origin_for_rowid() {
    val (_, _) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(rowid(999));

    // assert asset origin has 1 entry
    assert_null(found_asset_origin);
}

function test_get_asset_origin_by_rowid() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(asset_origin.rowid);

    assert_equals(
        found_asset_origin,
        mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()
    );
}

function test_get_applied_transfer_by_rowid_no_applied_transfer() {
    val found_applied_transfer = crosschain.external.get_applied_transfer_by_rowid(rowid(0));
    assert_null(found_applied_transfer);
}

function test_get_applied_transfer_by_rowid_no_applied_transfer_for_rowid() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    val found_applied_transfer = crosschain.external.get_applied_transfer_by_rowid(rowid(999));

    // assert applied transfer has 1 entry
    assert_null(found_applied_transfer);
}

function test_get_applied_transfer_by_rowid() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    val found_applied_transfer = crosschain.external.get_applied_transfer_by_rowid(applied_transfer.rowid);

    assert_equals(
        found_applied_transfer,
        mocks.format_expected_applied_transfer_assertion(found_applied_transfer).to_gtv_pretty()
    );
}

