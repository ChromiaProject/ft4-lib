@test module;

import lib.ft4.crosschain;
import ^.helpers;
import ^.mocks;
import common_helpers: ^^.common.helpers;

function test_get_asset_origin_by_rowid_no_asset_origin() {
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(rowid(0));
    assert_null(found_asset_origin);
}

function test_get_asset_origin_by_rowid_no_asset_origin_for_rowid() {
    helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(rowid(999));

    assert_not_null(helpers.get_asset_origin_or_null());
    assert_null(found_asset_origin);
}

function test_get_asset_origin_by_rowid() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val found_asset_origin = crosschain.external.get_asset_origin_by_rowid(asset_origin.rowid);

    assert_equals(
        found_asset_origin,
        mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()
    );
}

