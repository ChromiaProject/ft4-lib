    val found_applied_transfer = crosschain.external.get_applied_transfer_by_rowid(rowid(999));

    assert_not_null(helpers.get_applied_transfer_or_null());
    assert_null(found_applied_transfer);
}

function test_get_applied_transfer_by_rowid() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    val found_applied_transfer = crosschain.external.get_applied_transfer_by_rowid(applied_transfer.rowid);

    assert_equals(
        found_applied_transfer,
        mocks.format_expected_applied_transfer_assertion(applied_transfer).to_gtv_pretty()
    );
}

function test_get_canceled_transfer_by_rowid_no_canceled_transfer() {
    val found_canceled_transfer = crosschain.external.get_canceled_transfer_by_rowid(rowid(0));
    assert_null(found_canceled_transfer);
}

function test_get_canceled_transfer_by_rowid_no_canceled_transfer_for_rowid() {
    helpers.init_cancel_and_retrieve_canceled_transfer_crosschain_transfer();
    val found_canceled_transfer = crosschain.external.get_canceled_transfer_by_rowid(rowid(999));

    assert_not_null(helpers.get_canceled_transfer_or_null());
    assert_null(found_canceled_transfer);
}

function test_get_canceled_transfer_by_rowid() {
    val canceled_transfer = helpers.init_cancel_and_retrieve_canceled_transfer_crosschain_transfer();
    val found_canceled_transfer = crosschain.external.get_canceled_transfer_by_rowid(canceled_transfer.rowid);

    assert_equals(
        found_canceled_transfer,
        mocks.format_expected_transfer_assertion(
            canceled_transfer.rowid, canceled_transfer.init_tx_rid, canceled_transfer.init_op_index
        ).to_gtv_pretty()
    );
}

