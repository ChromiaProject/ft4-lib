@test module;

import ^^^.lib.ft4.assets;
import test_utils: ^^.utils.utils;
import ^^.assets.utils;
import ^^.extensions;
import auth_ext: ^^^.lib.ft4.auth.external;
import xchain_ext: ^^^.lib.ft4.crosschain.external;
import assets_ext: ^^^.lib.ft4.assets.external;
import xc: ^^^.lib.ft4.crosschain;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import iccf_op: ^^.operations.iccf_op;
import operations: ^^.operations;

function test_can_revert_canceled_transfer_once_but_not_twice() {
    val alice = utils.register_alice();
    val recipient_account_id = "the recipient".hash();
    val recipient_auth_descriptor_id = "recipient auth descriptor".hash();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val target_blockchain_rid = x"DDDD";
    utils.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(
            recipient_account_id,
            asset_valid.id,
            5L,
            [target_blockchain_rid],
            deadline = rell.test.last_block_time+1
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset_valid), 5L);

    val init_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xchain_ext.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, cancel_tx, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset_valid), 10L);

    val revert_tx_rid = test_utils.get_last_transaction().tx_rid;

    val history = assets_ext.get_transfer_history(alice.account.id, assets.filter(null), null, null)!!.data;
    val history_entry = map<text,gtv>.from_gtv(history[0]);
    assert_equals(history_entry["tx_rid"], revert_tx_rid.to_gtv());
    assert_equals(history_entry["op_index"], (1).to_gtv());
    assert_equals(history_entry["operation_name"], rell.meta(xchain_ext.revert_transfer).mount_name.to_gtv());
    assert_equals(history_entry["delta"], 5L.to_gtv());
    assert_equals(history_entry["is_input"], (0).to_gtv());
    assert_equals(history_entry["is_crosschain"], (1).to_gtv());

    val expected = set([
        assets.transfer_detail(
            blockchain_rid = chain_context.blockchain_rid,
            account_id = alice.account.id,
            asset_id = asset_valid.id,
            delta = 5L,
            is_input = false
        ),
        assets.transfer_detail(
            blockchain_rid = target_blockchain_rid,
            account_id = recipient_account_id,
            asset_id = asset_valid.id,
            delta = 5L,
            is_input = true
        )
    ]);
    assert_equals(assets_ext.get_transfer_details(revert_tx_rid, 1), expected);
    assert_equals(assets_ext.get_transfer_details_by_asset(revert_tx_rid, 1, asset_valid.id), expected);

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, cancel_tx, 0))
        .nop()
        .run_must_fail("Cannot revert cross-chain transfer for transaction <%s> at index <%d>. Pending transfer not found."
                  .format(init_tx.body.hash(), 1));
}

function test_can_revert_unapplied_transfer_once_but_not_twice() {
    val alice = utils.register_alice();
    val recipient_account_id = "the recipient".hash();
    val recipient_auth_descriptor_id = "recipient auth descriptor".hash();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val intermediate_blockchain_rid = x"CCCC";
    val target_blockchain_rid = x"DDDD";
    utils.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(
            recipient_account_id,
            asset_valid.id,
            5L,
            [intermediate_blockchain_rid, target_blockchain_rid],
            deadline = rell.test.last_block_time+1
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset_valid), 5L);

    val init_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xchain_ext.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val unapply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = intermediate_blockchain_rid,
            operations = [
                xchain_ext.unapply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    last_tx = cancel_tx,
                    last_op_index = 0,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(intermediate_blockchain_rid, unapply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, unapply_tx, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(alice.account, asset_valid), 10L);

    val revert_tx_rid = test_utils.get_last_transaction().tx_rid;

    val history = assets_ext.get_transfer_history(alice.account.id, assets.filter(null), null, null)!!.data;
    val history_entry = map<text,gtv>.from_gtv(history[0]);
    assert_equals(history_entry["tx_rid"], revert_tx_rid.to_gtv());
    assert_equals(history_entry["op_index"], (1).to_gtv());
    assert_equals(history_entry["operation_name"], rell.meta(xchain_ext.revert_transfer).mount_name.to_gtv());
    assert_equals(history_entry["delta"], 5L.to_gtv());
    assert_equals(history_entry["is_input"], (0).to_gtv());
    assert_equals(history_entry["is_crosschain"], (1).to_gtv());

    val expected = set([
        assets.transfer_detail(
            blockchain_rid = chain_context.blockchain_rid,
            account_id = alice.account.id,
            asset_id = asset_valid.id,
            delta = 5L,
            is_input = false
        ),
        assets.transfer_detail(
            blockchain_rid = target_blockchain_rid,
            account_id = recipient_account_id,
            asset_id = asset_valid.id,
            delta = 5L,
            is_input = true
        )
    ]);
    assert_equals(assets_ext.get_transfer_details(revert_tx_rid, 1), expected);
    assert_equals(assets_ext.get_transfer_details_by_asset(revert_tx_rid, 1, asset_valid.id), expected);

    rell.test.tx()
        .op(iccf_op.iccf_proof(intermediate_blockchain_rid, unapply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, unapply_tx, 0))
        .nop()
        .run_must_fail("Cannot revert cross-chain transfer for transaction <%s> at index <%d>. Pending transfer not found."
                  .format(init_tx.body.hash(), 1));
}

function test_can_not_revert_canceled_transfer_before_expiry() {
    val alice = utils.register_alice();
    val recipient_account_id = "the recipient".hash();
    val recipient_auth_descriptor_id = "recipient auth descriptor".hash();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val target_blockchain_rid = x"DDDD";
    utils.mint(alice.account, asset_valid, 10L);

    val deadline = rell.test.last_block_time + rell.test.DEFAULT_BLOCK_INTERVAL * 2;

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(
            recipient_account_id,
            asset_valid.id,
            5L,
            [target_blockchain_rid],
            deadline = deadline
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val init_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xchain_ext.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, cancel_tx, 0))
        .nop()
        .run_must_fail("This transfer has not yet expired. It can not be reverted before <%s>.".format(deadline));
}

function test_can_not_revert_non_existing_transfer() {
    val alice = utils.register_alice();
    val recipient_account_id = "the recipient".hash();
    val recipient_auth_descriptor_id = "recipient auth descriptor".hash();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val target_blockchain_rid = x"DDDD";
    utils.mint(alice.account, asset_valid, 10L);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = [
                auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id).to_gtx_operation(),
                xchain_ext.init_transfer(
                    recipient_id = recipient_account_id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [target_blockchain_rid],
                    deadline = rell.test.last_block_time-1
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xchain_ext.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.revert_transfer(init_tx, 1, cancel_tx, 0))
        .nop()
        .run_must_fail("Cannot revert cross-chain transfer for transaction <%s> at index <%d>. Pending transfer not found."
                  .format(init_tx.body.hash(), 1));
}

