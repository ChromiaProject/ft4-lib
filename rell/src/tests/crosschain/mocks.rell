@test module;

import lib.ft4.assets;
import lib.ft4.crosschain;

val issuing_blockchain_rid = x"aa".repeat(32);
val origin_blockchain_rid = x"bb".repeat(32);
val asset_name = "Test asset";
val icon_url = "https://filehub.chromia.com/project/collection/1";
val asset_symbol = "TST";

function format_expected_asset_origin_assertion(assets.asset, crosschain.asset_origin) {
    return (
        rowid = asset_origin.rowid,
        asset = (
            rowid = asset.rowid,
            id = asset.id,
            name = asset.name,
            symbol = asset.symbol,
            decimal = asset.decimals,
            blockchain_rid = issuing_blockchain_rid,
            icon_url = asset.icon_url,
            type = asset.type,
            supply = asset.total_supply
        ),
        origin_blockchain_rid = origin_blockchain_rid
    );
}

function format_expected_applied_transfer_assertion(crosschain.applied_transfers) {
    return (
        rowid = applied_transfers.rowid,
        init_tx_rid = applied_transfers.init_tx_rid,
        init_op_index = applied_transfers.init_op_index,
        transaction_rid = applied_transfers.transaction.tx_rid,
        op_index = applied_transfers.op_index
    );
}
