@test module;

import lib.ft4.assets;
import lib.ft4.crosschain;

val BLOCKCHAIN_RID_ONE = x"aa".repeat(32);
val BLOCKCHAIN_RID_TWO = x"bb".repeat(32);
val ASSET_NAME = "Test asset";
val ICON_URL = "https://filehub.chromia.com/project/collection/1";
val ASSET_SYMBOL = "TST";

function format_expected_asset_origin_assertion(assets.asset, crosschain.asset_origin) {
    val mapped_asset_origin = crosschain.map_asset_origin(asset_origin);

    return (
        asset = assets.map_asset(asset),
        origin_blockchain_rid = mapped_asset_origin.origin_blockchain_rid
    );
}