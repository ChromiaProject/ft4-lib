    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_reverted_transfers_using_all_filter() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    val reverted_pending_transfers = crosschain.external.get_reverted_transfers_filtered(
        helpers.set_transfer_filter(
            rowids = [reverted_transfer.rowid],
            init_tx_rid = reverted_transfer.init_tx_rid,
            init_op_index = reverted_transfer.init_op_index
        ),
        1,
        null
    );
    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_transfer(
            reverted_transfer.rowid,
            reverted_transfer.init_tx_rid,
            reverted_transfer.init_op_index
        ).to_gtv_pretty()]
    ));
}