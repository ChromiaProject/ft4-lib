function test_get_unapplied_transfers_filtered_by_multiple_init_tx_rids_using_all_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val unapplied_transfer_one = helpers.unapply_transfer_and_retrieve_unapplied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val unapplied_transfer_two = helpers.unapply_transfer_and_retrieve_unapplied_transfer(
        mocks.ASSET_NAME + 1,
        mocks.ASSET_SYMBOL + 1,
        1578700850001,
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val fetched_unapplied_transfers = crosschain.external.get_unapplied_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [
                unapplied_transfer_one.init_tx_rid,
                unapplied_transfer_two.init_tx_rid,
            ],
            init_op_index = unapplied_transfer_one.init_op_index
        ),
        2,
        null
    );
    assert_equals(fetched_unapplied_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_transfer(
                unapplied_transfer_one.init_tx_rid,
                unapplied_transfer_one.init_op_index
            ).to_gtv_pretty(),
            crosschain.map_transfer(
                unapplied_transfer_two.init_tx_rid,
                unapplied_transfer_two.init_op_index
            ).to_gtv_pretty()
        ]
    )); 
}

