@test module;
import lib.ft4.crosschain;
import lib.ft4.utils;
import ^.helpers;
import ^.mocks;
import test: lib.ft4.test.core;

function test_get_assets_origin_filtered_without_filter_no_assets_origin() {
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(null, 1, null);
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_assets_origin_filtered_without_filter() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(null, 1, null);
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()]
    ));
}

function test_get_assets_origin_filtered_by_single_asset_id() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(asset_ids = [asset.id]), 1, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()]
    ));
}

function test_get_assets_origin_filtered_by_multiple_asset_ids() {
    val (asset_one, asset_origin_one) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val (asset_two, asset_origin_two) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin(
        mocks.ASSET_NAME + 1,
        mocks.ASSET_SYMBOL + 1
    );
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(asset_ids = [asset_one.id, asset_two.id]), 2, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [
            mocks.format_expected_asset_origin_assertion(asset_one, asset_origin_one).to_gtv_pretty(),
            mocks.format_expected_asset_origin_assertion(asset_two, asset_origin_two).to_gtv_pretty()
        ]
    ));
}

function test_get_assets_origin_filtered_using_invalid_asset_id_filter_no_assets_origin() {
    helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(asset_ids = [x"0000"]), 1, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_applied_transfers_filtered_without_filter_no_applied_transfer() {
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(null, 1, null);
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_applied_transfers_filtered_without_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(null, 1, null);
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_applied_transfer(applied_transfer).to_gtv_pretty()]
    ));
}

function test_get_applied_transfers_filtered_by_init_tx_rids_requires_composite_indexes() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rids, init_op_index) - init_op_index filter is required",
        crosschain.external.get_applied_transfers_filtered(
            helpers.set_transfer_filter(init_tx_rids = [applied_transfer.init_tx_rid]), 
            1,
            null, *
        )
    );
}

function test_get_applied_transfers_filtered_by_init_op_index_requires_composite_indexes() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rids, init_op_index) - init_tx_rids filter cannot be empty",
        crosschain.external.get_applied_transfers_filtered(
            helpers.set_transfer_filter(init_op_index = applied_transfer.init_op_index), 
            1,
            null, *
        )
    );
}

function test_get_applied_transfers_filtered_by_single_init_tx_rid_and_init_op_index() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [applied_transfer.init_tx_rid],
            init_op_index = applied_transfer.init_op_index
        ),
        1,
        null
    );
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_applied_transfer(applied_transfer).to_gtv_pretty()]
    ));
}

function test_get_applied_transfers_filtered_by_multiple_init_tx_rids_using_all_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val applied_transfer_one = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        sender_account_id = alice.account.id,
        recipient_account_id = bob.account.id,
        sender_auth_descriptor_id = alice.auth_descriptor_id
    );
    val applied_transfer_two = helpers.create_crosschain_transfer_and_retrieve_applied_transfer(
        mocks.ASSET_NAME + 1,
        mocks.ASSET_SYMBOL + 1,
        alice.account.id,
        bob.account.id,
        alice.auth_descriptor_id
    );
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [
                applied_transfer_one.init_tx_rid,
                applied_transfer_two.init_tx_rid
            ],
            init_op_index = applied_transfer_one.init_op_index
        ),
        2,
        null
    );
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_applied_transfer(applied_transfer_one).to_gtv_pretty(),
            crosschain.map_applied_transfer(applied_transfer_two).to_gtv_pretty()
        ]
    ));
}

