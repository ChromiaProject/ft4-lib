function test_get_canceled_transfers_filtered_without_filter() {
    val canceled_transfer = helpers.init_cancel_and_retrieve_canceled_transfer_crosschain_transfer();
    val fetched_canceled_transfers = crosschain.external.get_canceled_transfers_filtered(null, 1, null);
    assert_equals(fetched_canceled_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_transfer(
                canceled_transfer.rowid,
                canceled_transfer.init_tx_rid,
                canceled_transfer.init_op_index
            ).to_gtv_pretty()
        ]
    ));
}

