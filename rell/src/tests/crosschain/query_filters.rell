@test module;
import lib.ft4.crosschain;
import lib.ft4.utils;
import ^.helpers;
import ^.mocks;

function test_get_assets_origin_filtered_without_filter_no_assets_origin() {
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(null, 1, null);
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_assets_origin_filtered_without_filter() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(null, 1, null);
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()]
    ));
}

function test_get_assets_origin_filtered_by_rowids() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(rowids = [asset_origin.rowid]), 1, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()]
    ));
}

function test_get_assets_origin_filtered_by_asset_id() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(asset_id = asset.id), 1, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = [mocks.format_expected_asset_origin_assertion(asset, asset_origin).to_gtv_pretty()]
    ));
}

function test_get_assets_origin_filtered_using_all_filter_no_assets_origin() {
    helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(rowids = [rowid(999)], asset_id = x"0000"), 1, null
    );
    assert_equals(fetched_assets_origin, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_assets_origin_filtered_using_all_filter() {
    val (asset, asset_origin) = helpers.create_and_retrieve_crosschain_asset_and_asset_origin();
    val fetched_assets_origin = crosschain.external.get_asset_origin_filtered(
        helpers.set_asset_origin_filter(rowids = [asset_origin.rowid], asset_id = asset.id), 1, null
