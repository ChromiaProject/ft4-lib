function test_get_pending_transfers_filtered_by_multiple_transaction_rids_using_all_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val pending_transfer_one = helpers.init_transfer_and_get_pending_transfer(
        sender_account_data = alice,
        recipient_account_data = bob
    );
    val pending_transfer_two = helpers.init_transfer_and_get_pending_transfer(
        mocks.ASSET_NAME + 1,
        mocks.ASSET_SYMBOL + 1,
        alice,
        bob
    );
    val fetched_pending_transfers = crosschain.external.get_pending_transfers_filtered(
        helpers.set_pending_transfer_filter(
            transaction_rids = [
                pending_transfer_one.transaction.tx_rid,
                pending_transfer_two.transaction.tx_rid
            ],
            op_index = pending_transfer_one.op_index,
            sender_account_id = pending_transfer_one.sender.id
        ),
        2,
        null
    );
    assert_equals(fetched_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_pending_transfer(pending_transfer_one).to_gtv_pretty(),
            crosschain.map_pending_transfer(pending_transfer_two).to_gtv_pretty(),
        ]
    ));
}

function test_get_reverted_transfers_filtered_without_filter_no_reverted_transfer() {
    val fetched_reverted_transfers = crosschain.external.get_reverted_transfers_filtered(null, 1, null);
    assert_equals(fetched_reverted_transfers, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}

function test_get_reverted_transfers_filtered_without_filter() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    val reverted_pending_transfers = crosschain.external.get_reverted_transfers_filtered(null, 1, null);
    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_transfer(
                reverted_transfer.init_tx_rid,
                reverted_transfer.init_op_index
            ).to_gtv_pretty()]
        )
    );
}

function test_get_reverted_transfers_filtered_by_init_tx_rid_requires_composite_indexes() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rids, init_op_index) - init_op_index filter is required",
        crosschain.external.get_reverted_transfers_filtered(
            helpers.set_transfer_filter(init_tx_rids = [reverted_transfer.init_tx_rid]), 
            1,
            null, *
        )
    );
}

function test_get_reverted_transfers_filtered_by_init_op_index_requires_composite_indexes() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rids, init_op_index) - init_tx_rids filter cannot be empty",
        crosschain.external.get_reverted_transfers_filtered(
            helpers.set_transfer_filter(init_op_index = reverted_transfer.init_op_index), 
            1,
            null, *
        )
    );
}

function test_get_reverted_transfers_filtered_by_single_init_tx_rid_and_init_op_index() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    val reverted_pending_transfers = crosschain.external.get_reverted_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [reverted_transfer.init_tx_rid],
            init_op_index = reverted_transfer.init_op_index
        ),
        1,
        null
    );
    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_transfer(
            reverted_transfer.init_tx_rid,
            reverted_transfer.init_op_index
        ).to_gtv_pretty()]
    ));
}

function test_get_reverted_transfers_filtered_by_multiple_init_tx_rids_using_all_filter() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val reverted_transfer_one = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer(
        sender_account_data = alice,
        recipient_account_data = bob
    );
    val reverted_transfer_two = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer(
        mocks.ASSET_NAME + 1,
        mocks.ASSET_SYMBOL + 1,
        sender_account_data = alice,
        recipient_account_data = bob
    );
    val reverted_pending_transfers = crosschain.external.get_reverted_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [
                reverted_transfer_one.init_tx_rid,
                reverted_transfer_two.init_tx_rid
            ],
            init_op_index = reverted_transfer_one.init_op_index
        ),
        2,
        null
    );
    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = [
            crosschain.map_transfer(
                reverted_transfer_one.init_tx_rid,
                reverted_transfer_one.init_op_index
            ).to_gtv_pretty(),
            crosschain.map_transfer(
                reverted_transfer_two.init_tx_rid,
                reverted_transfer_two.init_op_index
            ).to_gtv_pretty()
        ]
    ));
}

function test_get_reverted_transfers_using_all_filter_no_reverted_transfers() {
    val reverted_transfer = helpers.init_revert_canceled_transfer_and_retrieve_reverted_transfer();
    val reverted_pending_transfers = crosschain.external.get_reverted_transfers_filtered(
        helpers.set_transfer_filter(
            init_tx_rids = [x"0000"],
            init_op_index = 1
        ),
        1,
        null
    );
    assert_equals(reverted_pending_transfers, utils.paged_result(
        next_cursor = null,
        data = []
    ));
}