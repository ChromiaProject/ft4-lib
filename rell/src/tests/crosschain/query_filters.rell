}

function test_get_applied_transfers_filtered_without_filter() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(null, 1, null);
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_applied_transfer(applied_transfer).to_gtv_pretty()]
    ));
}

function test_get_applied_transfers_filtered_by_rowids() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    val fetched_applied_transfers = crosschain.external.get_applied_transfers_filtered(
        helpers.set_transfer_filter(rowids = [applied_transfer.rowid]), 1, null
    );
    assert_equals(fetched_applied_transfers, utils.paged_result(
        next_cursor = null,
        data = [crosschain.map_applied_transfer(applied_transfer).to_gtv_pretty()]
    ));
}

function test_get_applied_transfers_filtered_by_init_tx_rid_requires_composite_indexes() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rid, init_op_index) - init_op_index filter is required",
        crosschain.external.get_applied_transfers_filtered(
            helpers.set_transfer_filter(init_tx_rid = applied_transfer.init_tx_rid), 
            1,
            null, *
        )
    );
}

function test_get_applied_transfers_filtered_by_init_op_index_requires_composite_indexes() {
    val applied_transfer = helpers.create_crosschain_transfer_and_retrieve_applied_transfer();
    assert_fails(
        "INVALID FILTER: Composite index (init_tx_rid, init_op_index) - init_tx_rid filter is required",
        crosschain.external.get_applied_transfers_filtered(
            helpers.set_transfer_filter(init_op_index = applied_transfer.init_op_index), 
            1,
            null, *
        )
    );
}

