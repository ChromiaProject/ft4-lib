@test module;

import ^^^.lib.ft4.assets;
import ^^.assets.utils;
import ^^.extensions;
import ^^^.lib.ft4.test.utils. { evm_auth_operation_for };
import auth_ext: ^^^.lib.ft4.auth.external;
import xchain_ext: ^^^.lib.ft4.crosschain.external;
import xc: ^^^.lib.ft4.crosschain;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import iccf_op: ^^.operations.iccf_op;

function test_register_crosschain_asset_works() {
    admin_crosschain.register_crosschain_asset(
            "name",
            "SYM",
            2,
            x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F",
            "",
            x"92F32F448B7D3C979854765E69BC574E8372618A2E857C797C4CAD4D172B6967"
        )
        .sign(utils.admin_priv_key())
        .run();
}

function test_register_crosschain_asset_validates_issuing_blockchain_rid() {
    admin_crosschain.register_crosschain_asset(
            "name",
            "SYM",
            2,
            x"",
            "",
            x"92F32F448B7D3C979854765E69BC574E8372618A2E857C797C4CAD4D172B6967"
        )
        .sign(utils.admin_priv_key())
        .run_must_fail("blockchain_rid cannot be empty");
}

function test_register_crosschain_asset_validates_origin_blockchain_rid() {
    admin_crosschain.register_crosschain_asset(
            "name",
            "SYM",
            2,
            x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F",
            "",
            x""
        )
        .sign(utils.admin_priv_key())
        .run_must_fail("origin_blockchain_rid cannot be empty");
}

function test_init_transfer_fails_when_amount_is_zero() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(bob.account.id, asset_valid.id, 0L, [x"abcdef"]))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %s".format(0));
}

// Test for invalid asset and valid amount
function test_init_transfer_fails_when_asset_is_invalid() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_id_invalid = x"deadbeef";

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(bob.account.id, asset_id_invalid, 5L, [x"abcdef"]))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Asset not found");
}

// Test for valid asset and valid amount
function test_init_transfer_succeeds_under_valid_conditions() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    // Mint some asset to Alice's account for a valid test
    utils.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth_ext.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xchain_ext.init_transfer(bob.account.id, asset_valid.id, 5L, [x"abcdef"]))
        .sign(rell.test.keypairs.alice)
        .run(); // Should run successfully
    
    assert_true(extensions.crosschain_extensions_state.is_before_init_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_sender, alice.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_amount, 5L);

    assert_true(extensions.crosschain_extensions_state.is_after_init_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_sender, alice.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_amount, 5L);
}

function test_init_transfer_succeeds_under_valid_conditions_with_evm_auth() {
    val alice = utils.evm_register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    utils.mint(alice.account, asset_valid, 10L);

    val op = xchain_ext.init_transfer(bob.account.id, asset_valid.id, 5L, [x"abcdef"]);

    rell.test.tx()
        .op(evm_auth_operation_for(alice.keypair.priv, op))
        .op(op)
        .sign(rell.test.keypairs.alice)
        .run();
}

function test_apply_transfer_succeeds_under_valid_conditions() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"abcdef";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth_ext.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run(); // Should run successfully
    
    assert_true(extensions.crosschain_extensions_state.is_before_apply_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_sender_blockchain_rid, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_sender, sender_account_id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_amount, 5L);
    assert_true(extensions.crosschain_extensions_state.before_apply_transfer_is_final);

    assert_true(extensions.crosschain_extensions_state.is_after_apply_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_sender_blockchain_rid, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_sender, sender_account_id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_amount, 5L);
    assert_true(extensions.crosschain_extensions_state.after_apply_transfer_is_final);
}

function test_apply_transfer_fails_with_mismatched_init_transfer_args() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val wrong_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth_ext.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = alice.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [x"abcdef"]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth_ext.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [x"abcdef"]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(xchain_ext.apply_transfer(wrong_tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Invalid parameter. Previous hop tx must be equal to init transfer t");
}

function test_apply_transfer_fails_with_invalid_hop_index() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    val hops = [x"abcdef"];
    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth_ext.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = hops
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );
    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                xchain_ext.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val hop_index = 100; // Invalid hop index

    rell.test.tx()
        .op(xchain_ext.apply_transfer(init_tx, 1, apply_tx, 0, hop_index))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Argument mismatch: init_args.hops size (%d) is greater than hop_index (%d)".format(hops.size(), hop_index));
}

function test_apply_transfer_fails_when_recipient_id_does_not_exists_and_create_on_transfer_strategy_is_not_enabled() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bogus_recipient_id = "bogus".hash();

    val source_blockchain_rid = x"abcdef";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth_ext.ft_auth(sender_account_id.hash(), sender_auth_descriptor_id.hash()).to_gtx_operation(),
                xchain_ext.init_transfer(
                    receiver_id = bogus_recipient_id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid]
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xchain_ext.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Account <%s> does not exist and creating accounts on transfer is not enabled".format(bogus_recipient_id));
}
