@test module;

import lib.ft4.auth;
import lib.ft4.assets;
import xc: lib.ft4.crosschain;
import ^^.extensions;
import test: lib.ft4.test.core;
import admin_crosschain: lib.ft4.admin.crosschain;
import test_op: lib.ft4.test.operations;
import ^.mocks;
import common_helpers: ^^.common.helpers;

function test_register_crosschain_asset_works() {
    val id = ("name", x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F").hash();
    admin_crosschain.external.register_crosschain_asset(
            id,
            "name",
            "SYM",
            2,
            x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F",
            "",
            assets.ASSET_TYPE_FT4,
            x"",            
            x"92F32F448B7D3C979854765E69BC574E8372618A2E857C797C4CAD4D172B6967"
        )
        .sign(test.admin_priv_key())
        .run();
}

function test_register_crosschain_asset_validates_issuing_blockchain_rid() {
    val id = ("name", x"").hash();
    admin_crosschain.external.register_crosschain_asset(
            id,
            "name",
            "SYM",
            2,
            x"",
            "",
            assets.ASSET_TYPE_FT4,
            x"",
            x"92F32F448B7D3C979854765E69BC574E8372618A2E857C797C4CAD4D172B6967"
        )
        .sign(test.admin_priv_key())
        .run_must_fail("issuing_blockchain_rid cannot be empty");
}

function test_register_crosschain_asset_validates_origin_blockchain_rid() {
    val id = ("name", x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F").hash();
    admin_crosschain.external.register_crosschain_asset(
            id,
            "name",
            "SYM",
            2,
            x"BBE58F50E00C733113F8E0647D53FD4BFAD1D85AB831B1719BAF20F1A3336C8F",
            "",
            assets.ASSET_TYPE_FT4,
            x"",            
            x""
        )
        .sign(test.admin_priv_key())
        .run_must_fail("origin_blockchain_rid cannot be empty");
}

function test_init_transfer_fails_when_amount_is_zero() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            0L,
            [mocks.BLOCKCHAIN_RID_ONE],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Parameter amount: value must be non-zero positive, actual: %s".format(0));
}

// Test for invalid asset and valid amount
function test_init_transfer_fails_when_asset_is_invalid() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_id_invalid = x"deadbeef";

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_id_invalid,
            5L,
            [x"abcdef"],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Asset not found");
}

// Test for valid asset and valid amount
function test_init_transfer_fails_if_expired() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    // Mint some asset to Alice's account for a valid test
    test.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [x"abcdef"],
            1
        ))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Parameter 'deadline' cannot be a past timestamp. Value: 1");
}

// Test for valid asset and valid amount
function test_init_transfer_succeeds_under_valid_conditions() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    // Mint some asset to Alice's account for a valid test
    test.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [mocks.BLOCKCHAIN_RID_ONE],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run(); // Should run successfully
    
    assert_true(extensions.crosschain_extensions_state.is_before_init_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_sender, alice.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.before_init_transfer_amount, 5L);

    assert_true(extensions.crosschain_extensions_state.is_after_init_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_sender, alice.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.after_init_transfer_amount, 5L);
}

function test_init_transfer_succeeds_under_valid_conditions_with_evm_auth() {
    val alice = test.register_alice_evm();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    test.mint(alice.account, asset_valid, 10L);

    val op = xc.external.init_transfer(
        recipient_id = bob.account.id,
        asset_id = asset_valid.id,
        amount = 5L,
        hops = [mocks.BLOCKCHAIN_RID_ONE],
        deadline = 10000000000000
    );

    rell.test.tx()
        .op(test.evm_auth_operation_for(alice.keypair.priv, op))
        .op(op)
        .sign(rell.test.keypairs.alice)
        .run();
}

function test_apply_transfer_succeeds_under_valid_conditions() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = test.register_bob();

    val source_blockchain_rid: byte_array? = x"aa".repeat(32);
    val asset_valid = test.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(common_helpers.get_iccf_proof(source_blockchain_rid, tx))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run(); // Should run successfully
    
    assert_true(extensions.crosschain_extensions_state.is_before_apply_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_sender_blockchain_rid, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_sender, sender_account_id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.before_apply_transfer_amount, 5L);
    assert_true(extensions.crosschain_extensions_state.before_apply_transfer_is_final);

    assert_true(extensions.crosschain_extensions_state.is_before_crosschain_balance_change_called);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_sender, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_amount, 5L);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_will_change_sender, false);
    assert_equals(extensions.crosschain_extensions_state.before_crosschain_balance_change_will_change_recipient, true);

    assert_true(extensions.crosschain_extensions_state.is_after_apply_transfer_called);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_sender_blockchain_rid, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_sender, sender_account_id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.after_apply_transfer_amount, 5L);
    assert_true(extensions.crosschain_extensions_state.after_apply_transfer_is_final);

    assert_true(extensions.crosschain_extensions_state.is_after_crosschain_balance_change_called);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_sender, source_blockchain_rid);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_recipient, bob.account.id);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_asset, asset_valid.id);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_amount, 5L);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_will_change_sender, false);
    assert_equals(extensions.crosschain_extensions_state.after_crosschain_balance_change_will_change_recipient, true);
    
}

function test_apply_transfer_fails_if_expired() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = test.register_bob();

    val source_blockchain_rid = x"aa".repeat(32);
    val asset_valid = test.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate an expired transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(common_helpers.get_iccf_proof(source_blockchain_rid, tx))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("This transfer has expired at timestamp <1> (evaluated at timestamp <%s>).".format(rell.test.last_block_time));
}

function test_apply_transfer_fails_when_applied_twice() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = test.register_bob();

    val source_blockchain_rid = x"aa".repeat(32);
    val asset_valid = test.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(common_helpers.get_iccf_proof(source_blockchain_rid, tx))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .nop()
        .sign(rell.test.keypairs.alice)
        .run(); // Should run successfully

    rell.test.tx()
        .op(common_helpers.get_iccf_proof(source_blockchain_rid, tx))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .nop()
        .sign(rell.test.keypairs.alice)
        .run_must_fail(
            "Transaction <%s> transfer at index <1> has already been applied on this chain."
            .format(
                tx.body.to_gtv().hash()
            )
        );
}

function test_apply_transfer_fails_with_mismatched_init_transfer_args() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    val wrong_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth.external.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = alice.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [x"abcdef"],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth.external.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [x"abcdef"],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(xc.external.apply_transfer(wrong_tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Invalid parameter. Previous hop tx must be equal to init transfer t");
}

function test_apply_transfer_fails_with_invalid_hop_index() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    val hops = [x"abcdef"];
    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                auth.external.ft_auth(x"".hash(), x"".hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = hops,
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );
    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"deadbeef",
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val hop_index = 100; // Invalid hop index

    rell.test.tx()
        .op(xc.external.apply_transfer(init_tx, 1, apply_tx, 0, hop_index))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Argument mismatch: init_transfer hops size (%d) is smaller than hop_index (%d)".format(hops.size(), hop_index));
}

function test_apply_transfer_fails_when_recipient_id_does_not_exists_and_create_on_transfer_strategy_is_not_enabled() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bogus_recipient_id = "bogus".hash();

    val source_blockchain_rid = x"aa".repeat(32);
    val asset_valid = test.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id.hash(), sender_auth_descriptor_id.hash()).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bogus_recipient_id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(common_helpers.get_iccf_proof(source_blockchain_rid, tx))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run_must_fail("Account <%s> does not exist and creating accounts on transfer is not enabled".format(bogus_recipient_id));
}
