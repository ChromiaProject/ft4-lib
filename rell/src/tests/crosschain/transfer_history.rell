@test module;

import lib.ft4.auth;
import lib.ft4.assets;
import ^^.extensions;
import xc: lib.ft4.crosschain;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import test: lib.ft4.test.core;
import test_op: lib.ft4.test.operations;
import ^^.operations.iccf_op.{ iccf_proof };
import common_helpers: ^^.common.helpers;

function test_init_transfer_history() {
    val alice = test.register_alice();

    val bob = test.register_bob();
    val target_blockchain_rid = "target blockchain".hash();

    val asset = test.create_asset("validAsset", "va", 1);
    test.mint(alice.account, asset, 10L);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset.id,
            5L,
            [target_blockchain_rid],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val tx_rid = test.get_last_transaction().tx_rid;

    val history = assets.external.get_transfer_history(alice.account.id, assets.filter(null), null, null)!!.data;
    val history_entry = map<text,gtv>.from_gtv(history[0]);
    assert_equals(history_entry["tx_rid"], tx_rid.to_gtv());
    assert_equals(history_entry["op_index"], (1).to_gtv());
    assert_equals(history_entry["operation_name"], rell.meta(xc.external.init_transfer).mount_name.to_gtv());
    assert_equals(history_entry["delta"], 5L.to_gtv());
    assert_equals(history_entry["is_input"], (1).to_gtv());
    assert_equals(history_entry["is_crosschain"], (1).to_gtv());

    val last_two_transfer_history_entries = common_helpers.get_last_two_transfer_history_entries();
    val last_crosschain_transfer_history_entry = common_helpers.get_last_crosschain_transfer_history_entry();

    val expected = [
        assets.transfer_detail(
            blockchain_rid = chain_context.blockchain_rid,
            account_id = alice.account.id,
            asset_id = asset.id,
            delta = 5L,
            is_input = true,
            op_index = last_two_transfer_history_entries[1].op_index,
            transaction_rid = last_two_transfer_history_entries[1].transaction.tx_rid
        ),
        assets.transfer_detail(
            blockchain_rid = target_blockchain_rid,
            account_id = bob.account.id,
            asset_id = asset.id,
            delta = 5L,
            is_input = false,
            op_index = last_crosschain_transfer_history_entry.op_index,
            transaction_rid = last_crosschain_transfer_history_entry.transaction.tx_rid
        )
    ];
    assert_equals(assets.external.get_transfer_details(tx_rid, 1), expected);
    assert_equals(assets.external.get_transfer_details_by_asset(tx_rid, 1, asset.id), expected);
}

function test_apply_transfer_history() {
    val sender_blockchain_rid = "sender blockchain".hash();
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();

    val bob = test.register_bob();

    val asset = test.create_crosschain_asset("validAsset", "va", 1, sender_blockchain_rid, "", sender_blockchain_rid);

    // Simulate a valid transaction and operation index
    val tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = sender_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid],
                    deadline = 10000000000000
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(sender_blockchain_rid, tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(tx, 1, tx, 1, 0))
        .sign(rell.test.keypairs.alice)
        .run();

    val tx_rid = test.get_last_transaction().tx_rid;

    val history = assets.external.get_transfer_history(bob.account.id, assets.filter(null), null, null)!!.data;
    val history_entry = map<text,gtv>.from_gtv(history[0]);
    assert_equals(history_entry["tx_rid"], tx_rid.to_gtv());
    assert_equals(history_entry["op_index"], (1).to_gtv());
    assert_equals(history_entry["operation_name"], rell.meta(xc.external.apply_transfer).mount_name.to_gtv());
    assert_equals(history_entry["delta"], 5L.to_gtv());
    assert_equals(history_entry["is_input"], (0).to_gtv());
    assert_equals(history_entry["is_crosschain"], (1).to_gtv());

    val last_transfer_history_entry = common_helpers.get_last_transfer_history_entry();
    val last_crosschain_transfer_history_entry = common_helpers.get_last_crosschain_transfer_history_entry();

    val expected = [
        assets.transfer_detail(
            blockchain_rid = chain_context.blockchain_rid,
            account_id = bob.account.id,
            asset_id = asset.id,
            delta = 5L,
            is_input = false,
            op_index = last_transfer_history_entry.op_index,
            transaction_rid = last_transfer_history_entry.transaction.tx_rid
        ),
        assets.transfer_detail(
            blockchain_rid = sender_blockchain_rid,
            account_id = sender_account_id,
            asset_id = asset.id,
            delta = 5L,
            is_input = true,
            op_index = last_crosschain_transfer_history_entry.op_index,
            transaction_rid = last_crosschain_transfer_history_entry.transaction.tx_rid
        ),
    ];

    assert_equals(assets.external.get_transfer_details(tx_rid, 1), expected);
    assert_equals(assets.external.get_transfer_details_by_asset(tx_rid, 1, asset.id), expected);
}
