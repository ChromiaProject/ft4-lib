    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.cancel_transfer(init_tx, 1, init_tx, 1, 0))
