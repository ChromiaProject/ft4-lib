@test module;

import lib.ft4.auth;
import lib.ft4.assets;
import xc: lib.ft4.crosschain;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import test_op: lib.ft4.test.operations;
import test: lib.ft4.test.core;
import ^^.operations.iccf_op.{ iccf_proof };
import ^.mocks;

function test_can_complete_transfer() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    test.mint(alice.account, asset_valid, 10L);

    val target_blockchain_rid = mocks.MOCK_BLOCKCHAIN_RID;

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [target_blockchain_rid],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val init_tx = gtx_transaction.from_bytes(test.get_last_transaction().tx_data);

    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_proof(target_blockchain_rid, apply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.complete_transfer(apply_tx, 0))
        .run();
}

function test_can_not_complete_transfer_without_proof() {
    val alice = test.register_alice();
    val bob = test.register_bob();
    val asset_valid = test.create_asset("validAsset", "va", 1);

    test.mint(alice.account, asset_valid, 10L);

    val target_blockchain_rid = mocks.MOCK_BLOCKCHAIN_RID;

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [target_blockchain_rid],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val init_tx = gtx_transaction.from_bytes(test.get_last_transaction().tx_data);

    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(xc.external.complete_transfer(apply_tx, 0))
        .run_must_fail("No proof operation present for TX");
}
