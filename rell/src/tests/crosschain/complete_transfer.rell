@test module;

import lib.ft4.auth;
import lib.ft4.assets;
import test_utils: ^^.utils.utils;
import ^^.assets.utils;
import xc: lib.ft4.crosschain;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import iccf_op: ^^.operations.iccf_op;

function test_can_complete_transfer() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    utils.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [x"abcdef"],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val init_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"abcdef",
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(x"abcdef", apply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.complete_transfer(apply_tx, 0))
        .run();
}

function test_can_not_complete_transfer_without_proof() {
    val alice = utils.register_alice();
    val bob = utils.register_bob();
    val asset_valid = utils.create_asset("validAsset", "va", 1);

    utils.mint(alice.account, asset_valid, 10L);

    rell.test.tx()
        .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
        .op(xc.external.init_transfer(
            bob.account.id,
            asset_valid.id,
            5L,
            [x"abcdef"],
            10000000000000
        ))
        .sign(rell.test.keypairs.alice)
        .run();

    val init_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = x"abcdef",
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(xc.external.complete_transfer(apply_tx, 0))
        .run_must_fail("No proof operation present for TX");
}
