@test module;

import lib.ft4.auth;
import xc: lib.ft4.crosschain;
import test: lib.ft4.test.core;
import ^.mocks;

function test_it_registers_a_pending_transaction_in_init_transfer() {
  val alice = test.register_alice();
  val bob = test.register_bob();

  val asset = test.create_asset("test", "t", 1);
  test.mint(alice.account, asset, 1);

  rell.test.tx()
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(bob.account.id, asset.id, 1, [mocks.BLOCKCHAIN_RID_ONE], 10000000000000))
    .sign(alice.keypair)
    .run();

  val pending_transfers = xc.pending_transfer @* {};
  assert_equals(pending_transfers.size(), 1);
  assert_equals(pending_transfers[0].sender, alice.account);
}

function test_it_fetches_pending_transactions_for_the_specified_account() {
  val alice = test.register_alice();
  val bob = test.register_bob();

  val asset = test.create_asset("test", "t", 1);
  test.mint(alice.account, asset, 1);
  test.mint(bob.account, asset, 1);

  val target_blockchain_rid = mocks.BLOCKCHAIN_RID_ONE;

  rell.test.tx()
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(bob.account.id, asset.id, 1, [target_blockchain_rid], 10000000000000))
    .op(auth.external.ft_auth(bob.account.id, bob.auth_descriptor_id))
    .op(xc.external.init_transfer(alice.account.id, asset.id, 1, [target_blockchain_rid], 10000000000000))
    .sign(alice.keypair, bob.keypair)
    .run();

  assert_equals(xc.external.get_pending_transfers_for_account(bob.account.id, 10, null).data.size(), 1);
}

function test_get_pending_transfers_for_account_is_paginated() {
  val alice = test.register_alice();
  val bob = test.register_bob();
  val asset_valid = test.create_asset("validAsset", "va", 1);

  test.mint(alice.account, asset_valid, 10);

  val target_blockchain_rid = mocks.BLOCKCHAIN_RID_ONE;

  rell.test.tx()
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(bob.account.id, asset_valid.id, 1L, [target_blockchain_rid], 10000000000000))
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(bob.account.id, asset_valid.id, 1L, [target_blockchain_rid], 10000000000000))
    .sign(rell.test.keypairs.alice)
    .run();

  val page1 = xc.external.get_pending_transfers_for_account(alice.account.id, 1, null);
  val page2 = xc.external.get_pending_transfers_for_account(alice.account.id, 1, page1.next_cursor);

  val pending_transfers = xc.pending_transfer @* {} (
    xc.map_pending_transfer($).to_gtv_pretty()
  );

  assert_equals(page1.data.size(), 1);
  assert_equals(page1.data[0], pending_transfers[0]);
  assert_equals(page2.data.size(), 1);
  assert_equals(page2.data[0], pending_transfers[1]);
}

function test_it_fetches_pending_transfers_by_sender_asset_and_amount() {
  val alice = test.register_alice();
  val recipient1_id = rell.test.pubkeys.bob.hash();
  val recipient2_id = rell.test.pubkeys.trudy.hash();
  val target_blockchain_rid = "1".hash();

  val asset = test.create_asset("test", "t", 1);
  test.mint(alice.account, asset, 3);

  rell.test.tx()
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(recipient1_id, asset.id, 1, [target_blockchain_rid], 10000000000000))
    .op(auth.external.ft_auth(alice.account.id, alice.auth_descriptor_id))
    .op(xc.external.init_transfer(recipient2_id, asset.id, 2, [target_blockchain_rid], 10000000000000))
    .sign(alice.keypair)
    .run();

  assert_not_null(xc.external.get_last_pending_transfer_for_account(alice.account.id, target_blockchain_rid, recipient1_id, asset.id, 1));
  assert_not_null(xc.external.get_last_pending_transfer_for_account(alice.account.id, target_blockchain_rid, recipient2_id, asset.id, 2));
  assert_null(xc.external.get_last_pending_transfer_for_account(alice.account.id, target_blockchain_rid, recipient1_id, asset.id, 2));
  assert_null(xc.external.get_last_pending_transfer_for_account(alice.account.id, target_blockchain_rid, recipient2_id, asset.id, 1));
}

function test_returns_false_if_transfer_is_not_applied() {
  assert_false(xc.external.is_transfer_applied("0".to_bytes(), 0));
}
