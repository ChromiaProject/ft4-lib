        signatures = [x"".to_gtv()]
    );

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx =
                        gtx_transaction(body = gtx_transaction_body(blockchain_rid = x"", operations = [], signers = []), signatures = []),
                    op_index = -1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail(
            "Transaction <%s> transfer at index <%s> was never applied on this chain."
            .format(init_tx.body.to_gtv().hash(), 1)
        );
}

function test_can_not_unapply_without_proof() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    val apply_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = apply_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail("No proof operation present for TX");
}

function test_can_not_unapply_with_wrong_op() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    val bogus_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                operations.empty_op().to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, bogus_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, bogus_tx, 0, 0))
        .nop()
        .run_must_fail("last_tx[last_op_index] must be ft4.crosschain.cancel_transfer, ft4.crosschain.unapply_transfer or ft4.crosschain.recall_unclaimed_transfer");
}

function test_can_not_unapply_transfer_canceled_on_wrong_chain() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val wrong_blockchain_rid = x"FFFF";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    val apply_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = wrong_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = apply_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(wrong_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail(
            "Argument mismatch: next hops (%s) and tx blockchain_rid (%s) don't correspond"
            .format(target_blockchain_rid, wrong_blockchain_rid)
        );
}

function test_can_not_unapply_transfer_canceled_with_wrong_apply_tx() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    val bogus_apply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = chain_context.blockchain_rid,
            operations = [
                xc.external.apply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = init_tx,
                    op_index = 1,
                    hop_index = 0
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = bogus_apply_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail("last_tx's previous_hop_tx must be the apply_transfer to cancel");
}

