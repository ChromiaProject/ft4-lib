@test module;

import lib.ft4.auth;
import lib.ft4.assets;
import xc: lib.ft4.crosschain;
import test_utils: ^^.utils.utils;
import ^^.assets.utils;
import ^^.extensions;
import admin_crosschain: ^^^.lib.ft4.admin.crosschain;
import iccf_op: ^^.operations.iccf_op;
import operations: ^^.operations;

function test_can_unapply_canceled_transfer_once_but_not_twice() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(source_blockchain_rid), asset_valid), 0L);
    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(target_blockchain_rid), asset_valid), 5L);

    val apply_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = apply_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(source_blockchain_rid), asset_valid), 0L);
    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(target_blockchain_rid), asset_valid), 0L);

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail(
            "Transaction <%s> transfer at index <%s> has already been unapplied on this chain."
            .format(init_tx.body.to_gtv().hash(), 1)
        );
}

function test_can_unapply_unapplied_transfer_once_but_not_twice() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val next_blockchain_rid = x"CCCC";
    val target_blockchain_rid = x"DDDD";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, next_blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(source_blockchain_rid), asset_valid), 0L);
    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(next_blockchain_rid), asset_valid), 5L);

    val apply_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val unapply_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = next_blockchain_rid,
            operations = [
                xc.external.unapply_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    last_tx =
                        gtx_transaction(body = gtx_transaction_body(blockchain_rid = x"", operations = [], signers = []), signatures = []),
                    last_op_index = -1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(next_blockchain_rid, unapply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, unapply_tx, 0, 0))
        .nop()
        .run();

    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(source_blockchain_rid), asset_valid), 0L);
    assert_equals(assets.get_asset_balance(xc.ensure_blockchain_account(next_blockchain_rid), asset_valid), 0L);

    rell.test.tx()
        .op(iccf_op.iccf_proof(next_blockchain_rid, unapply_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, unapply_tx, 0, 0))
        .nop()
        .run_must_fail(
            "Transaction <%s> transfer at index <%s> has already been unapplied on this chain."
            .format(init_tx.body.to_gtv().hash(), 1)
        );
}

function test_can_not_unapply_canceled_transfer_before_expiry() {
    val sender_account_id = "the sender".hash();
    val sender_auth_descriptor_id = "sender auth descriptor".hash();
    val bob = utils.register_bob();

    val source_blockchain_rid = x"AAAA";
    val target_blockchain_rid = x"CCCC";
    val asset_valid = utils.create_crosschain_asset("validAsset", "va", 1, source_blockchain_rid, "", source_blockchain_rid);

    val deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 3;

    val init_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = source_blockchain_rid,
            operations = [
                auth.external.ft_auth(sender_account_id, sender_auth_descriptor_id).to_gtx_operation(),
                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = deadline
                ).to_gtx_operation()
            ],
            signers = [rell.test.pubkeys.alice.to_gtv()]
        ),
        signatures = [x"".to_gtv()]
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(source_blockchain_rid, init_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.apply_transfer(init_tx, 1, init_tx, 1, 0))
        .nop()
        .run();

    val apply_tx = gtx_transaction.from_bytes(test_utils.get_last_transaction().tx_data);

    val cancel_tx = gtx_transaction(
        body = gtx_transaction_body(
            blockchain_rid = target_blockchain_rid,
            operations = [
                xc.external.cancel_transfer(
                    init_transfer_tx = init_tx,
                    init_tx_op_index = 1,
                    previous_hop_tx = apply_tx,
                    op_index = 1,
                    hop_index = 1
                ).to_gtx_operation()
            ],
            signers = []
        ),
        signatures = []
    );

    rell.test.tx()
        .op(iccf_op.iccf_proof(target_blockchain_rid, cancel_tx.to_gtv().hash(), x"", x"", 0, x""))
        .op(xc.external.unapply_transfer(init_tx, 1, cancel_tx, 0, 0))
        .nop()
        .run_must_fail("This transfer has not yet expired. It can not be reverted before <%s>.".format(deadline));
}

