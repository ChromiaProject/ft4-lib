                xc.external.init_transfer(
                    recipient_id = bob.account.id,
                    asset_id = asset_valid.id,
                    amount = 5L,
                    hops = [chain_context.blockchain_rid, target_blockchain_rid],
                    deadline = rell.test.DEFAULT_FIRST_BLOCK_TIME + rell.test.DEFAULT_BLOCK_INTERVAL * 2
                ).to_gtx_operation()
