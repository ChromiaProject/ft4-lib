  
<run wipe-db="true">
    <nodes>
        <test-config src="./node-config.properties"/>
        <config src="./node-config.properties"/>
    </nodes>
    <chains>
        <chain name="ft3-lib" iid="0">
            <config height="0">
                <app module="tests.core.app_module">
                    <args module="lib.ft3.core">
                        <arg key="my_blockchain_name"><string>test</string></arg>
                        <arg key="my_blockchain_website"><string>test_website</string></arg>
                        <arg key="my_blockchain_description"><string>test_description</string></arg>
                        <arg key="rate_limit_active"><int>1</int></arg>
                        <arg key="rate_limit_max_points"><int>10</int></arg> <!-- maximum amount of request credit that is possible to keep -->
                        <arg key="rate_limit_recovery_time"><int>5000</int></arg>
                        <arg key="rate_limit_points_at_account_creation"><int>1</int></arg>
                    </args>
                </app>
            </config>
        </chain>
        <test module="tests" />
    </chains>
</run>
