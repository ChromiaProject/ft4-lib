module;

import lib.ft3.ft3_basic_dev.*;

query get_all_accounts() = ft3.acc.account @* {} (.id);

@extend(ft3.auth.auth_handler)
function () = ft3.auth.auth(
  scope = "foo",
  flags = []
);

operation foo() {
  val account = ft3.acc.authenticateV2();
  print("-------------- Calling foo with account %s".format(account.id));
}

@extend(ft3.auth.auth_handler)
function () = ft3.auth.auth(
  scope = "bar",
  flags = []
);

operation bar(arg1: text, arg2: integer) {
  val account = ft3.acc.authenticateV2();
  print("-------------- Calling bar with account %s".format(account.id));
}
