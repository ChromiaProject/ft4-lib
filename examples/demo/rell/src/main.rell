module;

import lib.ft4.auth;
import lib.ft4.accounts;
import lib.ft4.admin;
import lib.ft4.assets;

query get_all_accounts() = accounts.account @* {} (.id);

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
  scope = rell.meta(foo).mount_name,
  flags = ["T"]
);

operation foo() {
  val account = auth.authenticate();
  print("-------------- Calling foo with account %s".format(account.id));
}

@extend(auth.auth_handler)
function () = auth.add_auth_handler(
  scope = rell.meta(bar).mount_name,
  flags = ["T"]
);

operation bar(arg1: text, arg2: integer) {
  val account = auth.authenticate();
  print("-------------- Calling bar with account %s".format(account.id));
}
