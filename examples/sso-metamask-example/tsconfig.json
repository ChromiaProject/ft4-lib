{
  "compilerOptions": {
    "target": "es6",
    "module": "es6",
    "outDir": "./client/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": ["es6", "dom"]
  },
  "include": ["client/src/*.ts"],
  "exclude": ["node_modules"]
}
