blockchains:
  ft4_multichain_test_{chain_number}:
    module: {module_name} #will be updated to hold the correct module name
    moduleArgs:
      lib.ft4.accounts:
        rate_limit:
          max_points: 10
          recovery_time: 5000
          points_at_account_creation: 2

      lib.ft4.admin:
        admin_pubkey: x"02C4049F9550DCFF6003347BB3944DF2AA2D6EF5202C22834284B085C56DE8C6DD"
    config:
      gtx:
        modules:
          - "net.postchain.d1.iccf.IccfGTXModule"


libs:
  iccf:
    registry: https://gitlab.com/chromaway/core/directory-chain
    path: src/iccf
    tagOrBranch: 1.32.2
    rid: x"1D567580C717B91D2F188A4D786DB1D41501086B155A68303661D25364314A4D"

compile:
  source: ./multichain
  target: ../out
  rellVersion: 0.13.5
