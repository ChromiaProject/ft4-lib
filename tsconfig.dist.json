{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "downlevelIteration": true,
    "lib": [
      "es2015",
      "es2019",
      "dom"
    ],
    "resolveJsonModule": true,
    "types": ["jest"],
    "paths": {
      "/*": [
        "./client/lib/*",
      ],
      "@authentication/*": ["./client/lib/ft3/authentication/*"]
    }
  },
  "include": ["./client/**/*"],
  "exclude": [
    "node_modules"
  ]
}